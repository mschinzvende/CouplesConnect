@page "{id:guid}"
@model CouplesConnect.Pages.Forum.EditModel

@{
    ViewData["Title"] = "Edit Discussion";
}

<div class="forum-shell forum-compose-shell">
    <div class="forum-breadcrumb">
        <a asp-page="/Forum/Topic" asp-route-id="@Model.TopicId"><i class="mdi mdi-arrow-left"></i> Back to discussion</a>
        <span>/</span>
        <span>Edit discussion</span>
    </div>
    <section class="forum-compose-card forum-edit-card">
        <span class="forum-kicker">Keep the conversation clear</span>
        <h1>Edit discussion</h1>
        <form method="post" class="forum-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-4">
                <label asp-for="Input.ForumCategoryId" class="form-label">Category</label>
                <select asp-for="Input.ForumCategoryId" class="form-select">
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.ForumCategoryId">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.ForumCategoryId" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" maxlength="160" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Body" class="form-label"></label>
                <textarea asp-for="Input.Body" class="form-control forum-textarea" rows="10" maxlength="8000"></textarea>
                <span asp-validation-for="Input.Body" class="text-danger small"></span>
            </div>
            <div class="forum-anonymous-option mb-4">
                <input asp-for="Input.IsAnonymous" class="form-check-input" />
                <label asp-for="Input.IsAnonymous" class="form-check-label"></label>
            </div>
            <div class="forum-form-actions">
                <a asp-page="/Forum/Topic" asp-route-id="@Model.TopicId" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
