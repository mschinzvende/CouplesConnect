@using Microsoft.AspNetCore.Identity
@using CouplesConnect.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@RenderSection("Styles", required: false)

@{
    var currentUser = SignInManager.IsSignedIn(User)
        ? await UserManager.GetUserAsync(User)
        : null;
    var profileImageUrl = string.IsNullOrWhiteSpace(currentUser?.ProfileImageUrl)
        ? Url.Content("~/theme/images/faces/face8.jpg")
        : currentUser.ProfileImageUrl;
    var isAdminArea = Context.Request.Path.StartsWithSegments("/Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Couples Connect</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/theme/vendors/simple-line-icons/css/simple-line-icons.css">
    <link rel="stylesheet" href="~/theme/vendors/flag-icon-css/css/flag-icons.min.css">
    <link rel="stylesheet" href="~/theme/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <link rel="stylesheet" href="~/theme/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/theme/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="~/theme/vendors/jvectormap/jquery-jvectormap.css">
    <link rel="stylesheet" href="~/theme/vendors/daterangepicker/daterangepicker.css">
    <link rel="stylesheet" href="~/theme/vendors/chartist/chartist.min.css">
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="~/theme/css/vertical-light-layout/style.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @if (isAdminArea)
    {
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
    }
    <!-- End layout styles -->
    <link rel="shortcut icon" href="~/theme/images/favicon.png" />
</head>
<body class="@(isAdminArea ? "admin-area" : "")">
    <div class="container-scroller">

        <!-- partial:partials/_navbar.html -->
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
                <a class="navbar-brand brand-logo" href="/DashboardRedirect" aria-label="Couples Connect dashboard">
                    <img class="cc-brand-logo" src="~/theme/images/logo.svg" alt="Couples Connect" />
                </a>
                <a class="navbar-brand brand-logo-mini" href="/User/Dashboard"><img src="~/theme/images/logo-mini.svg" alt="Couples Connect" /></a>
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="icon-menu"></span>
                </button>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-between">
                @if (SignInManager.IsSignedIn(User))
                {
                   

                    if (currentUser != null)
                    {
                        <h5 class="mb-0 font-weight-medium d-none d-lg-flex">
                            Welcome @currentUser.FullName
                        </h5>
                    }
                }
                <ul class="navbar-nav navbar-nav-right">
                    <form class="search-form d-none d-md-block" action="#">
                        <i class="icon-magnifier"></i>
                        <input type="search" class="form-control" placeholder="Search Here" title="Search here">
                    </form>
                    
                    
                    <li class="nav-item dropdown d-flex user-dropdown">
                        <a class="nav-link d-flex align-items-center gap-2"
                           id="UserDropdown"
                           href="#"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <img class="rounded-circle cc-nav-avatar"
                                 src="@profileImageUrl" alt="@currentUser?.FullName profile image">

                            <span class="fw-semibold small text-dark">
                               @currentUser?.FullName
                            </span>
                        </a>

                        <div class="dropdown-menu dropdown-menu-end navbar-dropdown user-menu">

                            <!-- HEADER -->
                            <div class="text-center px-3 py-3 border-bottom">
                                <img class="rounded-circle mb-2 cc-menu-avatar"
                                     src="@profileImageUrl" alt="@currentUser?.FullName profile image">

                                <div class="fw-semibold">
                                    @currentUser?.FullName
                                </div>

                                <div class="text-muted small">
                                    @currentUser?.Email
                                </div>
                            </div>

                            <!-- ITEMS -->
                            <a class="dropdown-item d-flex align-items-center gap-2" href="/account/profile">
                                <i class="icon-user text-muted"></i>
                                <span>My Profile</span>
                            </a>

                            <div class="dropdown-divider"></div>

                            <form method="post" asp-page="/Account/Logout">
                                <button class="dropdown-item d-flex align-items-center gap-2 text-danger">
                                    <i class="icon-power"></i>
                                    <span>Sign Out</span>
                                </button>
                            </form>

                        </div>
                    </li>
                   

                </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <span class="icon-menu"></span>
                </button>
            </div>
        </nav>
        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <!-- partial:partials/_sidebar.html -->
            <nav class="sidebar sidebar-offcanvas custom-sidebar mt-3" id="sidebar">
                <ul class="nav">
                    <li class="nav-item navbar-brand-mini-wrapper">
                        <a class="nav-link navbar-brand brand-logo-mini" href="/User/Dashboard"><img src="~/theme/images/logo-mini.svg" alt="CC" /></a>
                    </li>
                    

                    @if (User.IsInRole("User") || User.IsInRole("Counselor"))
                    {

                        <li class="nav-item nav-category">
                            <span class="nav-link">Dashboard</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/User/Dashboard">
                                <span class="menu-title">Dashboard</span>
                                <i class="icon-screen-desktop menu-icon"></i>
                            </a>
                        </li>
                    }


                    @if (User.IsInRole("User"))
                    {
                        <li class="nav-item nav-category">Client</li>

                        <li class="nav-item">
                            <a class="nav-link" href="/User/Bookings">
                                <span class="menu-title">My Bookings</span>
                                <i class="icon-calendar menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/User/Bookings/Create">
                                <span class="menu-title">Book Session</span>
                                <i class="icon-plus menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/User/Packages">
                                <span class="menu-title">My Package</span>
                                <i class="icon-layers menu-icon"></i>
                            </a>
                        </li>
                    }

                    <!-- COUNSELOR -->
                    @if (User.IsInRole("Counselor"))
                    {
                        <li class="nav-item nav-category">Counselor</li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Counselor/Sessions">
                                <span class="menu-title">My Sessions</span>
                                <i class="icon-camrecorder menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Counselor/Availability">
                                <span class="menu-title">Availability</span>
                                <i class="icon-clock menu-icon"></i>
                            </a>
                        </li>
                    }

                    <!-- BECOME COUNSELOR -->
                    @if (User.IsInRole("User") && !User.IsInRole("Counselor"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/RegisterCounselor">
                                <span class="menu-title">Become a Counselor</span>
                                <i class="icon-user-follow menu-icon"></i>
                            </a>
                        </li>
                    }

                    <!-- ADMIN -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item nav-category">Admin</li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Dashboard">
                                <span class="menu-title">Dashboard</span>
                                <i class="icon-speedometer menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Services">
                                <span class="menu-title">Services</span>
                                <i class="icon-settings menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Packages">
                                <span class="menu-title">Packages</span>
                                <i class="icon-layers menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Counselors">
                                <span class="menu-title">Counselors</span>
                                <i class="icon-people menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Reports">
                                <span class="menu-title">Reports</span>
                                <i class="icon-chart menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/ServiceTypes">
                                <span class="menu-title">Service Types</span>
                                <i class="icon-list menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Resources">
                                <span class="menu-title">Resources</span>
                                <i class="icon-book-open menu-icon"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Settings">
                                <span class="menu-title">System Setings</span>
                                <i class="icon-list menu-icon"></i>
                            </a>
                        </li>
                      
                    }

                    <!-- SHARED -->
                    <li class="nav-item nav-category">Growth</li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Resources/Index">
                            <i class="mdi mdi-book-open-page-variant menu-icon"></i>
                            <span class="menu-title">Resources</span>
                        </a>
                    </li>


                    
                </ul>
            </nav>
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <!-- content-wrapper ends -->
                <!-- partial:partials/_footer.html -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block"> © @DateTime.Now.Year Couples Connect <a href="#"> Terms of use</a><a href="#">Privacy Policy</a></span>
                        <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center">Hand-crafted & made with <i class="icon-heart text-danger"></i></span>
                    </div>
                </footer>
                <!-- partial -->
            </div>
            <!-- main-panel ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    <!-- plugins:js -->
    
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="~/theme/vendors/chart.js/chart.umd.js"></script>
    <script src="~/theme/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/theme/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="~/theme/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script src="~/theme/vendors/moment/moment.min.js"></script>
    <script src="~/theme/vendors/daterangepicker/daterangepicker.js"></script>
    
    
    <script src="~/theme/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="~/theme/js/jquery.cookie.js"></script>
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="~/theme/js/off-canvas.js"></script>
    <script src="~/theme/js/hoverable-collapse.js"></script>
    <script src="~/theme/js/misc.js"></script>
    <script src="~/theme/js/settings.js"></script>
    <script src="~/theme/js/todolist.js"></script>
    <!-- endinject -->
   
    
</body>
</html>
