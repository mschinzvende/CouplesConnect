@using Microsoft.AspNetCore.Identity
@using CouplesConnect.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var path = Context.Request.Path.Value?.ToLower();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Couples Connect</title>

    <!-- COREUI CSS -->
    <link href="https://cdn.jsdelivr.net/npm/@@coreui/coreui@4.3.1/dist/css/coreui.min.css" rel="stylesheet">

    <!-- ICONS -->
    <link href="https://cdn.jsdelivr.net/npm/@@coreui/icons/css/all.min.css" rel="stylesheet">

    <style>
        .sidebar {
            background: linear-gradient(180deg, #4f46e5, #7c3aed);
        }

            .sidebar .nav-link {
                color: #fff;
            }

                .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.2);
                    border-radius: 8px;
                }
    </style>
</head>

<body>

    <div class="d-flex">

        <!-- SIDEBAR -->
        <div class="sidebar p-3 vh-100">

            <h4 class="text-white mb-4">💙 Couples Connect</h4>

            <ul class="nav flex-column">

                @if (User.IsInRole("User") || User.IsInRole("Counselor"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(path.Contains("dashboard") ? "active" : "")" href="/User/Dashboard">
                            <i class="cil-speedometer me-2"></i> Dashboard
                        </a>
                    </li>
                }

                @if (User.IsInRole("User"))
                {
                    <li class="mt-3 text-white-50 small">Client</li>

                    <li><a class="nav-link" href="/User/Bookings">My Bookings</a></li>
                    <li><a class="nav-link" href="/User/Bookings/Create">Book Session</a></li>
                    <li><a class="nav-link" href="/User/Packages">My Package</a></li>
                }

                @if (User.IsInRole("Counselor"))
                {
                    <li class="mt-3 text-white-50 small">Counselor</li>

                    <li><a class="nav-link" href="/Counselor/Sessions">My Sessions</a></li>
                    <li><a class="nav-link" href="/Counselor/Availability">Availability</a></li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="mt-3 text-white-50 small">Admin</li>

                    <li><a class="nav-link" href="/Admin/Dashboard">Dashboard</a></li>
                    <li><a class="nav-link" href="/Admin/Services">Services</a></li>
                    <li><a class="nav-link" href="/Admin/Reports">Reports</a></li>
                }

            </ul>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="mt-auto pt-4">

                    <div class="text-white small mb-2">
                        @UserManager.GetUserAsync(User).Result.FullName
                    </div>

                    <form method="post" asp-page="/Account/Logout">
                        <button class="btn btn-light w-100">
                            Logout
                        </button>
                    </form>

                </div>
            }

        </div>

        <!-- MAIN -->
        <div class="flex-grow-1">

            <!-- TOPBAR -->
            <div class="bg-white shadow-sm p-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>

            <!-- CONTENT -->
            <div class="p-4">
                @RenderBody()
            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@coreui/coreui@4.3.1/dist/js/coreui.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>