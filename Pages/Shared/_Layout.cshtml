@using Microsoft.AspNetCore.Identity
@using CouplesConnect.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Couples Connect</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    

</head>

<body>

    <div class="layout">

        <!-- SIDEBAR -->

        <div class="sidebar">

            <div class="brand">

                Couples Connect

            </div>

            <nav class="menu">

                @if (User.IsInRole("User") || User.IsInRole("Counselor"))
                {
                    <!-- DASHBOARD (ONE ONLY) -->
                    <a href="/User/Dashboard" class="menu-item">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                }


                <!-- CLIENT FEATURES -->
                @if (User.IsInRole("User"))
                {
                    

                    <div class="menu-section">Client</div>

                    <a href="/User/Bookings" class="menu-item">
                        <i class="bi bi-calendar-check"></i> My Bookings
                    </a>

                    <a href="/User/Bookings/Create" class="menu-item">
                        <i class="bi bi-plus-circle"></i> Book Session
                    </a>

                    <a href="/User/Packages" class="menu-item">
                        <i class="bi bi-box"></i> My Package
                    </a>

                    
                }

                <!-- COUNSELOR FEATURES -->
                @if (User.IsInRole("Counselor"))
                {

                    <div class="menu-section">Counselor</div>

                    <a href="/Counselor/Sessions" class="menu-item">
                        <i class="bi bi-camera-video"></i> My Sessions
                    </a>

                    <a href="/Counselor/Availability" class="menu-item">
                        <i class="bi bi-clock"></i> Availability
                    </a>
                }

                

                <!-- BECOME COUNSELOR -->
                @if (User.IsInRole("User") && !User.IsInRole("Counselor"))
                {
                    <a href="/Account/RegisterCounselor" class="menu-item">
                        <i class="bi bi-person-plus"></i> Become a Counselor
                    </a>
                }

                <!-- ADMIN -->
                @if (User.IsInRole("Admin"))
                {
                    <div class="menu-section">Admin</div>

                    <a href="/Admin/Dashboard" class="menu-item">
                        <i class="bi bi-speedometer2"></i> Admin Dashboard
                    </a>

                    <a href="/Admin/Services" class="menu-item">
                        <i class="bi bi-gear"></i> Services
                    </a>

                    <a href="/Admin/Packages" class="menu-item">
                        <i class="bi bi-box"></i> Packages
                    </a>

                    <a href="/Admin/Counselors" class="menu-item">
                        <i class="bi bi-people"></i> Counselors
                    </a>

                    <a href="/Admin/Reports" class="menu-item">
                        <i class="bi bi-bar-chart"></i> Reports
                    </a>

                    <div class="menu-section mt-3">Configuration</div>

                    <a href="/Admin/ServiceTypes" class="menu-item">
                        <i class="bi bi-list"></i> Service Types
                    </a>
                }

                <!-- SHARED -->
                <div class="menu-section">Growth</div>

                <a href="/User/Resources" class="menu-item">
                    <i class="bi bi-journal-text"></i> Resources
                </a>

            </nav>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="sidebar-footer">

                    <div class="small text-muted mb-2">
                        @UserManager.GetUserAsync(User).Result.FullName
                    </div>

                    <form method="post" asp-page="/Account/Logout">
                        <button class="btn btn-outline-danger btn-sm w-100">
                            Logout
                        </button>
                    </form>

                </div>
            }

        </div>



        <!-- MAIN CONTENT -->

        <div class="main">

            <header class="topbar">

                <button id="toggleMenu" class="btn btn-light">

                    <i class="bi bi-list"></i>

                </button>

            </header>

            <div class="page">

                @RenderBody()

            </div>

            <footer class="footer">

                © @DateTime.Now.Year Couples Connect

            </footer>

        </div>

    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const toggleButton = document.getElementById("toggleMenu");
            const sidebar = document.querySelector(".sidebar");

            if (toggleButton && sidebar) {

                toggleButton.addEventListener("click", function () {

                    sidebar.classList.toggle("show");

                });

            }

        });

    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
