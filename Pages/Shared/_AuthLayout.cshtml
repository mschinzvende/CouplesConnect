<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Couples Connect provides thoughtful relationship support, guided conversations, and counselling." />
    <title>@ViewData["Title"] | Couples Connect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@mdi/font/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-auth.css" asp-append-version="true" />
</head>
<body class="public-auth-body">
    <header class="landing-nav">
        <div class="landing-container landing-nav-inner">
            <a class="landing-brand-logo" href="/" aria-label="Couples Connect home">
                <img src="~/theme/images/logo.svg" alt="Couples Connect" />
            </a>

            <nav class="landing-nav-links" aria-label="Main navigation">
                <a href="/#support">How we help</a>
                <a href="/#faqs">FAQs</a>
                <a href="/#contact">Contact</a>
            </nav>

            <div class="landing-nav-actions">
                <a href="/signin" class="landing-sign-in">Sign in</a>
                <a href="/signup" class="btn landing-button landing-button-primary">Get started <i class="mdi mdi-arrow-right"></i></a>
            </div>
        </div>
    </header>

    <main class="public-auth-main">
        <div class="landing-container public-auth-shell">
            <aside class="public-auth-introduction">
                <div class="public-auth-introduction-image"></div>
                <div class="public-auth-introduction-content">
                    <span class="public-auth-kicker"><i class="mdi mdi-heart-pulse"></i> A safe place to begin</span>
                    <h1>Make room for the conversations that matter.</h1>
                    <p>Find caring support, practical guidance, and private tools to help you grow together—one step at a time.</p>
                    <div class="public-auth-benefits">
                        <span><i class="mdi mdi-lock-check-outline"></i> Private by design</span>
                        <span><i class="mdi mdi-message-heart-outline"></i> Built for both of you</span>
                    </div>
                </div>
            </aside>

            <section class="public-auth-panel" aria-label="Account access">
                @RenderBody()
            </section>
        </div>
    </main>

    <footer class="landing-footer public-auth-footer">
        <div class="landing-container landing-footer-inner">
            <div>
                <a class="landing-brand-logo" href="/"><img src="~/theme/images/logo.svg" alt="Couples Connect" /></a>
                <p>Relationship support with care, clarity, and room to grow.</p>
            </div>
            <div class="landing-footer-links"><a href="/#support">How we help</a><a href="/#faqs">FAQs</a><a href="/#contact">Contact us</a><a href="/Privacy">Privacy Policy</a></div>
            <p class="landing-copyright">© @DateTime.UtcNow.Year Couples Connect</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
