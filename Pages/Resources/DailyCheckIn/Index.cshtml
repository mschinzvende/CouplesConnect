@page
@model CouplesConnect.Pages.Resources.DailyCheckIn.IndexModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Daily Check-In";
}

<link rel="stylesheet" href="~/css/daily-check-in.css" />

<div class="container-fluid py-4">

    <!-- HERO -->

    <section class="dc-hero">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="dc-tag">

                    Couples Connect Resource

                </span>

                <h1>

                    Daily Check-In

                </h1>

                <p>

                    A simple daily conversation designed to strengthen communication, deepen emotional connection and help you intentionally care for one another every day.

                </p>

                <div class="dc-badges">

                    <span>

                        <i class="mdi mdi-clock-outline"></i>

                        5 Minutes

                    </span>

                    <span>

                        <i class="mdi mdi-calendar-heart"></i>

                        Daily Habit

                    </span>

                    <span>

                        <i class="mdi mdi-lock"></i>

                        Private

                    </span>

                </div>

            </div>

            <div class="col-lg-4 text-center">

                <img src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=900&q=80"
                     class="img-fluid rounded-4 shadow-lg" />

            </div>

        </div>

    </section>

    <div class="dc-layout mt-4">

        <!-- SIDEBAR -->

        <aside class="dc-sidebar">

            <h5>

                Today's Progress

            </h5>

            <div class="dc-progress">

                <div id="progressBar"></div>

            </div>

            <div class="dc-step active">

                <span>1</span>

                Mood

            </div>

            <div class="dc-step">

                <span>2</span>

                Needs

            </div>

            <div class="dc-step">

                <span>3</span>

                Appreciation

            </div>

            <div class="dc-step">

                <span>4</span>

                Shared Focus

            </div>

            <div class="dc-step">

                <span>5</span>

                Ritual

            </div>

            <div class="dc-tip">

                <h6>

                    Daily Reminder

                </h6>

                <p id="dailyTip">

                    Start with curiosity instead of assumptions.

                </p>

            </div>

            <div class="dc-streak">

                <i class="mdi mdi-fire"></i>

                <div>

                    <strong id="streakDays">

                        0 Days

                    </strong>

                    <small>

                        Current Streak

                    </small>

                </div>

            </div>

        </aside>

        <!-- CONTENT -->

        <main>

            <!-- STEP 1 -->

            <div class="dc-card active-step">

                <div class="dc-header">

                    <div class="dc-number">

                        1

                    </div>

                    <div>

                        <h2>

                            How are you feeling today?

                        </h2>

                        <p>

                            Choose the mood that best reflects how you're feeling.

                        </p>

                    </div>

                </div>

                <div class="mood-grid">

                    <div class="mood-card" data-value="Happy">

                        😊

                        <span>Happy</span>

                    </div>

                    <div class="mood-card" data-value="Peaceful">

                        😌

                        <span>Peaceful</span>

                    </div>

                    <div class="mood-card" data-value="Hopeful">

                        🌞

                        <span>Hopeful</span>

                    </div>

                    <div class="mood-card" data-value="Grateful">

                        ❤️

                        <span>Grateful</span>

                    </div>

                    <div class="mood-card" data-value="Stressed">

                        😔

                        <span>Stressed</span>

                    </div>

                    <div class="mood-card" data-value="Overwhelmed">

                        😥

                        <span>Overwhelmed</span>

                    </div>

                </div>

                <div class="energy-section">

                    <label>

                        Energy Level

                    </label>

                    <div class="energy-buttons">

                        <button type="button"
                                class="energy-btn"
                                data-energy="High">

                            High

                        </button>

                        <button type="button"
                                class="energy-btn"
                                data-energy="Medium">

                            Medium

                        </button>

                        <button type="button"
                                class="energy-btn"
                                data-energy="Low">

                            Low

                        </button>

                    </div>

                </div>

            </div>
            <!-- STEP 2 -->

            <div class="dc-card">

                <div class="dc-header">

                    <div class="dc-number">

                        2

                    </div>

                    <div>

                        <h2>

                            What do you need today?

                        </h2>

                        <p>

                            Tell your partner what would help you feel loved and supported today.

                        </p>

                    </div>

                </div>

                <div class="dc-reflection">

                    <i class="mdi mdi-lightbulb-on-outline"></i>

                    <div>

                        <strong>

                            Reflection

                        </strong>

                        <p>

                            Ask for what you need instead of expecting your partner to guess.

                        </p>

                    </div>

                </div>

                <textarea id="need"
                          class="dc-textarea"
                          placeholder="Support, patience, encouragement, quality time, prayer, help with chores..."></textarea>

            </div>

            <!-- STEP 3 -->

            <div class="dc-card">

                <div class="dc-header">

                    <div class="dc-number">

                        3

                    </div>

                    <div>

                        <h2>

                            Appreciation

                        </h2>

                        <p>

                            What's one thing you're grateful for about your partner today?

                        </p>

                    </div>

                </div>

                <div class="dc-reflection">

                    <i class="mdi mdi-heart-outline"></i>

                    <div>

                        <strong>

                            Appreciation grows connection.

                        </strong>

                        <p>

                            Be specific rather than general.

                        </p>

                    </div>

                </div>

                <textarea id="appreciation"
                          class="dc-textarea"
                          placeholder="I really appreciated that you..."></textarea>

            </div>

            <!-- STEP 4 -->

            <div class="dc-card">

                <div class="dc-header">

                    <div class="dc-number">

                        4

                    </div>

                    <div>

                        <h2>

                            Shared Focus

                        </h2>

                        <p>

                            Choose one thing you'll intentionally focus on together today.

                        </p>

                    </div>

                </div>

                <div class="focus-grid">

                    <div class="focus-card">

                        Calm Communication

                    </div>

                    <div class="focus-card">

                        Teamwork

                    </div>

                    <div class="focus-card">

                        Patience

                    </div>

                    <div class="focus-card">

                        Rest

                    </div>

                    <div class="focus-card">

                        Family Time

                    </div>

                    <div class="focus-card">

                        Prayer

                    </div>

                </div>

                <input id="focus"
                       class="form-control mt-4"
                       placeholder="Or write your own shared focus..." />

            </div>

            <!-- STEP 5 -->

            <div class="dc-card">

                <div class="dc-header">

                    <div class="dc-number">

                        5

                    </div>

                    <div>

                        <h2>

                            Connection Ritual

                        </h2>

                        <p>

                            Finish today's check-in with a small act of connection.

                        </p>

                    </div>

                </div>

                <div class="ritual-card">

                    <div class="ritual-icon">

                        <i class="mdi mdi-hand-heart"></i>

                    </div>

                    <div class="flex-grow-1">

                        <h5>

                            Today's Ritual

                        </h5>

                        <p id="ritualText">

                            Sit together for five minutes without phones and ask:

                            "What would make today lighter for you?"

                        </p>

                    </div>

                </div>

                <button type="button"
                        class="btn btn-outline-primary mt-3"
                        onclick="newRitual()">

                    <i class="mdi mdi-refresh"></i>

                    New Ritual

                </button>

            </div>

            <!-- ACTION BAR -->

            <div class="dc-actionbar">

                <div class="dc-action-left">

                    <button type="button"
                            id="btnPrevious"
                            class="btn btn-outline-secondary">

                        <i class="mdi mdi-arrow-left"></i>

                        Previous

                    </button>

                </div>

                <div class="dc-action-center">

                    <div class="dc-status">

                        <div class="dc-status-dot"></div>

                        <div>

                            <strong id="saveStatus">

                                Autosaved

                            </strong>

                            <small>

                                Progress is automatically saved

                            </small>

                        </div>

                    </div>

                </div>

                <div class="dc-action-right">

                    <button type="button"
                            class="btn btn-outline-primary"
                            onclick="downloadCheckIn()">

                        <i class="mdi mdi-download"></i>

                        Download

                    </button>

                    <button type="button"
                            class="btn btn-outline-danger"
                            onclick="resetCheckIn()">

                        <i class="mdi mdi-refresh"></i>

                        Reset

                    </button>

                    <button type="button"
                            id="btnNext"
                            class="btn btn-gradient">

                        Next

                        <i class="mdi mdi-arrow-right"></i>

                    </button>

                </div>

            </div>

        </main>

    </div>

    <!-- COMPLETION -->

    <div id="completionScreen"
         class="dc-complete"
         style="display:none;">

        <i class="mdi mdi-check-circle"></i>

        <h2>

            Daily Check-In Complete

        </h2>

        <p>

            Great job showing up for each other today.

            Small daily conversations create strong relationships over time.

        </p>

        <button class="btn btn-gradient btn-lg"
                onclick="downloadCheckIn()">

            Download Today's Check-In

        </button>

    </div>

</div>

<style>
    /*==================================================
    Couples Connect - Daily Check In
==================================================*/

:root{

    --primary:#5B5CEB;
    --primary-dark:#4338CA;
    --secondary:#8B5CF6;

    --success:#22C55E;
    --danger:#EF4444;
    --warning:#F59E0B;

    --text:#111827;
    --muted:#6B7280;

    --border:#E5E7EB;

    --bg:#F5F7FB;

    --card:#FFFFFF;

}

body{

    background:var(--bg);

}

/*==================================================
HERO
==================================================*/

.dc-hero{

    position:relative;

    overflow:hidden;

    padding:30px 40px;

    border-radius:24px;

    background:linear-gradient(135deg,#5B5CEB,#7C3AED);

    color:#fff;

    box-shadow:0 20px 45px rgba(91,92,235,.20);

}

.dc-hero::before{

    content:"";

    position:absolute;

    width:350px;

    height:350px;

    border-radius:50%;

    background:rgba(255,255,255,.08);

    right:-120px;

    top:-120px;

}

.dc-hero::after{

    content:"";

    position:absolute;

    width:200px;

    height:200px;

    border-radius:50%;

    background:rgba(255,255,255,.06);

    left:-50px;

    bottom:-60px;

}

.dc-hero>*{

    position:relative;

    z-index:2;

}

.dc-tag{

    display:inline-flex;

    padding:8px 18px;

    border-radius:999px;

    background:rgba(255,255,255,.15);

    backdrop-filter:blur(12px);

    font-weight:600;

    margin-bottom:15px;

}

.dc-hero h1{

    font-size:42px;

    font-weight:800;

    margin-bottom:12px;

}

.dc-hero p{

    font-size:16px;

    line-height:1.7;

    max-width:620px;

    opacity:.95;

}

.dc-hero img{

    width:100%;

    max-height:220px;

    object-fit:cover;

    border-radius:18px;

    box-shadow:0 15px 35px rgba(0,0,0,.25);

}

.dc-badges{

    display:flex;

    gap:10px;

    flex-wrap:wrap;

    margin-top:18px;

}

.dc-badges span{

    background:rgba(255,255,255,.15);

    padding:8px 16px;

    border-radius:999px;

    backdrop-filter:blur(10px);

    font-size:13px;

    font-weight:600;

}

/*==================================================
LAYOUT
==================================================*/

.dc-layout{

    display:grid;

    grid-template-columns:280px 1fr;

    gap:25px;

}

@@media(max-width:992px){

.dc-layout{

grid-template-columns:1fr;

}

}

/*==================================================
SIDEBAR
==================================================*/

.dc-sidebar{

    position:sticky;

    top:90px;

    background:#fff;

    border-radius:20px;

    padding:20px;

    box-shadow:0 12px 30px rgba(15,23,42,.08);

}

.dc-sidebar h5{

    font-weight:700;

    margin-bottom:20px;

}

.dc-progress{

    width:100%;

    height:8px;

    border-radius:999px;

    background:#E5E7EB;

    overflow:hidden;

    margin-bottom:22px;

}

#progressBar{

    width:20%;

    height:100%;

    background:linear-gradient(135deg,#5B5CEB,#7C3AED);

    transition:.35s;

}

.dc-step{

    display:flex;

    align-items:center;

    padding:10px 12px;

    margin-bottom:8px;

    border-radius:14px;

    color:#6B7280;

    font-weight:600;

    transition:.3s;

}

.dc-step span{

    width:30px;

    height:30px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

    background:#E5E7EB;

    margin-right:12px;

    font-size:13px;

    font-weight:700;

}

.dc-step.active{

    background:#EEF2FF;

    color:#5B5CEB;

}

.dc-step.active span{

    background:#5B5CEB;

    color:#fff;

}

.dc-tip{

    margin-top:25px;

    background:#EEF4FF;

    border-left:4px solid #5B5CEB;

    border-radius:16px;

    padding:15px;

}

.dc-tip h6{

    font-weight:700;

    margin-bottom:8px;

}

.dc-tip p{

    margin:0;

    color:#6B7280;

    line-height:1.6;

    font-size:14px;

}

.dc-streak{

    display:flex;

    align-items:center;

    gap:15px;

    margin-top:25px;

    padding:18px;

    border-radius:16px;

    background:#FFF7ED;

}

.dc-streak i{

    font-size:34px;

    color:#F97316;

}

.dc-streak strong{

    display:block;

    font-size:18px;

}

.dc-streak small{

    color:#6B7280;

}
    /*==================================================
    CONTENT CARD
    ==================================================*/

    .dc-card {
        display: none;
        background: #fff;
        border-radius: 22px;
        padding: 28px;
        box-shadow: 0 15px 40px rgba(15,23,42,.06);
        animation: fadeCard .35s ease;
    }

        .dc-card.active-step {
            display: block;
        }

    @@keyframes fadeCard {
        from

    {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: none;
    }

    }

    /*==================================================
    HEADER
    ==================================================*/

    .dc-header {
        display: flex;
        align-items: center;
        margin-bottom: 22px;
    }

    .dc-number {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: linear-gradient(135deg,#5B5CEB,#7C3AED);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 700;
        margin-right: 18px;
        box-shadow: 0 10px 20px rgba(91,92,235,.25);
    }

    .dc-header h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        color: #111827;
    }

    .dc-header p {
        margin: 5px 0 0;
        color: #6B7280;
        font-size: 15px;
    }

    /*==================================================
    MOODS
    ==================================================*/

    .mood-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 18px;
    }

    .mood-card {
        background: #F8FAFC;
        border: 2px solid #E5E7EB;
        border-radius: 18px;
        padding: 22px;
        cursor: pointer;
        transition: .25s;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }

        .mood-card span {
            margin-top: 12px;
            font-size: 15px;
            font-weight: 600;
            color: #374151;
        }

        .mood-card:hover {
            transform: translateY(-5px);
            border-color: #5B5CEB;
            box-shadow: 0 15px 30px rgba(91,92,235,.15);
        }

        .mood-card.active {
            background: #EEF2FF;
            border-color: #5B5CEB;
            color: #5B5CEB;
        }

    /*==================================================
    ENERGY
    ==================================================*/

    .energy-section {
        margin-top: 35px;
    }

        .energy-section label {
            display: block;
            margin-bottom: 15px;
            font-weight: 700;
            color: #111827;
        }

    .energy-buttons {
        display: flex;
        gap: 15px;
    }

    .energy-btn {
        flex: 1;
        height: 50px;
        border-radius: 14px;
        border: 2px solid #E5E7EB;
        background: #fff;
        transition: .25s;
        font-weight: 600;
    }

        .energy-btn:hover {
            border-color: #5B5CEB;
        }

        .energy-btn.active {
            background: #5B5CEB;
            border-color: #5B5CEB;
            color: #fff;
        }

    /*==================================================
    REFLECTION
    ==================================================*/

    .dc-reflection {
        display: flex;
        gap: 16px;
        padding: 16px;
        margin-bottom: 20px;
        background: #EEF4FF;
        border-left: 5px solid #5B5CEB;
        border-radius: 16px;
    }

        .dc-reflection i {
            font-size: 28px;
            color: #5B5CEB;
        }

        .dc-reflection strong {
            display: block;
            margin-bottom: 5px;
            color: #111827;
        }

        .dc-reflection p {
            margin: 0;
            color: #6B7280;
            line-height: 1.6;
        }

    /*==================================================
    TEXTAREA
    ==================================================*/

    .dc-textarea {
        width: 100%;
        height: 180px;
        resize: none;
        border-radius: 18px;
        border: 2px solid #E5E7EB;
        padding: 18px;
        font-size: 15px;
        line-height: 1.8;
        transition: .25s;
    }

        .dc-textarea:focus {
            outline: none;
            border-color: #5B5CEB;
            box-shadow: 0 0 0 5px rgba(91,92,235,.10);
        }

    /*==================================================
    FOCUS CARDS
    ==================================================*/

    .focus-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 16px;
    }

    .focus-card {
        padding: 20px;
        border-radius: 16px;
        background: #F8FAFC;
        border: 2px solid #E5E7EB;
        text-align: center;
        cursor: pointer;
        transition: .25s;
        font-weight: 600;
    }

        .focus-card:hover {
            transform: translateY(-4px);
            border-color: #5B5CEB;
        }

        .focus-card.active {
            background: #EEF2FF;
            border-color: #5B5CEB;
            color: #5B5CEB;
        }

    /*==================================================
    RITUAL
    ==================================================*/

    .ritual-card {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        padding: 24px;
        border-radius: 18px;
        background: linear-gradient(135deg,#EEF2FF,#F5F3FF);
    }

    .ritual-icon {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #5B5CEB;
        color: #fff;
        font-size: 30px;
        flex-shrink: 0;
    }

    .ritual-card h5 {
        margin: 0 0 8px;
        font-weight: 700;
    }

    .ritual-card p {
        margin: 0;
        color: #4B5563;
        line-height: 1.8;
        font-size: 15px;
    }

    /*==================================================
    ACTION BAR
    ==================================================*/

    .dc-actionbar {
        position: sticky;
        bottom: 15px;
        z-index: 999;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-top: 25px;
        padding: 14px 18px;
        background: #fff;
        border-radius: 20px;
        border: 1px solid #EEF2F7;
        box-shadow: 0 18px 45px rgba(15,23,42,.12);
    }

    .dc-action-left,
    .dc-action-center,
    .dc-action-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dc-action-center {
        flex: 1;
        justify-content: center;
    }

    .dc-actionbar .btn {
        height: 46px;
        min-width: 120px;
        border-radius: 12px;
        font-weight: 600;
        transition: .25s;
    }

        .dc-actionbar .btn:hover {
            transform: translateY(-2px);
        }

    .btn-gradient {
        background: linear-gradient(135deg,#5B5CEB,#7C3AED);
        color: #fff;
        border: none;
    }

        .btn-gradient:hover {
            color: #fff;
            box-shadow: 0 12px 25px rgba(91,92,235,.35);
        }

    .btn-outline-primary {
        border: 2px solid #5B5CEB;
    }

        .btn-outline-primary:hover {
            background: #5B5CEB;
            color: #fff;
        }

    .btn-outline-danger {
        border: 2px solid #EF4444;
    }

        .btn-outline-danger:hover {
            background: #EF4444;
            color: #fff;
        }

    /*==================================================
    SAVE STATUS
    ==================================================*/

    .dc-status {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #F8FAFC;
        border-radius: 14px;
        padding: 10px 16px;
    }

    .dc-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #22C55E;
        animation: statusPulse 2s infinite;
    }

    @@keyframes statusPulse {
        0%

    {
        box-shadow: 0 0 0 0 rgba(34,197,94,.6);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(34,197,94,0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(34,197,94,0);
    }

    }

    .dc-status strong {
        display: block;
        font-size: 14px;
    }

    .dc-status small {
        display: block;
        color: #6B7280;
        font-size: 12px;
    }

    /*==================================================
    COMPLETE SCREEN
    ==================================================*/

    .dc-complete {
        background: #fff;
        border-radius: 26px;
        padding: 70px 40px;
        text-align: center;
        box-shadow: 0 18px 45px rgba(15,23,42,.08);
        animation: fadeCard .35s ease;
    }

        .dc-complete i {
            font-size: 90px;
            color: #22C55E;
            margin-bottom: 25px;
        }

        .dc-complete h2 {
            font-size: 42px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 15px;
        }

        .dc-complete p {
            max-width: 620px;
            margin: 0 auto 35px;
            color: #6B7280;
            line-height: 1.8;
            font-size: 16px;
        }

    /*==================================================
    FORM CONTROLS
    ==================================================*/

    .form-control {
        height: 52px;
        border-radius: 14px;
        border: 2px solid #E5E7EB;
    }

        .form-control:focus {
            border-color: #5B5CEB;
