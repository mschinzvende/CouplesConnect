@page
@model CouplesConnect.Pages.Resources.GratitudeJournal.IndexModel
@{
    ViewData["Title"] = "Memory & Gratitude Journal";
}



<div class="page-header d-print-none mb-4">
    <div class="container-xl">

        <div class="row g-3 align-items-center">

            <div class="col">

                <div class="page-pretitle">
                    Couples Connect
                </div>

                <h2 class="page-title">
                    ❤️ Memory & Gratitude Journal
                </h2>

            </div>

            <div class="col-auto ms-auto">

                <button class="btn btn-primary"
                        id="btnAddMemory">

                    <i class="ti ti-plus"></i>

                    New Memory

                </button>

            </div>

        </div>

    </div>
</div>

<div class="page-body">

    <div class="container-xl">

        <!-- ======================================================= -->
        <!-- HERO -->
        <!-- ======================================================= -->

        <div class="card hero-card mb-4">

            <div class="card-body p-0">

                <div class="row g-0 align-items-center">

                    <div class="col-lg-7">

                        <div class="hero-content">

                            <span class="hero-pill">

                                <i class="ti ti-heart-filled"></i>

                                Couples Connect Journal

                            </span>

                            <h1>

                                Every Love Story
                                Deserves To Be Remembered

                            </h1>

                            <p>

                                Capture beautiful memories, celebrate milestones,
                                express gratitude, and build your relationship
                                timeline together.

                            </p>

                            <div class="hero-buttons">

                                <button class="btn btn-primary btn-lg"
                                        id="btnHeroMemory">

                                    <i class="ti ti-plus"></i>

                                    Add Memory

                                </button>

                                <button class="btn btn-outline-light btn-lg">

                                    <i class="ti ti-download"></i>

                                    Export Journal

                                </button>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-5">

                        <img src="https://images.unsplash.com/photo-1516589091380-5d8e87df6999?auto=format&fit=crop&w=1200&q=80"
                             class="hero-image"
                             alt="Couple">

                    </div>

                </div>

            </div>

        </div>

        <!-- ======================================================= -->
        <!-- DASHBOARD -->
        <!-- ======================================================= -->

        <div class="row g-4 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="dashboard-icon pink">

                        <i class="ti ti-heart-filled"></i>

                    </div>

                    <div>

                        <h2 id="lblMemories">
                            0
                        </h2>

                        <span>Total Memories</span>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="dashboard-icon purple">

                        <i class="ti ti-flame"></i>

                    </div>

                    <div>

                        <h2 id="lblStreak">
                            0
                        </h2>

                        <span>Day Streak</span>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="dashboard-icon orange">

                        <i class="ti ti-heart-handshake"></i>

                    </div>

                    <div>

                        <h2 id="lblGratitude">
                            0
                        </h2>

                        <span>Gratitude Entries</span>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="dashboard-card">

                    <div class="dashboard-icon yellow">

                        <i class="ti ti-star-filled"></i>

                    </div>

                    <div>

                        <h2 id="lblFavourite">
                            0
                        </h2>

                        <span>Favourite Memories</span>

                    </div>

                </div>

            </div>

        </div>

        <!-- ======================================================= -->
        <!-- HIGHLIGHTS -->
        <!-- ======================================================= -->

        <div class="row g-4 mb-4">

            <div class="col-lg-8">

                <div class="card cc-card h-100">

                    <div class="card-header">

                        <h3>

                            <i class="ti ti-calendar-heart"></i>

                            Relationship Highlights

                        </h3>

                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <div class="col-md-4">

                                <div class="highlight-card">

                                    <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=800&q=80">

                                    <div class="highlight-content">

                                        <span class="badge bg-pink">
                                            Anniversary
                                        </span>

                                        <h5>First Anniversary</h5>

                                        <small>14 February 2026</small>

                                    </div>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <div class="highlight-card">

                                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&q=80">

                                    <div class="highlight-content">

                                        <span class="badge bg-success">

                                            Vacation

                                        </span>

                                        <h5>Nyanga Weekend</h5>

                                        <small>July 2026</small>

                                    </div>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <div class="highlight-card">

                                    <img src="https://images.unsplash.com/photo-1529636798458-92182e662485?auto=format&fit=crop&w=800&q=80">

                                    <div class="highlight-content">

                                        <span class="badge bg-primary">

                                            Date Night

                                        </span>

                                        <h5>Rooftop Dinner</h5>

                                        <small>March 2026</small>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card cc-card h-100">

                    <div class="card-header">

                        <h3>

                            <i class="ti ti-trophy"></i>

                            Milestones

                        </h3>

                    </div>

                    <div class="card-body">

                        <ul class="timeline-simple">

                            <li>

                                ❤️ First Date

                            </li>

                            <li>

                                💍 Engagement

                            </li>

                            <li>

                                🏡 First Home

                            </li>

                            <li>

                                👶 First Child

                            </li>

                            <li>

                                🌍 First Vacation

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>
        <!-- ======================================================= -->
        <!-- SEARCH / FILTER -->
        <!-- ======================================================= -->

        <div class="card cc-card mb-4">

            <div class="card-body">

                <div class="row g-3 align-items-center">

                    <div class="col-lg-5">

                        <div class="input-icon">

                            <span class="input-icon-addon">

                                <i class="ti ti-search"></i>

                            </span>

                            <input class="form-control"
                                   id="txtSearch"
                                   placeholder="Search memories..." />

                        </div>

                    </div>

                    <div class="col-lg-2">

                        <select class="form-select"
                                id="ddlCategory">

                            <option value="">All Categories</option>
                            <option>Date Night</option>
                            <option>Anniversary</option>
                            <option>Vacation</option>
                            <option>Achievement</option>
                            <option>Family</option>
                            <option>Adventure</option>

                        </select>

                    </div>

                    <div class="col-lg-2">

                        <select class="form-select"
                                id="ddlMood">

                            <option value="">All Moods</option>

                            <option>😍</option>
                            <option>🥰</option>
                            <option>😊</option>
                            <option>❤️</option>
                            <option>🤗</option>

                        </select>

                    </div>

                    <div class="col-lg-2">

                        <select class="form-select"
                                id="ddlSort">

                            <option value="new">Newest</option>
                            <option value="old">Oldest</option>
                            <option value="fav">Favourites</option>

                        </select>

                    </div>

                    <div class="col-lg-1">

                        <button class="btn btn-outline-primary w-100">

                            <i class="ti ti-filter"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>



        <!-- ======================================================= -->
        <!-- TIMELINE -->
        <!-- ======================================================= -->

        <div class="card cc-card">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h3 class="mb-1">

                            <i class="ti ti-history"></i>

                            Your Relationship Timeline

                        </h3>

                        <small class="text-muted">

                            Every memory tells part of your story together.

                        </small>

                    </div>

                    <button class="btn btn-primary"
                            id="btnTimelineMemory">

                        <i class="ti ti-plus"></i>

                        Add Memory

                    </button>

                </div>

            </div>

            <div class="card-body">

                <!-- Empty -->

                <div id="emptyState"
                     class="timeline-empty d-none">

                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=900&q=80"
                         class="empty-image" />

                    <h2>

                        Start Your Story

                    </h2>

                    <p>

                        Create your first beautiful memory together.

                    </p>

                    <button class="btn btn-primary btn-lg"
                            id="btnEmptyMemory">

                        <i class="ti ti-plus"></i>

                        Create First Memory

                    </button>

                </div>

                <!-- Timeline -->

                <div id="timelineContainer"
                     class="timeline-container">
                </div>

            </div>

        </div>

    </div>

</div>

<!-- ======================================================= -->
<!-- ADD / EDIT MEMORY -->
<!-- ======================================================= -->

<div class="modal fade"
     id="memoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h3 class="modal-title">

                    ❤️ Memory Details

                </h3>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="MemoryId" />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Date

                        </label>

                        <input type="date"
                               id="EntryDate"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Category

                        </label>

                        <select id="EntryCategory"
                                class="form-select">

                            <option>Date Night</option>
                            <option>Vacation</option>
                            <option>Anniversary</option>
                            <option>Achievement</option>
                            <option>Adventure</option>
                            <option>Family</option>

                        </select>

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Title

                    </label>

                    <input id="EntryTitle"
                           class="form-control" />

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Mood

                    </label>

                    <div class="mood-selector">

                        <button type="button"
                                class="mood-btn active"
                                data-mood="😍">
                            😍
                        </button>

                        <button type="button"
                                class="mood-btn"
                                data-mood="🥰">
                            🥰
                        </button>

                        <button type="button"
                                class="mood-btn"
                                data-mood="😊">
                            😊
                        </button>

                        <button type="button"
                                class="mood-btn"
                                data-mood="❤️">
                            ❤️
                        </button>

                        <button type="button"
                                class="mood-btn"
                                data-mood="🤗">
                            🤗
                        </button>

                    </div>

                    <input type="hidden"
                           id="EntryMood"
                           value="😍" />

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Memory

                    </label>

                    <textarea class="form-control"
                              rows="5"
                              id="EntryMemory"></textarea>

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Gratitude

                    </label>

                    <textarea class="form-control"
                              rows="4"
                              id="EntryGratitude"></textarea>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Tags

                        </label>

                        <input id="EntryTags"
                               class="form-control"
                               placeholder="love, family" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Photos

                        </label>

                        <input type="file"
                               id="EntryPhotos"
                               class="form-control"
                               accept="image/*"
                               multiple />

                    </div>

                </div>

                <div class="form-check form-switch mt-4">

                    <input class="form-check-input"
                           id="EntryFavourite"
                           type="checkbox" />

                    <label class="form-check-label">

                        Favourite Memory

                    </label>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <button class="btn btn-primary"
                        id="btnSaveMemory">

                    <i class="ti ti-device-floppy"></i>

                    Save Memory

                </button>

            </div>

        </div>

    </div>

</div>

<!-- ======================================================= -->
<!-- DELETE -->
<!-- ======================================================= -->

<div class="modal fade"
     id="deleteModal">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h4>

                    Delete Memory

                </h4>

            </div>

            <div class="modal-body">

                Are you sure you want to permanently delete this memory?

            </div>

            <div class="modal-footer">

                <button class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <button class="btn btn-danger"
                        id="btnDeleteMemory">

                    Delete

                </button>

            </div>

        </div>

    </div>

</div>
<!-- ========================================================= -->
<!-- TIMELINE CARD TEMPLATE -->
<!-- ========================================================= -->

<template id="memoryCardTemplate">

    <div class="memory-card">

        <div class="memory-card-header">

            <div class="memory-date">

                <span class="day"></span>
                <span class="month"></span>

            </div>

            <div class="memory-heading">

                <div class="memory-badges">

                    <span class="badge bg-primary category"></span>

                    <span class="mood"></span>

                    <span class="badge bg-warning text-dark favourite d-none">

                        <i class="ti ti-star-filled"></i>

                        Favourite

                    </span>

                </div>

                <h3 class="title mt-2"></h3>

                <small class="text-muted full-date"></small>

            </div>

            <div class="dropdown">

                <button class="btn btn-icon"
                        data-bs-toggle="dropdown">

                    <i class="ti ti-dots-vertical"></i>

                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                    <li>

                        <a class="dropdown-item btnEdit">

                            <i class="ti ti-edit me-2"></i>

                            Edit

                        </a>

                    </li>

                    <li>

                        <a class="dropdown-item btnFavourite">

                            <i class="ti ti-star me-2"></i>

                            Toggle Favourite

                        </a>

                    </li>

                    <li>

                        <a class="dropdown-item btnDownload">

                            <i class="ti ti-download me-2"></i>

                            Export

                        </a>

                    </li>

                    <li>

                        <hr class="dropdown-divider" />

                    </li>

                    <li>

                        <a class="dropdown-item text-danger btnDelete">

                            <i class="ti ti-trash me-2"></i>

                            Delete

                        </a>

                    </li>

                </ul>

            </div>

        </div>

        <div class="memory-card-body">

            <div class="memory-section">

                <h5>

                    <i class="ti ti-book"></i>

                    Memory

                </h5>

                <p class="memoryText">

                </p>

            </div>

            <div class="memory-section">

                <h5>

                    <i class="ti ti-heart-handshake"></i>

                    Gratitude

                </h5>

                <p class="gratitudeText">

                </p>

            </div>

            <div class="gallery">
            </div>

            <div class="tags">
            </div>

        </div>

        <div class="memory-card-footer">

            <button class="btn btn-light btnLike">

                <i class="ti ti-heart"></i>

            </button>

            <button class="btn btn-light btnComment">

                <i class="ti ti-message-circle"></i>

            </button>

            <button class="btn btn-light btnShare">

                <i class="ti ti-share"></i>

            </button>

        </div>

    </div>

</template>



<!-- ========================================================= -->
<!-- PHOTO TEMPLATE -->
<!-- ========================================================= -->

<template id="photoTemplate">

    <div class="photo-item">

        <img src=""
             class="photo" />

    </div>

</template>



<!-- ========================================================= -->
<!-- TAG TEMPLATE -->
<!-- ========================================================= -->

<template id="tagTemplate">

    <span class="badge bg-indigo-lt tag">

    </span>

</template>



<!-- ========================================================= -->
<!-- TOAST CONTAINER -->
<!-- ========================================================= -->

<div class="toast-container position-fixed
            bottom-0
            end-0
            p-3">
</div>



<!-- ========================================================= -->
<!-- LOADING -->
<!-- ========================================================= -->

<div id="pageLoader"
     class="page-loader d-none">

    <div class="spinner-border text-primary">
    </div>

</div>



<!-- ========================================================= -->
<!-- ANTIFORGERY -->
<!-- ========================================================= -->
@Html.AntiForgeryToken()

<style>
    /*==========================================================
        Couples Connect
        Memory & Gratitude Journal
    ==========================================================*/

    :root {
        --journal-primary: #ec4899;
        --journal-primary-dark: #db2777;
        --journal-secondary: #8b5cf6;
        --journal-success: #10b981;
        --journal-warning: #f59e0b;
        --journal-danger: #ef4444;
        --journal-text: #24324a;
        --journal-muted: #64748b;
        --journal-border: #e9edf3;
        --journal-radius: 22px;
        --journal-shadow: 0 15px 45px rgba(0,0,0,.08);
        --journal-shadow-hover: 0 25px 55px rgba(0,0,0,.12);
    }

    /******************************************************
                        PAGE
    ******************************************************/

    .page-body {
        background: #f6f8fb;
        padding-bottom: 50px;
    }

    .cc-card {
        border: none;
        border-radius: var(--journal-radius);
        overflow: hidden;
        box-shadow: var(--journal-shadow);
    }

        .cc-card .card-header {
            background: #fff;
            border-bottom: 1px solid var(--journal-border);
            padding: 22px 28px;
        }

            .cc-card .card-header h3 {
                margin: 0;
                font-size: 1.2rem;
                font-weight: 700;
            }

        .cc-card .card-body {
            padding: 28px;
        }

    /******************************************************
                        HERO
    ******************************************************/

    .hero-card {
        border: none;
        overflow: hidden;
        border-radius: 28px;
        background: linear-gradient( 135deg, #ec4899, #8b5cf6);
        box-shadow: 0 30px 80px rgba(236,72,153,.35);
    }

    .hero-content {
        padding: 70px;
        color: #fff;
    }

    .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 40px;
        background: rgba(255,255,255,.18);
        backdrop-filter: blur(10px);
        margin-bottom: 28px;
    }

    .hero-content h1 {
        font-size: 3.2rem;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 25px;
    }

    .hero-content p {
        max-width: 620px;
        line-height: 1.9;
        font-size: 1.05rem;
        opacity: .95;
    }

    .hero-buttons {
        display: flex;
        gap: 15px;
        margin-top: 35px;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        min-height: 450px;
        object-fit: cover;
    }

    /******************************************************
                    DASHBOARD
    ******************************************************/

    .dashboard-card {
        background: #fff;
        border-radius: 22px;
        padding: 28px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: var(--journal-shadow);
        transition: .30s;
        height: 100%;
    }

        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--journal-shadow-hover);
        }

        .dashboard-card h2 {
            font-size: 2.2rem;
            font-weight: 800;
            margin: 0;
        }

        .dashboard-card span {
            color: var(--journal-muted);
        }

    .dashboard-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 30px;
    }

        .dashboard-icon.pink {
            background: linear-gradient( 135deg, #ec4899, #db2777);
        }

        .dashboard-icon.purple {
            background: linear-gradient( 135deg, #8b5cf6, #7c3aed);
        }

        .dashboard-icon.orange {
            background: linear-gradient( 135deg, #fb923c, #ea580c);
        }

        .dashboard-icon.yellow {
            background: linear-gradient( 135deg, #facc15, #eab308);
        }

    /******************************************************
                    HIGHLIGHTS
    ******************************************************/

    .highlight-card {
        overflow: hidden;
        border-radius: 18px;
        background: #fff;
        transition: .3s;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
    }

        .highlight-card:hover {
            transform: translateY(-6px);
        }

        .highlight-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

    .highlight-content {
        padding: 18px;
    }

        .highlight-content h5 {
            margin-top: 12px;
            margin-bottom: 8px;
            font-weight: 700;
        }

    .timeline-simple {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .timeline-simple li {
            padding: 14px 0;
            border-bottom: 1px solid var(--journal-border);
            font-weight: 600;
        }

            .timeline-simple li:last-child {
                border-bottom: none;
            }

    /*==========================================================
        SEARCH BAR
    ==========================================================*/

    .input-icon {
        position: relative;
    }

    .input-icon-addon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94A3B8;
        z-index: 5;
    }

    .input-icon .form-control {
        padding-left: 45px;
    }

    .form-control,
    .form-select {
        border-radius: 14px;
        min-height: 48px;
        border: 1px solid var(--journal-border);
        transition: .25s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--journal-primary);
            box-shadow: 0 0 0 .2rem rgba(236,72,153,.15);
        }

    /******************************************************
                        TIMELINE
    ******************************************************/

    .timeline-container {
        position: relative;
        padding-left: 70px;
    }

        .timeline-container::before {
            content: "";
            position: absolute;
            left: 28px;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: 20px;
            background: linear-gradient( to bottom, var(--journal-primary), var(--journal-secondary));
        }

    /******************************************************
                    MEMORY CARD
    ******************************************************/

    .memory-card {
        position: relative;
        margin-bottom: 35px;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--journal-shadow);
        transition: .30s;
    }

