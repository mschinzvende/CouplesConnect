            <div class="resource-card">

                <img src="https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=900&q=80"
                     class="resource-image" />

                <div class="resource-overlay"></div>

                <div class="resource-content">

                    <span class="resource-badge bg-secondary">

                        Assessment

                    </span>

                    <h3>

                        Relationship Health Quiz

                    </h3>

                    <p>

                        Measure your relationship strengths and identify growth areas.

                    </p>

                    <div class="resource-footer">

                        <span>

                            <i class="mdi mdi-clock-outline"></i>

                            10 mins

                        </span>

                        <button class="btn btn-light rounded-pill">

