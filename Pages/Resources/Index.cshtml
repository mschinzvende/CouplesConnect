                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    /*CSS FOR THE RESOURCES PAGE*/

    .resources-hero {
        padding: 60px;
        border-radius: 28px;
        background: linear-gradient(135deg,#5B5CEB,#7C3AED);
        margin-bottom: 50px;
    }

    .resource-card {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        height: 420px;
        box-shadow: 0 15px 40px rgba(0,0,0,.12);
        transition: .35s;
    }

        .resource-card:hover {
            transform: translateY(-10px);
        }

    .resource-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .resource-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,.8), rgba(0,0,0,.15));
    }

    .resource-content {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 30px;
        color: #fff;
    }

        .resource-content h3 {
            font-weight: 700;
            margin: 15px 0;
        }

        .resource-content p {
            opacity: .9;
            line-height: 1.7;
            margin-bottom: 25px;
        }

    .resource-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .resource-badge {
        display: inline-block;
        padding: 7px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .hero-image {
        max-height: 320px;
    }

</style>