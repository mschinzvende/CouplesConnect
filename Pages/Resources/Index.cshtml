@page
@model CouplesConnect.Pages.Resources.IndexModel

@{
    ViewData["Title"] = "Relationship Resource Library";
}

<div class="relationship-library">
    <section class="resource-library-hero">
        <div class="resource-library-hero-copy">
            <span class="resource-library-eyebrow"><i class="mdi mdi-book-open-page-variant-outline"></i> Couples Connect Library</span>
            <h1>Practical support for every part of your relationship.</h1>
            <p>Explore simple, guided tools for the conversations, decisions, and seasons that shape life together.</p>
            <a href="#resource-library-topics" class="btn btn-light resource-library-hero-action">Explore topics <i class="mdi mdi-arrow-down"></i></a>
        </div>
        <div class="resource-library-hero-stat" aria-label="@Model.AvailableActivityCount available guided activities">
            <strong>@Model.AvailableActivityCount</strong>
            <span>guided activities<br />available today</span>
        </div>
    </section>

    <section id="resource-library-topics" class="resource-library-directory" aria-labelledby="resource-topics-heading">
        <div class="resource-library-heading">
            <div>
                <span class="resource-library-kicker">Find the right support</span>
                <h2 id="resource-topics-heading">Explore by relationship topic</h2>
            </div>
            <p>Choose a focus area to find tools and guided conversations designed for that part of your shared life.</p>
        </div>

        <div class="resource-topic-grid">
            @foreach (var collection in Model.Collections)
            {
                <a href="#@collection.Slug" class="resource-topic-card" style="--resource-topic: @collection.Color">
                    <span class="resource-topic-icon"><i class="@collection.Icon"></i></span>
                    <span class="resource-topic-copy">
                        <strong>@collection.Name</strong>
                        <span>@collection.Activities.Count @(collection.Activities.Count == 1 ? "activity" : "activities")</span>
                    </span>
                    <i class="mdi mdi-arrow-down-right resource-topic-arrow" aria-hidden="true"></i>
                </a>
            }
        </div>
    </section>

    <nav class="resource-topic-nav" aria-label="Relationship resource topics">
        @foreach (var collection in Model.Collections)
        {
            <a href="#@collection.Slug" style="--resource-topic: @collection.Color">@collection.Name</a>
        }
    </nav>

    <section class="resource-collections" aria-label="Relationship resources by topic">
        @foreach (var collection in Model.Collections)
        {
            <article id="@collection.Slug" class="resource-collection" style="--resource-topic: @collection.Color">
                <header class="resource-collection-header">
                    <div class="resource-collection-icon"><i class="@collection.Icon"></i></div>
                    <div>
                        <span class="resource-library-kicker">Guided collection</span>
                        <h2>@collection.Name</h2>
                        <p>@collection.Description</p>
                    </div>
                </header>

                @if (collection.Activities.Count == 0)
                {
                    <div class="resource-coming-soon">
                        <span><i class="mdi mdi-progress-clock"></i></span>
                        <div>
                            <strong>Resources in development</strong>
                            <p>We are expanding this collection with practical guides and shared exercises. Check back soon.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="resource-activity-grid">
                        @foreach (var activity in collection.Activities)
                        {
                            <div class="resource-activity-card @(activity.IsAvailable ? "is-available" : "is-coming-soon")">
                                <div class="resource-activity-card-top">
                                    <span class="resource-activity-icon"><i class="@activity.Icon"></i></span>
                                    <span class="resource-activity-status">@activity.Type</span>
                                </div>
                                <h3>@activity.Name</h3>
                                <p>@activity.Description</p>
                                <div class="resource-activity-footer">
                                    <span><i class="mdi mdi-clock-outline"></i> @activity.Duration</span>
                                    @if (activity.IsAvailable)
                                    {
                                        <button type="button" class="btn btn-primary resource-activity-button" onclick="window.location.href='@activity.Href'">Open activity <i class="mdi mdi-arrow-right"></i></button>
                                    }
                                    else
                                    {
                                        <span class="resource-coming-badge">Coming soon</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </article>
        }
    </section>

    <aside class="resource-library-support-note">
        <span><i class="mdi mdi-account-heart-outline"></i></span>
        <div>
            <h2>Need more personal support?</h2>
            <p>These tools are a starting point. For support tailored to your situation, book a session with a Couples Connect counselor.</p>
        </div>
        <a href="/User/Bookings/Create" class="btn btn-primary">Book a session</a>
    </aside>
</div>
