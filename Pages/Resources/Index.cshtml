@page
@model CouplesConnect.Pages.Resources.IndexModel

@{
    ViewData["Title"] = "Relationship Resources";
}

<div class="container-fluid py-4">

    <!-- HERO -->

    <div class="resources-hero mb-5">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="badge bg-white text-primary px-3 py-2 rounded-pill mb-3">

                    Couples Connect Library

                </span>

                <h1 class="display-4 fw-bold text-white">

                    Relationship Resources

                </h1>

                <p class="lead text-white opacity-75 mt-3">

                    Explore practical activities, guided reflections and relationship tools designed by professionals to strengthen communication, trust and emotional connection.

                </p>

            </div>

            <div class="col-lg-5 text-center">

                <img src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=900&q=80"
                     class="img-fluid rounded-4 shadow-lg hero-image" />

            </div>

        </div>

    </div>

    <div class="row g-4">

        <!-- Conflict Repair -->

        <div class="col-lg-4 col-md-6">

            <div class="resource-card">

                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=900&q=80"
                     class="resource-image" />

                <div class="resource-overlay"></div>

                <div class="resource-content">

                    <span class="resource-badge bg-danger">

                        Communication

                    </span>

                    <h3>

                        Conflict Repair

                    </h3>

                    <p>

                        Repair disagreements using a guided six-step reflection exercise.

                    </p>

                    <div class="resource-footer">

                        <span>

                            <i class="mdi mdi-clock-outline"></i>

                            10 mins

                        </span>

                        <a asp-page="/Resources/ConflictRepair/Index"
                           class="btn btn-light rounded-pill">

                            Start

                            <i class="mdi mdi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- Daily Check In -->

        <div class="col-lg-4 col-md-6">

            <div class="resource-card">

                <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=900&q=80"
                     class="resource-image" />

                <div class="resource-overlay"></div>

                <div class="resource-content">

                    <span class="resource-badge bg-primary">

                        Daily Practice

                    </span>

                    <h3>

                        Daily Check-In

                    </h3>

                    <p>

                        Build stronger communication through daily conversations.

                    </p>

                    <div class="resource-footer">

                        <span>

                            <i class="mdi mdi-clock-outline"></i>

                            5 mins

                        </span>

                        <a asp-page="/Resources/DailyCheckIn/Index"
                           class="btn btn-light rounded-pill">

                            Start

                            <i class="mdi mdi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- Love Languages -->

        <div class="col-lg-4 col-md-6">

            <div class="resource-card">

                <img src="https://images.unsplash.com/photo-1516589091380-5d8e87df6999?auto=format&fit=crop&w=900&q=80"
                     class="resource-image" />

                <div class="resource-overlay"></div>

                <div class="resource-content">

                    <span class="resource-badge bg-success">

                        Family

                    </span>

                    <h3>

                        Family & Boundaries

                    </h3>

                    <p>

                        Build healthy boundaries together, communicate with confidence, and protect the unity of your relationship.


                    </p>

                    <div class="resource-footer">

                        <span>

                            <i class="mdi mdi-clock-outline"></i>

                            15 mins

                        </span>

                        <a asp-page="/Resources/FamilyBoundaries/Index"
                           class="btn btn-light rounded-pill">

                            Start

