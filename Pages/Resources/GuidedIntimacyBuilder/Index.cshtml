@page
@model CouplesConnect.Pages.Resources.GuidedIntimacyBuilder.IndexModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Guided Intimacy Builder";
}


<div class="container-fluid py-4">

    <!-- HERO -->

    <section class="gi-hero">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="gi-tag">

                    Couples Connect Resource

                </span>

                <h1>

                    Guided Intimacy Builder

                </h1>

                <p>

                    Strengthen emotional closeness through intentional conversations, affection, trust and meaningful daily connection.

                </p>

                <div class="gi-badges">

                    <span>

                        <i class="mdi mdi-heart-outline"></i>

                        Emotional Connection

                    </span>

                    <span>

                        <i class="mdi mdi-account-heart-outline"></i>

                        Healthy Affection

                    </span>

                    <span>

                        <i class="mdi mdi-hand-heart-outline"></i>

                        Relationship Growth

                    </span>

                </div>

            </div>

            <div class="col-lg-4 text-center">

                <img src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=900&q=80"
                     class="img-fluid rounded-4 shadow-lg" />

            </div>

        </div>

    </section>

    <div class="gi-layout mt-4">

        <!-- SIDEBAR -->

        <aside class="gi-sidebar">

            <h5>

                Connection Journey

            </h5>

            <div class="gi-progress">

                <div id="progressBar"></div>

            </div>

            <div class="gi-step active">

                <span>1</span>

                Focus

            </div>

            <div class="gi-step">

                <span>2</span>

                Activities

            </div>

            <div class="gi-step">

                <span>3</span>

                Weekly Plan

            </div>

            <div class="gi-step">

                <span>4</span>

                Commitment

            </div>

            <div class="gi-step">

                <span>5</span>

                Review

            </div>

            <div class="gi-tip">

                <h6>

                    Daily Reminder

                </h6>

                <p id="connectionTip">

                    Small intentional moments build lasting intimacy.

                </p>

            </div>

        </aside>

        <main>

            <!-- STEP 1 -->

            <div class="gi-card active-step">

                <div class="gi-header">

                    <div class="gi-number">

                        1

                    </div>

                    <div>

                        <h2>

                            Choose Your Focus

                        </h2>

                        <p>

                            What would you like to strengthen together this week?

                        </p>

                    </div>

                </div>

                <div class="focus-grid">

                    <div class="focus-card"
                         data-focus="Emotional closeness">

                        ❤️

                        <span>

                            Emotional Closeness

                        </span>

                    </div>

                    <div class="focus-card"
                         data-focus="Affection and warmth">

                        🤗

                        <span>

                            Affection & Warmth

                        </span>

                    </div>

                    <div class="focus-card"
                         data-focus="Quality time">

                        ⏳

                        <span>

                            Quality Time

                        </span>

                    </div>

                    <div class="focus-card"
                         data-focus="Vulnerability and honesty">

                        💬

                        <span>

                            Vulnerability

                        </span>

                    </div>

                    <div class="focus-card"
                         data-focus="Repair after distance">

                        🕊️

                        <span>

                            Reconnection

                        </span>

                    </div>

                </div>

            </div>
            <!-- STEP 2 -->

            <div class="gi-card">

                <div class="gi-header">

                    <div class="gi-number">

                        2

                    </div>

                    <div>

                        <h2>

                            Suggested Connection Activities

                        </h2>

                        <p>

                            Choose one or more activities to intentionally practice together this week.

                        </p>

                    </div>

                </div>

                <div class="activity-info">

                    <i class="mdi mdi-lightbulb-on-outline"></i>

                    <div>

                        <strong>

                            Personalised Suggestions

                        </strong>

                        <p>

                            The activities below will change automatically when you select a focus area.

                        </p>

                    </div>

                </div>

                <div id="activityContainer"
                     class="activity-grid">
                </div>

            </div>

            <!-- STEP 3 -->

            <div class="gi-card">

                <div class="gi-header">

                    <div class="gi-number">

                        3

                    </div>

                    <div>

                        <h2>

                            Your Weekly Connection Plan

                        </h2>

                        <p>

                            Write one practical habit you'll intentionally practice this week.

                        </p>

                    </div>

                </div>

                <textarea id="weeklyPlan"
                          aria-label="Weekly intimacy plan"
                          class="gi-textarea"
                          placeholder="Example: Every evening we'll spend 20 uninterrupted minutes talking about our day before using our phones."></textarea>

            </div>

            <!-- STEP 4 -->

            <div class="gi-card">

                <div class="gi-header">

                    <div class="gi-number">

                        4

                    </div>

                    <div>

                        <h2>

                            Our Commitment

                        </h2>

                        <p>

                            Finish the statement together.

                        </p>

                    </div>

                </div>

                <div class="commitment-card">

                    <i class="mdi mdi-hand-heart"></i>

                    <div>

                        <strong>

                            This Week We Commit To...

                        </strong>

                    </div>

                </div>

                <textarea id="commitment"
                          aria-label="Our commitment"
                          class="gi-textarea"
                          placeholder="We commit to intentionally making each other feel heard, appreciated and emotionally safe every day."></textarea>

            </div>

            <!-- STEP 5 -->

            <div class="gi-card">

                <div class="gi-header">

                    <div class="gi-number">

                        5

                    </div>

                    <div>

                        <h2>

                            Review Your Plan

                        </h2>

                        <p>

                            Review your personalised intimacy plan before saving it.

                        </p>

                    </div>

                </div>

                <div class="review-card">

                    <div class="review-item">

                        <h6>

                            Focus Area

                        </h6>

                        <p id="reviewFocus">

                            -

                        </p>

                    </div>

                    <div class="review-item">

                        <h6>

                            Weekly Plan

                        </h6>

                        <p id="reviewPlan">

                            -

                        </p>

                    </div>

                    <div class="review-item">

                        <h6>

                            Commitment

                        </h6>

                        <p id="reviewCommitment">

                            -

                        </p>

                    </div>

                </div>

            </div>

            <!-- ACTION BAR -->

            <div class="gi-actionbar">

                <div>

                    <button type="button"
                            id="btnPrevious"
                            class="btn btn-outline-secondary">

                        <i class="mdi mdi-arrow-left"></i>

                        Previous

                    </button>

                </div>

                <div class="gi-status">

                    <div class="gi-status-dot"></div>

                    <div>

                        <strong id="saveStatus">

                            Ready

                        </strong>

                        <small>

                            Your progress is automatically saved

                        </small>

                    </div>

                </div>

                <div>

                    <button type="button"
                            id="btnSave"
                            class="btn btn-outline-success me-2">

                        <i class="mdi mdi-content-save"></i>

                        Save

                    </button>

                    <button type="button"
                            id="btnDownload"
                            class="btn btn-outline-primary me-2">

                        <i class="mdi mdi-download"></i>

                        Download

                    </button>

                    <button type="button"
                            id="btnNext"
                            class="btn btn-gradient">

                        Next

                        <i class="mdi mdi-arrow-right"></i>

                    </button>

                </div>

            </div>

        </main>

    </div>

    <!-- COMPLETION -->

    <div id="completionScreen"
         class="gi-complete"
         style="display:none;">

        <i class="mdi mdi-heart-circle"></i>

        <h2>

            Connection Plan Complete

        </h2>

        <p>

            Consistent emotional connection is built through small, intentional actions. Keep practicing your plan and revisit it together every week.

        </p>

        <button type="button"
                id="btnDownloadComplete"
                class="btn btn-gradient btn-lg">

            Download My Plan

        </button>

    </div>

</div>

<style>
    /*==================================================
        Couples Connect - Guided Intimacy Builder
    ==================================================*/

    :root {
        --primary: #8B5CF6;
        --secondary: #EC4899;
        --success: #22C55E;
        --danger: #EF4444;
        --warning: #F59E0B;
        --text: #111827;
        --muted: #6B7280;
        --border: #E5E7EB;
        --bg: #F5F7FB;
    }

    body {
        background: var(--bg);
    }

    /*==================================================
    HERO
    ==================================================*/

    .gi-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 30px 40px;
        background: linear-gradient(135deg,#8B5CF6,#EC4899);
        color: #fff;
        box-shadow: 0 20px 45px rgba(139,92,246,.18);
    }

        .gi-hero::before {
            content: "";
            position: absolute;
            width: 360px;
            height: 360px;
            right: -120px;
            top: -120px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

        .gi-hero::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            left: -60px;
            bottom: -60px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

        .gi-hero > * {
            position: relative;
            z-index: 2;
        }

    .gi-tag {
        display: inline-flex;
        padding: 8px 18px;
        border-radius: 999px;
        background: rgba(255,255,255,.15);
        backdrop-filter: blur(10px);
        font-weight: 600;
        margin-bottom: 16px;
    }

    .gi-hero h1 {
        font-size: 42px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .gi-hero p {
        max-width: 640px;
        line-height: 1.8;
        font-size: 16px;
    }

    .gi-hero img {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-radius: 18px;
        box-shadow: 0 15px 35px rgba(0,0,0,.25);
    }

    .gi-badges {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

        .gi-badges span {
            padding: 8px 16px;
            border-radius: 999px;
            background: rgba(255,255,255,.15);
            backdrop-filter: blur(10px);
            font-size: 13px;
            font-weight: 600;
        }

    /*==================================================
    LAYOUT
    ==================================================*/

    .gi-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 25px;
    }

    @@media(max - width:992px) {
        .gi-layout

    {
        grid-template-columns: 1fr;
    }

    }

    /*==================================================
    SIDEBAR
    ==================================================*/

    .gi-sidebar {
        position: sticky;
        top: 90px;
        background: #fff;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 15px 35px rgba(15,23,42,.08);
    }

        .gi-sidebar h5 {
            font-weight: 700;
            margin-bottom: 18px;
        }

    .gi-progress {
        height: 8px;
        background: #E5E7EB;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 22px;
    }

    #progressBar {
        width: 20%;
        height: 100%;
        background: linear-gradient(135deg,#8B5CF6,#EC4899);
        transition: .35s;
    }

    .gi-step {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        margin-bottom: 8px;
        border-radius: 14px;
        color: #6B7280;
        font-weight: 600;
        transition: .25s;
    }

        .gi-step span {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #E5E7EB;
            margin-right: 12px;
            font-size: 13px;
            font-weight: 700;
        }

        .gi-step.active {
            background: #F5F3FF;
            color: #7C3AED;
        }

            .gi-step.active span {
                background: #7C3AED;
                color: #fff;
            }

    .gi-tip {
        margin-top: 22px;
        padding: 16px;
        border-radius: 16px;
        background: #F5F3FF;
        border-left: 4px solid #7C3AED;
    }

        .gi-tip h6 {
            margin-bottom: 8px;
            font-weight: 700;
        }

        .gi-tip p {
            margin: 0;
            color: #6B7280;
            line-height: 1.7;
            font-size: 14px;
        }
    /*==================================================
    CONTENT CARDS
    ==================================================*/

    .gi-card {
        display: none;
        background: #fff;
        border-radius: 22px;
        padding: 28px;
        box-shadow: 0 15px 40px rgba(15,23,42,.06);
        animation: fadeCard .35s ease;
    }

        .gi-card.active-step {
            display: block;
        }

    @@keyframes fadeCard {
        from

    {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: none;
    }

    }

    /*==================================================
    HEADER
    ==================================================*/

    .gi-header {
        display: flex;
        align-items: center;
        margin-bottom: 25px;
    }

    .gi-number {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg,#8B5CF6,#EC4899);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 700;
        margin-right: 18px;
        box-shadow: 0 12px 24px rgba(139,92,246,.25);
    }

    .gi-header h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        color: #111827;
    }

    .gi-header p {
        margin: 6px 0 0;
        color: #6B7280;
        font-size: 15px;
    }

    /*==================================================
    FOCUS CARDS
    ==================================================*/

    .focus-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 18px;
    }

    .focus-card {
        background: #F8FAFC;
        border: 2px solid #E5E7EB;
        border-radius: 18px;
        min-height: 155px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: .25s;
        font-size: 40px;
        padding: 20px;
    }

        .focus-card:hover {
            transform: translateY(-5px);
            border-color: #8B5CF6;
            box-shadow: 0 15px 30px rgba(139,92,246,.15);
        }

        .focus-card.active {
            background: #F5F3FF;
            border-color: #8B5CF6;
            color: #8B5CF6;
        }

        .focus-card span {
            display: block;
            margin-top: 15px;
            font-size: 15px;
            font-weight: 700;
            color: #111827;
            text-align: center;
        }

    /*==================================================
    ACTIVITY INFO
    ==================================================*/

    .activity-info {
        display: flex;
        gap: 18px;
        padding: 18px;
        background: #F5F3FF;
        border-left: 5px solid #8B5CF6;
        border-radius: 18px;
        margin-bottom: 24px;
    }

        .activity-info i {
            font-size: 32px;
            color: #8B5CF6;
        }

        .activity-info strong {
            display: block;
            margin-bottom: 6px;
        }

        .activity-info p {
            margin: 0;
            color: #6B7280;
            line-height: 1.7;
        }

    /*==================================================
    ACTIVITY GRID
    ==================================================*/

    .activity-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 18px;
    }

    .activity-card {
        background: #F8FAFC;
        border: 2px solid #E5E7EB;
        border-radius: 18px;
        padding: 22px;
        cursor: pointer;
        transition: .25s;
        position: relative;
    }

        .activity-card:hover {
            transform: translateY(-4px);
            border-color: #8B5CF6;
            box-shadow: 0 15px 30px rgba(139,92,246,.12);
        }

        .activity-card.active {
            background: #F5F3FF;
            border-color: #8B5CF6;
        }

        .activity-card i {
            font-size: 32px;
            color: #8B5CF6;
            margin-bottom: 14px;
        }

        .activity-card h5 {
            margin-bottom: 10px;
            font-weight: 700;
            color: #111827;
        }

        .activity-card p {
            margin: 0;
            color: #6B7280;
            line-height: 1.8;
            font-size: 15px;
        }

    /*==================================================
    TEXTAREA
    ==================================================*/

    .gi-textarea {
        width: 100%;
        height: 190px;
        resize: none;
        border-radius: 18px;
        border: 2px solid #E5E7EB;
        padding: 18px;
        font-size: 15px;
        line-height: 1.8;
        transition: .25s;
    }

        .gi-textarea:focus {
            outline: none;
            border-color: #8B5CF6;
            box-shadow: 0 0 0 5px rgba(139,92,246,.10);
        }

    /*==================================================
    COMMITMENT
    ==================================================*/

    .commitment-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 24px;
        border-radius: 20px;
        background: linear-gradient(135deg,#F5F3FF,#FDF2F8);
        margin-bottom: 22px;
    }

        .commitment-card i {
            width: 72px;
            height: 72px;
            border-radius: 18px;
            background: #8B5CF6;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            flex-shrink: 0;
        }

        .commitment-card strong {
            font-size: 18px;
            color: #111827;
        }

    /*==================================================
    REVIEW
    ==================================================*/

    .review-card {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 18px;
    }

    .review-item {
        background: #F8FAFC;
        border-left: 5px solid #8B5CF6;
        border-radius: 18px;
        padding: 20px;
    }

        .review-item h6 {
            margin-bottom: 10px;
            color: #8B5CF6;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .6px;
        }

        .review-item p {
            margin: 0;
            color: #374151;
            line-height: 1.8;
            white-space: pre-wrap;
        }
    /*==================================================
    ACTION BAR
    ==================================================*/

    .gi-actionbar {
        position: sticky;
        bottom: 15px;
        z-index: 999;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-top: 25px;
        padding: 15px 20px;
        background: #fff;
        border-radius: 20px;
        border: 1px solid #EEF2F7;
        box-shadow: 0 18px 45px rgba(15,23,42,.12);
    }

        .gi-actionbar > div {
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .gi-status {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        background: #F8FAFC;
        border-radius: 14px;
        padding: 10px 18px;
    }

    .gi-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #22C55E;
        animation: giPulse 2s infinite;
    }

    @@keyframes giPulse {
        0%

    {
        box-shadow: 0 0 0 0 rgba(34,197,94,.6);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(34,197,94,0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(34,197,94,0);
    }

    }

    .gi-status strong {
        display: block;
        font-size: 14px;
    }

    .gi-status small {
        display: block;
        color: #6B7280;
        font-size: 12px;
    }

    /*==================================================
    BUTTONS
    ==================================================*/

    .gi-actionbar .btn {
        height: 46px;
        padding: 0 22px;
        border-radius: 12px;
        font-weight: 600;
        transition: .25s;
    }

        .gi-actionbar .btn:hover {
            transform: translateY(-2px);
        }

    .btn-gradient {
        background: linear-gradient(135deg,#8B5CF6,#EC4899);
        border: none;
        color: #fff;
    }

        .btn-gradient:hover {
            color: #fff;
            box-shadow: 0 12px 25px rgba(139,92,246,.35);
        }

    .btn-outline-primary {
        border: 2px solid #8B5CF6;
    }

        .btn-outline-primary:hover {
            background: #8B5CF6;
            color: #fff;
        }

    .btn-outline-success {
        border: 2px solid #22C55E;
    }

        .btn-outline-success:hover {
            background: #22C55E;
            color: #fff;
        }

    /*==================================================
    COMPLETION
    ==================================================*/

    .gi-complete {
        background: #fff;
        border-radius: 24px;
        padding: 70px 45px;
        text-align: center;
        box-shadow: 0 18px 45px rgba(15,23,42,.08);
        animation: fadeCard .35s ease;
    }

        .gi-complete i {
            font-size: 90px;
            color: #8B5CF6;
            margin-bottom: 22px;
        }

        .gi-complete h2 {
            font-size: 42px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 15px;
        }

        .gi-complete p {
            max-width: 700px;
            margin: 0 auto 35px;
            color: #6B7280;
            line-height: 1.8;
            font-size: 16px;
        }

    /*==================================================
    FORM CONTROLS
    ==================================================*/

    .form-control {
        height: 52px;
        border-radius: 14px;
        border: 2px solid #E5E7EB;
    }

        .form-control:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 0 5px rgba(139,92,246,.10);
        }

    /*==================================================
    SCROLLBAR
    ==================================================*/

    textarea::-webkit-scrollbar {
        width: 8px;
    }

    textarea::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 20px;
    }

    textarea::-webkit-scrollbar-track {
        background: #F8FAFC;
    }

    /*==================================================
    RESPONSIVE
    ==================================================*/

    @@media(max - width:1200px) {
        .gi-layout

    {
        grid-template-columns: 250px 1fr;
    }

    }

    @@media(max - width:992px) {
        .gi-layout

    {
        grid-template-columns: 1fr;
    }

    .gi-sidebar {
        position: relative;
        top: auto;
        margin-bottom: 20px;
    }

    .focus-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .activity-grid {
        grid-template-columns: 1fr;
    }

    .review-card {
        grid-template-columns: 1fr;
    }

    .gi-actionbar {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }

        .gi-actionbar > div {
            justify-content: center;
            flex-wrap: wrap;
        }

        .gi-actionbar .btn {
            width: 100%;
        }

    }

    @@media(max - width:768px) {
        .gi-hero

    {
        padding: 24px;
        text-align: center;
    }

    .gi-hero h1 {
        font-size: 34px;
