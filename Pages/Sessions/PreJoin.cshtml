@page "{sessionId:int}"
@model CouplesConnect.Pages.Sessions.PreJoinModel

<div class="page-header">
    <h3 class="page-title">Setup Your Session</h3>
</div>

<div class="row">

    <!-- VIDEO PREVIEW -->
    <div class="col-md-7 grid-margin stretch-card">
        <div class="card h-100">
            <div class="card-body">

                <h5 class="mb-3 fw-semibold">Camera Preview</h5>

                <div class="video-wrapper">
                    <video id="previewVideo" autoplay muted></video>
                </div>

            </div>
        </div>
    </div>

    <!-- SETTINGS -->
    <div class="col-md-5 grid-margin stretch-card">
        <div class="card h-100">
            <div class="card-body">

                <h5 class="mb-3 fw-semibold">Device Settings</h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Camera</label>
                    <select id="cameraSelect" class="form-select cc-input"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Microphone</label>
                    <select id="micSelect" class="form-select cc-input"></select>
                </div>

                <div class="mb-3">
                    <button onclick="testMic()" class="btn cc-btn-outline w-100">
                        Test Microphone
                    </button>
                </div>

                <div class="mt-4">
                    <button onclick="joinSession()" class="btn btn-primary w-100">
                        Join Session
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>

<style>

    /* VIDEO CONTAINER */
    .video-wrapper {
        width: 100%;
        height: 350px;
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .video-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* INPUT STYLE */
    .cc-input {
        height: 42px;
        font-size: 14px;
        color: #111827;
    }

    /* BUTTON CONSISTENCY */
    .btn {
        height: 42px;
    }

    /* CARD POLISH */
    .card {
        border-radius: 12px;
    }

</style>

<script>

    let currentStream;

    // 🔍 LOAD DEVICES
    async function loadDevices() {

        const devices = await navigator.mediaDevices.enumerateDevices();

        const cameras = devices.filter(d => d.kind === "videoinput");
        const mics = devices.filter(d => d.kind === "audioinput");

        const camSelect = document.getElementById("cameraSelect");
        const micSelect = document.getElementById("micSelect");

        camSelect.innerHTML = "";
        micSelect.innerHTML = "";

        cameras.forEach(cam => {
            camSelect.innerHTML += `<option value="${cam.deviceId}">${cam.label || "Camera"}</option>`;
        });

        mics.forEach(mic => {
            micSelect.innerHTML += `<option value="${mic.deviceId}">${mic.label || "Microphone"}</option>`;
        });
    }

    // 🎥 START PREVIEW
    async function startPreview() {

        if (currentStream) {
            currentStream.getTracks().forEach(t => t.stop());
        }

        const camId = document.getElementById("cameraSelect").value;
        const micId = document.getElementById("micSelect").value;

        try {

            currentStream = await navigator.mediaDevices.getUserMedia({
                video: camId ? { deviceId: camId } : true,
                audio: micId ? { deviceId: micId } : true
            });

            document.getElementById("previewVideo").srcObject = currentStream;

        } catch (err) {
            alert("Could not access camera/microphone");
        }
    }

    // 🎤 MIC TEST
    async function testMic() {

        const micId = document.getElementById("micSelect").value;

        const stream = await navigator.mediaDevices.getUserMedia({
            audio: micId ? { deviceId: micId } : true
        });

        const audioContext = new AudioContext();
        const source = audioContext.createMediaStreamSource(stream);

        alert("Microphone is working!");
    }

    // 💾 SAVE + JOIN
    function joinSession() {

        const camId = document.getElementById("cameraSelect").value;
        const micId = document.getElementById("micSelect").value;

        localStorage.setItem("cameraId", camId);
        localStorage.setItem("micId", micId);

        window.location.href = `/Sessions/Room/@Model.SessionId`;
    }

    // EVENTS
    document.getElementById("cameraSelect").addEventListener("change", startPreview);
    document.getElementById("micSelect").addEventListener("change", startPreview);

    // INIT
    (async () => {
        await loadDevices();
        await startPreview();
    })();

</script>