@page "{sessionId:int}"
@model CouplesConnect.Pages.Sessions.RoomModel

<link href="~/css/room.css" rel="stylesheet" />

<div class="page-header">
    <h4 class="page-title">Live Session</h4>
</div>

<div class="row">

    <!-- ===================== LEFT SIDE ===================== -->
    <div class="@(Model.IsCounselor ? "col-md-7" : "col-md-12")">

        <!-- TOP BAR -->
        <div class="session-topbar">

            <div class="connection-bar">
                <span class="status-dot" id="statusDot"></span>
                <span id="connectionText">Connecting...</span>
            </div>

            <div class="session-meta">

                <div class="meta-box">
                    <span>Session</span>
                    <strong id="timer">00:00:00</strong>
                </div>

                @if (Model.NextSessionTime != null)
                {
                    <div class="meta-box">
                        <span>Next</span>
                        <strong id="nextSessionCountdown"
                                data-time="@Model.NextSessionTime.Value.ToString("o")">
                        </strong>
                    </div>
                }

                <div class="meta-box">
                    👥 <span id="participantCount">1</span>
                </div>

                @if (!Model.IsCounselor)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#upcomingModal">
                        <i class="icon-calendar"></i> Upcoming
                    </button>
                }

            </div>

        </div>

        <p class="small text-muted mb-3">Use the site navigation to open another page in a new tab while keeping this session active.</p>

        <!-- WAITING -->
        <div id="waitingScreen" class="waiting-screen d-none">
            <h5>Waiting for therapist to admit you...</h5>
        </div>

        <!-- SESSION -->
        <div id="sessionUI" class="d-none">

            <div class="video-layout">

                <!-- MAIN -->
                <div id="mainStage" class="main-stage">
                    <div id="videoEmptyState" class="video-empty-state">
                        <span class="video-empty-icon">◉</span>
                        <strong>Waiting for participant video</strong>
                        <small>Your video appears in the tile below.</small>
                    </div>
                    @if (Model.IsCounselor)
                    {
                        <div id="roomAlert" class="room-alert d-none" role="status" aria-live="polite"></div>
                    }
                </div>

                <!-- PARTICIPANTS -->
                <div id="videosContainer" class="participants-grid"></div>

            </div>

            <!-- CONTROLS -->
            <div class="controls-bar">

                <button id="btnMic" onclick="toggleMute()" class="control-btn is-on" title="Mute microphone" aria-label="Mute microphone" aria-pressed="true">
                    <span class="control-icon">🎙</span><span class="control-label">Mic</span>
                </button>

                <button id="btnCam" onclick="toggleVideo()" class="control-btn is-on" title="Turn camera off" aria-label="Turn camera off" aria-pressed="true">
                    <span class="control-icon">📹</span><span class="control-label">Camera</span>
                </button>

                <button id="btnShare"
                        onclick="shareScreen()"
                        class="control-btn" title="Share screen" aria-label="Share screen" aria-pressed="false">
                    <span class="control-icon">▣</span><span class="control-label">Share</span>

                </button>

                @if (!Model.IsCounselor)
                {
                    <button id="btnHand" onclick="raiseHand()" class="control-btn" title="Raise hand" aria-label="Raise hand" aria-pressed="false">
                        <span class="control-icon">✋</span><span class="control-label">Hand</span>
                    </button>
                }

                

                @if (Model.IsCounselor)
                {
                    <button type="button"
                            id="btnEndSession"
                            onclick="endSession()"
                            class="control-btn danger" title="End session for everyone" aria-label="End session for everyone">
                        <span class="control-icon">■</span><span class="control-label">End session</span>
                    </button>
                }

                <button type="button"
                        id="btnLeave"
                        onclick="leaveSession()"
                        class="control-btn danger" title="Leave session" aria-label="Leave session">
                    <span class="control-icon">☎</span><span class="control-label">Leave</span>
                </button>

                

            </div>

        </div>

        <!-- FLOATING WAITING LIST -->
        <div id="waitingList" class="waiting-floating"></div>

    </div>

    <!-- ===================== RIGHT SIDE ===================== -->
    @if (Model.IsCounselor)
    {
        <div class="col-md-5">

            <!-- WAITING PANEL -->
            <div class="card mb-3">

                <div id="waitingPanel" class="p-3 d-none">

                    <div class="d-flex justify-content-between mb-2">
                        <strong>Waiting Room</strong>
                        <span id="waitingCount" class="badge cc-badge-warning">0</span>
                    </div>

                    <div id="waitingListContainer"></div>

                </div>

            </div>

            <!-- NOTES -->
            <div class="card notes-card">

                <div class="notes-header">
                    <div><strong>Session Notes</strong><small>Private to the counselor</small></div>

                    <button class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#upcomingModal">
                        Upcoming
                    </button>
                </div>

                <form id="notesForm" method="post" class="notes-body">

                    @Html.AntiForgeryToken()

                    <textarea id="notesBox"
                              name="Notes"
                              class="notes-textarea"
                              placeholder="Write session notes...">@Model.ExistingNotes</textarea>

                    <input type="hidden" name="SessionId" value="@Model.SessionId" />

                    <div class="notes-footer">

                        <small id="saveState" class="save-state" aria-live="polite">All changes saved</small>

                        <button id="saveNotesButton" type="button" onclick="saveNotes(true)" class="btn btn-primary btn-sm">
                            Save notes
                        </button>

                    </div>

                </form>

            </div>

        </div>
    }

</div>

<!-- MODAL -->
<div class="modal fade" id="upcomingModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Upcoming Sessions</h5>
            </div>

            <div class="modal-body">

                @if (Model.UpcomingSessions.Any())
                {
                    <ul class="list-group">

                        @foreach (var s in Model.UpcomingSessions)
                        {
                            <li class="list-group-item d-flex justify-content-between">

                                <div>
                                    <strong>@s.ScheduledStart.ToString("HH:mm")</strong><br />
                            <small>@(Model.IsCounselor ? s.User?.FullName : s.Counselor?.FullName)</small>
                                </div>

                                <span class="badge cc-badge-primary">
                                    @{
                                        var diff = s.ScheduledStart - DateTime.UtcNow;
                                        if (diff.TotalMinutes <= 0)
                                        {
                                            @:Now
                                        }
                                        else
                                        {
                                            @($"{(int)diff.TotalHours}h {diff.Minutes}m")
                                        }
                                    }
                                </span>

                            </li>
                        }

                    </ul>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        No upcoming sessions
                    </div>
                }

            </div>

        </div>
    </div>
</div>

<script>
    window.roomConfig = {
        sessionId: @Model.SessionId,
        isCounselor: @(Model.IsCounselor.ToString().ToLower()),
        returnUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IsCounselor ? "/Counselor/Sessions" : "/User/Bookings")),
        feedbackUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"/User/Sessions/Feedback/{Model.SessionId}")),
        azureCallToken: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AzureCallToken)),
        azureCallTokenExpiresOn: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AzureCallTokenExpiresOn)),
        azureCallGroupId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AzureCallGroupId))
    };
</script>

<script src="~/lib/microsoft-signalr/signalr.min.js"></script>

<script type="module" src="~/js/room/room.bundle.js"></script>
