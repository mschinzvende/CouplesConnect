@page "{sessionId:int}"
@model CouplesConnect.Pages.Sessions.RoomModel

<link href="~/css/room.css" rel="stylesheet" />

<h4 class="mb-3">Live Session</h4>

<div class="row">

    <!-- ===================== LEFT SIDE ===================== -->
    <div class="@(Model.IsCounselor ? "col-md-7" : "col-md-12")">

        <!-- TOP BAR -->
        <div class="d-flex justify-content-between align-items-center mb-2">

            <div class="connection-bar">
                <span class="status-dot" id="statusDot"></span>
                <span id="connectionText">Connecting...</span>
            </div>

            <div class="session-meta">

                <div class="timer-box">
                    <span>Session</span>
                    <strong id="timer">00:00</strong>
                </div>

                @if (Model.IsCounselor && Model.NextSessionTime != null)
                {
                    <div class="timer-box">
                        <span>Next</span>
                        <strong id="nextSessionCountdown"
                                data-time="@Model.NextSessionTime.Value.ToString("o")">
                        </strong>
                    </div>
                }

                <div class="participants-box">
                    👥 <span id="participantCount">1</span>
                </div>

            </div>

        </div>

        <!-- VIDEO SECTION -->
        <div id="waitingScreen" class="text-center mt-5 d-none">
            <h4>Waiting for therapist to admit you...</h4>
        </div>

        <div id="sessionUI" class="d-none">

            <div class="video-layout">

                <!-- MAIN VIDEO -->
                <div id="mainStage" class="main-stage">
                    <video id="activeSpeaker" autoplay></video>
                </div>

                <!-- PARTICIPANTS -->
                <div id="videosContainer" class="participants-grid"></div>

            </div>

            <!-- CONTROLS -->
            <div class="controls-bar">
                <button id="btnMic" onclick="toggleMute()">🎤</button>
                <button id="btnCam" onclick="toggleVideo()">📷</button>
                <button id="btnScreen" onclick="shareScreen()">🖥</button>
                <button id="btnHand" onclick="raiseHand()">✋</button>
                <button onclick="leaveSession()" class="danger">⏹</button>
            </div>

        </div>

        <!-- WAITING LIST -->
        <div id="waitingList" class="position-fixed top-0 end-0 m-3"></div>

    </div>

    <!-- ===================== RIGHT SIDE (NOTES) ===================== -->
    @if (Model.IsCounselor)
    {
        <div class="col-md-5">

            <div class="card h-100 shadow-sm d-flex flex-column">

                <div class="card-header d-flex justify-content-between">
                    <span>Session Notes</span>
                    <button class="btn btn-sm btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#upcomingModal">
                        Upcoming
                    </button>
                </div>

                <div class="card-body d-flex flex-column" style="min-height:400px;">

                    <textarea id="notesBox"
                              class="form-control flex-grow-1 mb-2"
                              style="resize:none;">@Model.ExistingNotes</textarea>

                    <button onclick="saveNotes()" class="btn btn-primary">
                        Save Notes
                    </button>

                    <div id="saveStatus" class="alert alert-success mt-2 d-none">
                        Notes saved ✓
                    </div>

                </div>

            </div>

        </div>
    }

</div>


<!-- ===================== UPCOMING MODAL ===================== -->
<div class="modal fade" id="upcomingModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Upcoming Sessions</h5>
            </div>

            <div class="modal-body">

                @if (Model.UpcomingSessions.Any())
                {
                    <ul class="list-group">

                        @foreach (var s in Model.UpcomingSessions)
                        {
                            <li class="list-group-item d-flex justify-content-between">

                                <div>
                                    <strong>@s.ScheduledStart.ToString("HH:mm")</strong><br />
                                    <small>@s.User?.FullName</small>
                                </div>

                                <span class="badge bg-primary">
                                    @((s.ScheduledStart - DateTime.UtcNow).TotalMinutes.ToString("0")) min
                                </span>

                            </li>
                        }

                    </ul>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        No upcoming sessions found
                    </div>
                }

            </div>

        </div>
    </div>
</div>




<!-- ===================== JAVASCRIPT ===================== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    

    const sessionId = "@Model.SessionId";
    const isCounselor = @Model.IsCounselor.ToString().ToLower();
    const sessionStart = new Date("@Model.SessionStartTime.ToString("o")");

    let connection;
    let localStream;
    let peerConnections = {};
    let isForceMuted = false;

    // ================= TIMER =================
    function startTimer() {

        setInterval(() => {
            const now = new Date();
            const diff = Math.floor((now - sessionStart) / 1000);

            if (diff < 0) return;

            const min = Math.floor(diff / 60);
            const sec = diff % 60;

            document.getElementById("timer").innerText =
                `${min.toString().padStart(2,'0')}:${sec.toString().padStart(2,'0')}`;

        }, 1000);
    }

    // NEXT SESSION TIMER
    function startNextSessionTimer() {

        const el = document.getElementById("nextSessionCountdown");
        if (!el) return;

        const target = new Date(el.dataset.time);

        setInterval(() => {

            const diff = target - new Date();

            if (diff <= 0) {
                el.innerText = "Now";
                return;
            }

            const min = Math.floor(diff / 60000);
            const sec = Math.floor((diff % 60000) / 1000);

            el.innerText = `${min}m ${sec}s`;

        }, 1000);
    }

    // ================= INIT =================
    async function init() {

        startTimer();
        startNextSessionTimer();

            

    

        connection = new signalR.HubConnectionBuilder()
            .withUrl("/sessionHub")
            .withAutomaticReconnect()
            .build();

        registerEvents();

        await connection.start();

        setConnectedState(true);

        if (isCounselor) {
            await connection.invoke("JoinSession", sessionId);
            startSessionUI();
        } else {
            document.getElementById("waitingScreen").classList.remove("d-none");
            await connection.invoke("RequestJoin", sessionId);
        }
    }


        function setConnectedState(isConnected) {

        const dot = document.getElementById("statusDot");
        const text = document.getElementById("connectionText");

        if (isConnected) {
            dot.classList.add("connected");
            text.innerText = "Connected";
        } else {
            dot.classList.remove("connected");
            text.innerText = "Connecting...";
        }
    }
    // ================= EVENTS =================
    function registerEvents() {

        connection.on("Admitted", () => {
            document.getElementById("waitingScreen").classList.add("d-none");
            startSessionUI();
        });

        connection.on("ExistingParticipants", users => {
            users.forEach(id => createPeer(id));
                updateParticipantCount();
        });

        connection.on("UserJoined", id => {
            createPeer(id, true);
                updateParticipantCount();
        });

        connection.on("ReceiveOffer", async (id, offer) => {
            const pc = createPeer(id);
            await pc.setRemoteDescription(JSON.parse(offer));

            const answer = await pc.createAnswer();
            await pc.setLocalDescription(answer);

            connection.invoke("SendAnswer", id, JSON.stringify(answer));
        });

        connection.on("ReceiveAnswer", async (id, answer) => {
            await peerConnections[id].setRemoteDescription(JSON.parse(answer));
        });

        connection.on("ReceiveIceCandidate", async (id, candidate) => {
            await peerConnections[id].addIceCandidate(JSON.parse(candidate));
        });

      connection.onreconnecting(() => {
        setConnectedState(false);
    });

    connection.onreconnected(() => {
        setConnectedState(true);
    });
    }

    // ================= VIDEO =================
    async function startSessionUI() {

        document.getElementById("sessionUI").classList.remove("d-none");

        localStream = await navigator.mediaDevices.getUserMedia({
            video: true,
            audio: true
        });

        attachVideo("self", localStream, true);
    }

    function createPeer(id, initiator=false) {

        if (peerConnections[id]) return peerConnections[id];

        const pc = new RTCPeerConnection({
            iceServers: [{ urls: "stun:stun.l.google.com:19302" }]
        });

        peerConnections[id] = pc;

        localStream.getTracks().forEach(t => pc.addTrack(t, localStream));

            pc.ontrack = e => {
        const stream = e.streams[0];
        const video = attachVideo(id, stream);
        detectAudioLevel(stream, video);
    };

        pc.onicecandidate = e => {
            if (e.candidate)
                connection.invoke("SendIceCandidate", id, JSON.stringify(e.candidate));
        };

        if (initiator) {
            pc.createOffer().then(o => {
                pc.setLocalDescription(o);
                connection.invoke("SendOffer", id, JSON.stringify(o));
            });
        }

        return pc;
    }

        function attachVideo(id, stream, isSelf=false) {

        let video = document.getElementById("video-"+id);

        if (!video) {
            video = document.createElement("video");
            video.id = "video-"+id;
            video.autoplay = true;
            video.muted = isSelf;

            if (isSelf) video.classList.add("self");

            document.getElementById("videosContainer").appendChild(video);
        }

        video.srcObject = stream;

        if (!document.getElementById("activeSpeaker").srcObject) {
            setActive(stream, video);
        }
    }
        function detectAudioLevel(stream, videoEl) {

        const ctx = new AudioContext();
        const analyser = ctx.createAnalyser();
        const mic = ctx.createMediaStreamSource(stream);

        mic.connect(analyser);

        const data = new Uint8Array(analyser.frequencyBinCount);

        setInterval(() => {
            analyser.getByteFrequencyData(data);
            const volume = data.reduce((a,b)=>a+b)/data.length;

            if (volume > 35) {
                setActive(stream, videoEl);
            }
        }, 400);
    }
        function setActive(stream, videoEl=null) {

        document.getElementById("activeSpeaker").srcObject = stream;

        document.querySelectorAll("#videosContainer video")
            .forEach(v => v.classList.remove("active"));

        if (videoEl) videoEl.classList.add("active");
    }
    // ================= CONTROLS =================
    function toggleMute() {
        if (!isCounselor && isForceMuted) return;
        localStream.getAudioTracks().forEach(t => t.enabled = !t.enabled);
    }

    function toggleVideo() {
        localStream.getVideoTracks().forEach(t => t.enabled = !t.enabled);
    }

    function shareScreen() {
        navigator.mediaDevices.getDisplayMedia({ video:true })
            .then(screen=>{
                Object.values(peerConnections).forEach(pc=>{
                    const sender = pc.getSenders().find(s=>s.track.kind==="video");
                    if (sender) sender.replaceTrack(screen.getTracks()[0]);
                });
            });
    }

    function raiseHand() {
        connection.invoke("RaiseHand", sessionId);
    }

    function leaveSession() {
        window.location.href = "/";
    }

    // ================= NOTES =================
    function saveNotes() {

        fetch("?handler=SaveNotes", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                sessionId: sessionId,
                notes: document.getElementById("notesBox").value
            })
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                const el = document.getElementById("saveStatus");
                el.classList.remove("d-none");
                setTimeout(()=>el.classList.add("d-none"),2000);
            }
        });
    }

    // START
    init();


        let isMuted = false;

    function toggleMute() {

        if (!isCounselor && isForceMuted) return;

        isMuted = !isMuted;

        localStream.getAudioTracks().forEach(t => t.enabled = !isMuted);

        const btn = document.getElementById("btnMic");
        btn.classList.toggle("off", isMuted);
    }

        let isCameraOff = false;

    function toggleVideo() {

        isCameraOff = !isCameraOff;

        localStream.getVideoTracks().forEach(t => t.enabled = !isCameraOff);

        const btn = document.getElementById("btnCam");
        btn.classList.toggle("off", isCameraOff);
    }

    let handRaised = false;

function raiseHand() {

    handRaised = !handRaised;

    const btn = document.getElementById("btnHand");
    btn.classList.toggle("hand-raised", handRaised);

    connection.invoke("RaiseHand", sessionId);
}

    function updateParticipantCount() {

        const count = Object.keys(peerConnections).length + 1; // + self
        document.getElementById("participantCount").innerText = count;
    }


</script>