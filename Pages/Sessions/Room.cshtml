@page "{sessionId:int}"
@model CouplesConnect.Pages.Sessions.RoomModel

<link href="~/css/room.css" rel="stylesheet" />

<div class="page-header">
    <h4 class="page-title">Live Session</h4>
</div>

<div class="row">

    <!-- ===================== LEFT SIDE ===================== -->
    <div class="@(Model.IsCounselor ? "col-md-7" : "col-md-12")">

        <!-- TOP BAR -->
        <div class="session-topbar">

            <div class="connection-bar">
                <span class="status-dot" id="statusDot"></span>
                <span id="connectionText">Connecting...</span>
            </div>

            <div class="session-meta">

                <div class="meta-box">
                    <span>Session</span>
                    <strong id="timer">00:00:00</strong>
                </div>

                @if (Model.IsCounselor && Model.NextSessionTime != null)
                {
                    <div class="meta-box">
                        <span>Next</span>
                        <strong id="nextSessionCountdown"
                                data-time="@Model.NextSessionTime.Value.ToString("o")">
                        </strong>
                    </div>
                }

                <div class="meta-box">
                    👥 <span id="participantCount">1</span>
                </div>

            </div>

        </div>

        <!-- WAITING -->
        <div id="waitingScreen" class="waiting-screen d-none">
            <h5>Waiting for therapist to admit you...</h5>
        </div>

        <!-- SESSION -->
        <div id="sessionUI" class="d-none">

            <div class="video-layout">

                <!-- MAIN -->
                <div id="mainStage" class="main-stage">
                    <video id="activeSpeaker" autoplay></video>
                </div>

                <!-- PARTICIPANTS -->
                <div id="videosContainer" class="participants-grid"></div>

            </div>

            <!-- CONTROLS -->
            <div class="controls-bar">

                <button id="btnMic" onclick="toggleMute()" class="control-btn">
                    🎤
                </button>

                <button id="btnCam" onclick="toggleVideo()" class="control-btn">
                    📷
                </button>

                <button id="btnHand" onclick="raiseHand()" class="control-btn">
                    ✋
                </button>

                <button onclick="leaveSession()" class="control-btn danger">
                    ⏹
                </button>

            </div>

        </div>

        <!-- FLOATING WAITING LIST -->
        <div id="waitingList" class="waiting-floating"></div>

    </div>

    <!-- ===================== RIGHT SIDE ===================== -->
    @if (Model.IsCounselor)
    {
        <div class="col-md-5">

            <!-- WAITING PANEL -->
            <div class="card mb-3">

                <div id="waitingPanel" class="p-3 d-none">

                    <div class="d-flex justify-content-between mb-2">
                        <strong>Waiting Room</strong>
                        <span id="waitingCount" class="badge cc-badge-warning">0</span>
                    </div>

                    <div id="waitingListContainer"></div>

                </div>

            </div>

            <!-- NOTES -->
            <div class="card">

                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <strong>Session Notes</strong>

                    <button class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#upcomingModal">
                        Upcoming
                    </button>
                </div>

                <form id="notesForm" method="post" class="p-3">

                    @Html.AntiForgeryToken()

                    <textarea id="notesBox"
                              name="Notes"
                              class="form-control mb-2"
                              style="height: 200px;"
                              placeholder="Write session notes...">@Model.ExistingNotes</textarea>

                    <input type="hidden" name="SessionId" value="@Model.SessionId" />

                    <div class="d-flex justify-content-between align-items-center">

                        <small id="saveState" class="text-muted">Idle</small>

                        <button type="button" onclick="saveNotes(true)" class="btn btn-primary btn-sm">
                            Save
                        </button>

                    </div>

                </form>

            </div>

        </div>
    }

</div>

<!-- MODAL -->
<div class="modal fade" id="upcomingModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Upcoming Sessions</h5>
            </div>

            <div class="modal-body">

                @if (Model.UpcomingSessions.Any())
                {
                    <ul class="list-group">

                        @foreach (var s in Model.UpcomingSessions)
                        {
                            <li class="list-group-item d-flex justify-content-between">

                                <div>
                                    <strong>@s.ScheduledStart.ToString("HH:mm")</strong><br />
                                    <small>@s.User?.FullName</small>
                                </div>

                                <span class="badge cc-badge-primary">
                                    @{
                                        var diff = s.ScheduledStart - DateTime.UtcNow;
                                        if (diff.TotalMinutes <= 0)
                                        {
                                            @:Now
                                        }
                                        else
                                        {
                                            @($"{(int)diff.TotalHours}h {diff.Minutes}m")
                                        }
                                    }
                                </span>

                            </li>
                        }

                    </ul>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        No upcoming sessions
                    </div>
                }

            </div>

        </div>
    </div>
</div>

<style>

    /* TOP BAR */
    .session-topbar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    /* META */
    .meta-box {
        background: #f9fafb;
        padding: 6px 10px;
        border-radius: 8px;
        text-align: center;
    }

    /* WAITING */
    .waiting-screen {
        text-align: center;
        margin-top: 40px;
    }

    /* VIDEO */
    .video-layout {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .main-stage {
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        height: 350px;
    }

        .main-stage video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* PARTICIPANTS */
    .participants-grid {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* CONTROLS */
    .controls-bar {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 15px;
    }

    .control-btn {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        border: none;
        background: #f3f4f6;
    }

        .control-btn.danger {
            background: #ef4444;
            color: white;
        }

    /* BADGES */
    .cc-badge-primary {
        background: #eef2ff;
        color: #4338ca;
    }

    .cc-badge-warning {
        background: #fef3c7;
        color: #92400e;
    }

</style>


<!-- ===================== JAVASCRIPT ===================== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    

    const sessionId = "@Model.SessionId";
    const isCounselor = @Model.IsCounselor.ToString().ToLower();
    const sessionStart = new Date("@Model.SessionStartTime.ToString("o")");

    let connection;
    let localStream;
    let peerConnections = {};
    let isForceMuted = false;

    // ================= TIMER =================
        function startTimer() {

        setInterval(() => {

            const now = new Date();
            const diff = Math.floor((now - sessionStart) / 1000);

            if (diff < 0) return;

            const hours = Math.floor(diff / 3600);
            const minutes = Math.floor((diff % 3600) / 60);
            const seconds = diff % 60;

            document.getElementById("timer").innerText =
                `${hours.toString().padStart(2,'0')}:` +
                `${minutes.toString().padStart(2,'0')}:` +
                `${seconds.toString().padStart(2,'0')}`;

        }, 1000);
    }

    // NEXT SESSION TIMER
        function startNextSessionTimer() {

        const el = document.getElementById("nextSessionCountdown");
        if (!el) return;

        const target = new Date(el.dataset.time);

        setInterval(() => {

            const diff = Math.floor((target - new Date()) / 1000);

            if (diff <= 0) {
                el.innerText = "00:00:00";
                return;
            }

            const hours = Math.floor(diff / 3600);
            const minutes = Math.floor((diff % 3600) / 60);
            const seconds = diff % 60;

            el.innerText =
                `${hours.toString().padStart(2,'0')}:` +
                `${minutes.toString().padStart(2,'0')}:` +
                `${seconds.toString().padStart(2,'0')}`;

        }, 1000);
    }

    // ================= INIT =================
    async function init() {

        startTimer();
        startNextSessionTimer();

        connection = new signalR.HubConnectionBuilder()
            .withUrl("/sessionHub")
            .withAutomaticReconnect()
            .build();

        registerEvents();

        await connection.start();

        setConnectedState(true);

        if (isCounselor) {
            await connection.invoke("JoinSession", sessionId);
            startSessionUI();
        } else {
            document.getElementById("waitingScreen").classList.remove("d-none");
            await connection.invoke("RequestJoin", sessionId);
        }
    }


        function setConnectedState(isConnected) {

        const dot = document.getElementById("statusDot");
        const text = document.getElementById("connectionText");

        if (isConnected) {
            dot.classList.add("connected");
            text.innerText = "Connected";
        } else {
            dot.classList.remove("connected");
            text.innerText = "Connecting...";
        }
    }
    // ================= EVENTS =================
    function registerEvents() {

        connection.on("Admitted", () => {
            document.getElementById("waitingScreen").classList.add("d-none");
            startSessionUI();
        });

        connection.on("ExistingParticipants", users => {
            users.forEach(id => createPeer(id));
                updateParticipantCount();
        });

        connection.on("UserJoined", id => {
            createPeer(id, true);
                updateParticipantCount();
                    waitingUsers.delete(id);
                        renderWaitingList();
        });

        connection.on("ReceiveOffer", async (id, offer) => {
            const pc = createPeer(id);
            await pc.setRemoteDescription(JSON.parse(offer));

            const answer = await pc.createAnswer();
            await pc.setLocalDescription(answer);

            connection.invoke("SendAnswer", id, JSON.stringify(answer));
        });

        connection.on("ReceiveAnswer", async (id, answer) => {
            await peerConnections[id].setRemoteDescription(JSON.parse(answer));
        });

        connection.on("ReceiveIceCandidate", async (id, candidate) => {
            await peerConnections[id].addIceCandidate(JSON.parse(candidate));
        });

      connection.onreconnecting(() => {
        setConnectedState(false);
    });

    connection.onreconnected(() => {
        setConnectedState(true);
    });
    }

    // ================= VIDEO =================
    async function startSessionUI() {

        document.getElementById("sessionUI").classList.remove("d-none");

        localStream = await navigator.mediaDevices.getUserMedia({
            video: true,
            audio: true
        });

        attachVideo("self", localStream, true);
    }

    function createPeer(id, initiator=false) {

        if (peerConnections[id]) return peerConnections[id];

        const pc = new RTCPeerConnection({
            iceServers: [{ urls: "stun:stun.l.google.com:19302" }]
        });

        peerConnections[id] = pc;

        localStream.getTracks().forEach(t => pc.addTrack(t, localStream));

            pc.ontrack = e => {
        const stream = e.streams[0];
        const video = attachVideo(id, stream);
        detectAudioLevel(stream, video);
    };

        pc.onicecandidate = e => {
            if (e.candidate)
                connection.invoke("SendIceCandidate", id, JSON.stringify(e.candidate));
        };

        if (initiator) {
            pc.createOffer().then(o => {
                pc.setLocalDescription(o);
                connection.invoke("SendOffer", id, JSON.stringify(o));
            });
        }

        return pc;
    }

        function attachVideo(id, stream, isSelf=false) {

        let video = document.getElementById("video-"+id);

        if (!video) {
            video = document.createElement("video");
            video.id = "video-"+id;
            video.autoplay = true;
            video.muted = isSelf;

            if (isSelf) video.classList.add("self");

            document.getElementById("videosContainer").appendChild(video);
        }

        video.srcObject = stream;

        if (!document.getElementById("activeSpeaker").srcObject) {
            setActive(stream, video);
        }
    }
        function detectAudioLevel(stream, videoEl) {

        const ctx = new AudioContext();
        const analyser = ctx.createAnalyser();
        const mic = ctx.createMediaStreamSource(stream);

        mic.connect(analyser);

        const data = new Uint8Array(analyser.frequencyBinCount);

        setInterval(() => {
            analyser.getByteFrequencyData(data);
            const volume = data.reduce((a,b)=>a+b)/data.length;

            if (volume > 35) {
                setActive(stream, videoEl);
            }
        }, 400);
    }
        function setActive(stream, videoEl=null) {

        document.getElementById("activeSpeaker").srcObject = stream;

        document.querySelectorAll("#videosContainer video")
            .forEach(v => v.classList.remove("active"));

        if (videoEl) videoEl.classList.add("active");
    }
    // ================= CONTROLS =================
    function toggleMute() {
        if (!isCounselor && isForceMuted) return;
        localStream.getAudioTracks().forEach(t => t.enabled = !t.enabled);
    }

    function toggleVideo() {
        localStream.getVideoTracks().forEach(t => t.enabled = !t.enabled);
    }

    function shareScreen() {
        navigator.mediaDevices.getDisplayMedia({ video:true })
            .then(screen=>{
                Object.values(peerConnections).forEach(pc=>{
                    const sender = pc.getSenders().find(s=>s.track.kind==="video");
                    if (sender) sender.replaceTrack(screen.getTracks()[0]);
                });
            });
    }

    function raiseHand() {
        connection.invoke("RaiseHand", sessionId);
    }

    function leaveSession() {
        window.location.href = "/";
    }

    // ================= NOTES =================
            let lastSavedValue = "";
    let isSaving = false;
    let debounceTimer = null;

    // INIT
    document.addEventListener("DOMContentLoaded", () => {

        const notesBox = document.getElementById("notesBox");

        // set initial value
        lastSavedValue = notesBox.value;

        // listen for typing
        notesBox.addEventListener("input", () => {
            triggerAutoSave();
        });
    });

    // ================= AUTO SAVE =================

    function triggerAutoSave() {

        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(() => {
            saveNotes();
        }, 1500); // wait 1.5s after typing stops
    }

    // ================= SAVE =================

    function saveNotes(force = false) {

        const notesBox = document.getElementById("notesBox");
        const currentValue = notesBox.value;

        // prevent unnecessary saves
        if (!force && currentValue === lastSavedValue) return;

        // prevent overlapping requests
        if (isSaving) return;

        isSaving = true;
        setState("saving");

        const form = document.getElementById("notesForm");
        const formData = new FormData(form);

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch("?handler=SaveNotes", {
            method: "POST",
            headers: {
                "RequestVerificationToken": token
            },
            body: formData
        })
        .then(async response => {

            if (!response.ok) {
                throw new Error("Server error: " + response.status);
            }

            return response.json();
        })
        .then(res => {

            if (res.success) {

                lastSavedValue = currentValue;
                setState("saved");

                // reset to idle after short delay
                setTimeout(() => setState("idle"), 2000);
            }
            else {
                throw new Error("Save failed");
            }

        })
        .catch(err => {

            console.error(err);
            setState("error");
        })
        .finally(() => {
            isSaving = false;
        });
    }

    // ================= UI STATE =================

    function setState(state) {

        const el = document.getElementById("saveState");

        el.className = "";
        el.classList.add(state);

        switch(state) {
            case "saving":
                el.innerText = "Saving...";
                break;

            case "saved":
                el.innerText = "Saved ✓";
                break;

            case "error":
                el.innerText = "Failed to save";
                break;

            default:
                el.innerText = "Idle";
        }
    }
    // START
    init();


        let isMuted = false;

    function toggleMute() {

        if (!isCounselor && isForceMuted) return;

        isMuted = !isMuted;

        localStream.getAudioTracks().forEach(t => t.enabled = !isMuted);

        const btn = document.getElementById("btnMic");
        btn.classList.toggle("off", isMuted);
    }

        let isCameraOff = false;

    function toggleVideo() {

        isCameraOff = !isCameraOff;

        localStream.getVideoTracks().forEach(t => t.enabled = !isCameraOff);

        const btn = document.getElementById("btnCam");
        btn.classList.toggle("off", isCameraOff);
    }

    let handRaised = false;

function raiseHand() {

    handRaised = !handRaised;

    const btn = document.getElementById("btnHand");
    btn.classList.toggle("hand-raised", handRaised);

    connection.invoke("RaiseHand", sessionId);
}

    function updateParticipantCount() {

        const count = Object.keys(peerConnections).length + 1; // + self
        document.getElementById("participantCount").innerText = count;
    }


        let waitingUsers = new Set();

    connection.on("UserWaiting", (id) => {

        if (!isCounselor) return;

        waitingUsers.add(id);

        renderWaitingList();
    });

        function renderWaitingList() {

        const panel = document.getElementById("waitingPanel");
        const container = document.getElementById("waitingListContainer");
        const count = document.getElementById("waitingCount");

        container.innerHTML = "";

        waitingUsers.forEach(id => {

            const div = document.createElement("div");
            div.className = "waiting-item";

            div.innerHTML = `
                <span>User</span>
                <button class="btn btn-sm btn-success"
                        onclick="admitUser('${id}')">
                    Admit
                </button>
            `;

            container.appendChild(div);
        });

        count.innerText = waitingUsers.size;

        panel.classList.toggle("d-none", waitingUsers.size === 0);
    }

        function admitUser(id) {

        connection.invoke("AdmitUser", sessionId, id);

        waitingUsers.delete(id);

        renderWaitingList();
    }

</script>