@page "{sessionId:int}"
@model CouplesConnect.Pages.Sessions.RoomModel

<link href="~/css/room.css" rel="stylesheet" />

<div class="page-header">
    <h4 class="page-title">Live Session</h4>
</div>

<div class="row">

    <!-- ===================== LEFT SIDE ===================== -->
    <div class="@(Model.IsCounselor ? "col-md-7" : "col-md-12")">

        <!-- TOP BAR -->
        <div class="session-topbar">

            <div class="connection-bar">
                <span class="status-dot" id="statusDot"></span>
                <span id="connectionText">Connecting...</span>
            </div>

            <div class="session-meta">

                <div class="meta-box">
                    <span>Session</span>
                    <strong id="timer">00:00:00</strong>
                </div>

                @if (Model.IsCounselor && Model.NextSessionTime != null)
                {
                    <div class="meta-box">
                        <span>Next</span>
                        <strong id="nextSessionCountdown"
                                data-time="@Model.NextSessionTime.Value.ToString("o")">
                        </strong>
                    </div>
                }

                <div class="meta-box">
                    👥 <span id="participantCount">1</span>
                </div>

            </div>

        </div>

        <!-- WAITING -->
        <div id="waitingScreen" class="waiting-screen d-none">
            <h5>Waiting for therapist to admit you...</h5>
        </div>

        <!-- SESSION -->
        <div id="sessionUI" class="d-none">

            <div class="video-layout">

                <!-- MAIN -->
                <div id="mainStage" class="main-stage">
                    <video id="activeSpeaker" autoplay></video>
                </div>

                <!-- PARTICIPANTS -->
                <div id="videosContainer" class="participants-grid"></div>

            </div>

            <!-- CONTROLS -->
            <div class="controls-bar">

                <button id="btnMic" onclick="toggleMute()" class="control-btn">
                    🎤
                </button>

                <button id="btnCam" onclick="toggleVideo()" class="control-btn">
                    📷
                </button>

                <button id="btnShare"
                        onclick="shareScreen()"
                        class="control-btn">

                    🖥

                </button>

                <button id="btnHand" onclick="raiseHand()" class="control-btn">
                    ✋
                </button>

                

                <button type="button"
                        id="btnLeave"
                        onclick="leaveSession()"
                        class="control-btn danger">
                    ⏹
                </button>

                

            </div>

        </div>

        <!-- FLOATING WAITING LIST -->
        <div id="waitingList" class="waiting-floating"></div>

    </div>

    <!-- ===================== RIGHT SIDE ===================== -->
    @if (Model.IsCounselor)
    {
        <div class="col-md-5">

            <!-- WAITING PANEL -->
            <div class="card mb-3">

                <div id="waitingPanel" class="p-3 d-none">

                    <div class="d-flex justify-content-between mb-2">
                        <strong>Waiting Room</strong>
                        <span id="waitingCount" class="badge cc-badge-warning">0</span>
                    </div>

                    <div id="waitingListContainer"></div>

                </div>

            </div>

            <!-- NOTES -->
            <div class="card">

                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <strong>Session Notes</strong>

                    <button class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#upcomingModal">
                        Upcoming
                    </button>
                </div>

                <form id="notesForm" method="post" class="p-3">

                    @Html.AntiForgeryToken()

                    <textarea id="notesBox"
                              name="Notes"
                              class="form-control mb-2"
                              style="height: 200px;"
                              placeholder="Write session notes...">@Model.ExistingNotes</textarea>

                    <input type="hidden" name="SessionId" value="@Model.SessionId" />

                    <div class="d-flex justify-content-between align-items-center">

                        <small id="saveState" class="text-muted">Idle</small>

                        <button type="button" onclick="saveNotes(true)" class="btn btn-primary btn-sm">
                            Save
                        </button>

                    </div>

                </form>

            </div>

        </div>
    }

</div>

<!-- MODAL -->
<div class="modal fade" id="upcomingModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Upcoming Sessions</h5>
            </div>

            <div class="modal-body">

                @if (Model.UpcomingSessions.Any())
                {
                    <ul class="list-group">

                        @foreach (var s in Model.UpcomingSessions)
                        {
                            <li class="list-group-item d-flex justify-content-between">

                                <div>
                                    <strong>@s.ScheduledStart.ToString("HH:mm")</strong><br />
                                    <small>@s.User?.FullName</small>
                                </div>

                                <span class="badge cc-badge-primary">
                                    @{
                                        var diff = s.ScheduledStart - DateTime.UtcNow;
                                        if (diff.TotalMinutes <= 0)
                                        {
                                            @:Now
                                        }
                                        else
                                        {
                                            @($"{(int)diff.TotalHours}h {diff.Minutes}m")
                                        }
                                    }
                                </span>

                            </li>
                        }

                    </ul>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        No upcoming sessions
                    </div>
                }

            </div>

        </div>
    </div>
</div>

<style>

    /* TOP BAR */
    .session-topbar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    /* META */
    .meta-box {
        background: #f9fafb;
        padding: 6px 10px;
        border-radius: 8px;
        text-align: center;
    }

    /* WAITING */
    .waiting-screen {
        text-align: center;
        margin-top: 40px;
    }

    /* VIDEO */
    .video-layout {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .main-stage {
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        height: 350px;
    }

        .main-stage video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* PARTICIPANTS */
    .participants-grid {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* CONTROLS */
    .controls-bar {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 15px;
    }

    .control-btn {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        border: none;
        background: #f3f4f6;
    }

        .control-btn.danger {
            background: #ef4444;
            color: white;
        }

    /* BADGES */
    .cc-badge-primary {
        background: #eef2ff;
        color: #4338ca;
    }

    .cc-badge-warning {
        background: #fef3c7;
        color: #92400e;
    }

</style>

<script>
    window.roomConfig = {
        sessionId: @Model.SessionId,
        isCounselor: @(Model.IsCounselor.ToString().ToLower()),
        returnUrl: "@(Model.IsCounselor ? "/Counselor/Sessions" : "User/Bookings")",
        iceServers: @Html.Raw(Model.IceServersJson),
        hasTurnServer: @(Model.HasTurnServer.ToString().ToLower())
    };
</script>

<script src="~/lib/microsoft-signalr/signalr.min.js"></script>

<script type="module" src="~/js/room/room.js"></script>
