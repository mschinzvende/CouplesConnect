@page
@model CouplesConnect.Pages.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Couples Connect</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/@@mdi/font/css/materialdesignicons.min.css" rel="stylesheet">

    <style>

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            background: #f9fafb;
        }

        /* NAVBAR */
        .navbar {
            padding: 15px 40px;
        }

        .navbar-brand {
            font-weight: 600;
            color: #4f46e5 !important;
        }

        /* HERO */
        .hero {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            padding: 100px 0;
        }

            .hero h1 {
                font-size: 48px;
                font-weight: 600;
            }

            .hero img {
                border-radius: 16px;
                box-shadow: 0 25px 50px rgba(0,0,0,0.25);
            }

        /* FEATURE CARD */
        .feature-card {
            padding: 25px;
            border-radius: 14px;
            background: #fff;
            transition: 0.2s;
            height: 100%;
        }

            .feature-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            }

        .feature-icon {
            font-size: 30px;
            color: #4f46e5;
        }

        /* STEP */
        .step-number {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #4f46e5;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        /* TESTIMONIAL */
        .testimonial-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            height: 100%;
        }

        /* CTA */
        .cta {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            padding: 80px 0;
            color: white;
        }

        /* FOOTER */
        .footer {
            background: #111827;
            color: #9ca3af;
            padding: 40px 0;
        }

            .footer a {
                color: #d1d5db;
                text-decoration: none;
            }

                .footer a:hover {
                    color: #fff;
                }

    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Couples Connect</a>

            <div>
                <a href="/signin" class="btn btn-light me-2">Sign In</a>
                <a href="/signup" class="btn btn-primary">Get Started</a>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-6">
                    <h1>Stronger Relationships Start Here</h1>

                    <p class="lead mt-3">
                        Improve communication, resolve challenges,
                        and grow together with guided conversations
                        and professional counseling.
                    </p>

                    <div class="mt-4">
                        <a href="/signup" class="btn btn-light btn-lg me-2">Get Started</a>
                        <a href="/signin" class="btn btn-outline-light btn-lg">Sign In</a>
                    </div>
                </div>

                <div class="col-lg-6 text-center">
                    <img src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2"
                         class="img-fluid" />
                </div>

            </div>
        </div>
    </section>

    <!-- FEATURES -->
    <section class="py-5">
        <div class="container text-center">

            <h3 class="fw-bold mb-5">Everything You Need</h3>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="feature-card">
                        <i class="mdi mdi-chat-processing feature-icon"></i>
                        <h5 class="fw-bold mt-3">Guided Conversations</h5>
                        <p class="text-muted">Structured communication tools.</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card">
                        <i class="mdi mdi-account-heart feature-icon"></i>
                        <h5 class="fw-bold mt-3">Counseling</h5>
                        <p class="text-muted">Connect with professionals.</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card">
                        <i class="mdi mdi-book-open-variant feature-icon"></i>
                        <h5 class="fw-bold mt-3">Reflection Tools</h5>
                        <p class="text-muted">Track growth and emotions.</p>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="py-5 bg-light">
        <div class="container text-center">

            <h3 class="fw-bold mb-5">How It Works</h3>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="step-number">1</div>
                    <h5>Create Account</h5>
                </div>

                <div class="col-md-4">
                    <div class="step-number">2</div>
                    <h5>Choose a Service</h5>
                </div>

                <div class="col-md-4">
                    <div class="step-number">3</div>
                    <h5>Grow Together</h5>
                </div>

            </div>

        </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="py-5">
        <div class="container text-center">

            <h3 class="fw-bold mb-5">What Couples Are Saying</h3>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="testimonial-card">
                        <p>"This platform helped us communicate better than ever."</p>
                        <small class="text-muted">— Anonymous Couple</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="testimonial-card">
                        <p>"The guided sessions changed how we resolve conflict."</p>
                        <small class="text-muted">— Anonymous Couple</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="testimonial-card">
                        <p>"Simple, effective, and really meaningful."</p>
                        <small class="text-muted">— Anonymous Couple</small>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- CTA -->
    <section class="cta text-center">
        <div class="container">
            <h2 class="fw-bold">Start Your Journey Today</h2>
            <p class="mt-3">Build stronger communication and connection.</p>
            <a href="/signup" class="btn btn-light btn-lg mt-3">Create Your Account</a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">

            <div class="row">

                <div class="col-md-4">
                    <h5 class="text-white">Couples Connect</h5>
                    <p class="small">
                        Helping couples build stronger, healthier relationships
                        through communication and support.
                    </p>
                </div>

                <div class="col-md-4">
                    <h6 class="text-white">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/signup">Get Started</a></li>
                        <li><a href="/signin">Sign In</a></li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h6 class="text-white">Contact</h6>
                    <p class="small">support@couplesconnect.com</p>
                </div>

            </div>

            <hr class="border-secondary" />

            <div class="text-center small">
                © @DateTime.Now.Year Couples Connect. All rights reserved.
            </div>

        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>