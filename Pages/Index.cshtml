@page
@model CouplesConnect.Pages.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Couples Connect | Relationship support that meets you where you are";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Couples Connect offers a thoughtful space for counselling, guided conversations, and relationship support." />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@mdi/font/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    <div class="landing-page">
        <header class="landing-nav">
            <div class="landing-container landing-nav-inner">
                <a class="landing-brand-logo" href="#top" aria-label="Couples Connect home">
                    <img src="~/theme/images/logo.svg" alt="Couples Connect" />
                </a>

                <nav class="landing-nav-links" aria-label="Main navigation">
                    <a href="#support">How we help</a>
                    <a href="#faqs">FAQs</a>
                    <a href="#contact">Contact</a>
                </nav>

                <div class="landing-nav-actions">
                    <a href="/signin" class="landing-sign-in">Sign in</a>
                    <a href="/signup" class="btn landing-button landing-button-primary">Get started <i class="mdi mdi-arrow-right"></i></a>
                </div>
            </div>
        </header>

        <main id="top">
            <section class="landing-hero">
                <div class="landing-orb landing-orb-one"></div>
                <div class="landing-orb landing-orb-two"></div>
                <div class="landing-container landing-hero-grid">
                    <div class="landing-hero-copy">
                        <div class="landing-eyebrow"><span></span> Relationship support, made more human</div>
                        <h1>A stronger <em>“us”</em> starts with a safe place to talk.</h1>
                        <p class="landing-hero-lead">Build connection, work through challenges, and make room for meaningful conversations—with professional support and practical tools designed for your relationship.</p>
                        <div class="landing-hero-actions">
                            <a href="/signup" class="btn landing-button landing-button-primary landing-button-large">Create your account <i class="mdi mdi-arrow-right"></i></a>
                            <a href="#support" class="landing-text-action">Explore support <i class="mdi mdi-arrow-down"></i></a>
                        </div>
                        <div class="landing-trust-row">
                            <span><i class="mdi mdi-lock-check-outline"></i> Private by design</span>
                            <span><i class="mdi mdi-heart-pulse"></i> Built for every stage</span>
                        </div>
                    </div>

                    <div class="landing-hero-visual">
                        <div class="landing-photo-frame">
                            <img src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="A couple sharing a relaxed moment together" />
                        </div>
                        <aside class="landing-visual-note landing-visual-note-top">
                            <span class="landing-note-icon"><i class="mdi mdi-message-heart-outline"></i></span>
                            <div><strong>Make space to listen</strong><small>One conversation at a time</small></div>
                        </aside>
                        <aside class="landing-visual-note landing-visual-note-bottom">
                            <div class="landing-avatars" aria-hidden="true"><span>J</span><span>M</span></div>
                            <div><strong>Grow together</strong><small>Guidance for both of you</small></div>
                        </aside>
                    </div>
                </div>
            </section>

            <section class="landing-intro" aria-label="Couples Connect approach">
                <div class="landing-container landing-intro-grid">
                    <p class="landing-section-label">A calm place to begin</p>
                    <p class="landing-intro-copy">Whether you are preparing for commitment, navigating a difficult season, or protecting a relationship that matters, Couples Connect gives you a clear next step.</p>
                    <a href="#contact" class="landing-intro-link">Talk to our team <i class="mdi mdi-arrow-up-right"></i></a>
                </div>
            </section>

            <section class="landing-section landing-support-section" id="support">
                <div class="landing-container">
                    <div class="landing-section-heading landing-section-heading-wide">
                        <div>
                            <p class="landing-section-label">How we help</p>
                            <h2>Support that meets your relationship where it is.</h2>
                        </div>
                        <p>Simple entry points, thoughtful guidance, and a private platform that helps you keep moving forward together.</p>
                    </div>

                    <div class="landing-support-grid">
                        <article class="landing-support-card landing-support-card-featured">
                            <span class="landing-card-icon"><i class="mdi mdi-calendar-heart"></i></span>
                            <div>
                                <p class="landing-card-kicker">Counselling &amp; bookings</p>
                                <h3>Find time for the conversations that matter.</h3>
                                <p>Choose a service, book a time that works for you, and receive professional relationship support with clarity and care.</p>
                            </div>
                            <a href="/signup" class="landing-card-link">Begin with a booking <i class="mdi mdi-arrow-right"></i></a>
                        </article>

                        <article class="landing-support-card">
                            <span class="landing-card-icon landing-card-icon-peach"><i class="mdi mdi-forum-outline"></i></span>
                            <p class="landing-card-kicker">Guided connection</p>
                            <h3>Turn difficult moments into better conversations.</h3>
                            <p>Use guided conversations and reflection tools to understand each other, communicate more clearly, and build everyday closeness.</p>
                        </article>

                        <article class="landing-support-card">
                            <span class="landing-card-icon landing-card-icon-mint"><i class="mdi mdi-incognito-circle"></i></span>
                            <p class="landing-card-kicker">Blind Reflection Room</p>
                            <h3>Reflect openly, without sharing your identity.</h3>
                            <p>Connect through anonymous, guided reflection conversations designed to give perspective while protecting your personal identity.</p>
                        </article>
                    </div>
                </div>
            </section>

            <section class="landing-section landing-steps-section">
                <div class="landing-container landing-steps-layout">
                    <div class="landing-steps-copy">
                        <p class="landing-section-label">How it works</p>
                        <h2>A clear path forward—without pressure.</h2>
                        <p>Start in the way that feels right for you. Your account gives you a private home for bookings, reflection, resources, and support.</p>
                        <a href="/signup" class="btn landing-button landing-button-dark">Start your journey <i class="mdi mdi-arrow-right"></i></a>
                    </div>
                    <ol class="landing-steps-list">
                        <li><span>01</span><div><h3>Create your private account</h3><p>Set up a secure space for your relationship support.</p></div></li>
                        <li><span>02</span><div><h3>Choose the support you need</h3><p>Explore counselling, guided tools, and reflective resources.</p></div></li>
                        <li><span>03</span><div><h3>Keep building together</h3><p>Return to your shared progress whenever you need it.</p></div></li>
                    </ol>
                </div>
            </section>

            <section class="landing-section landing-faq-section" id="faqs">
                <div class="landing-container">
                    <div class="landing-section-heading landing-faq-heading">
                        <div>
                            <p class="landing-section-label">Frequently asked questions</p>
                            <h2>Answers before you begin.</h2>
                        </div>
                        <p>Still unsure? Our team is here to help you choose a comfortable next step.</p>
                    </div>

                    <div class="landing-faq-layout">
                        <div class="landing-faq-category-card">
                            <span class="landing-card-icon"><i class="mdi mdi-help-circle-outline"></i></span>
                            <h3>New to Couples Connect?</h3>
                            <p>These are the things people most often want to know before creating an account or booking a session.</p>
                            <a href="#contact" class="landing-card-link">Ask a question <i class="mdi mdi-arrow-right"></i></a>
                        </div>

                        <div class="landing-faq-list">
                            <details class="landing-faq-item" open>
                                <summary>How do I book a counselling session?<i class="mdi mdi-plus"></i></summary>
                                <p>Visit the Services area after creating an account, then choose a service and a time slot that suits you.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>What if I need to cancel or reschedule?<i class="mdi mdi-plus"></i></summary>
                                <p>You can cancel or reschedule up to 24 hours before your session without fees, through your account dashboard or by contacting us.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>Are sessions confidential?<i class="mdi mdi-plus"></i></summary>
                                <p>Yes. Counsellors follow strict professional ethics and privacy guidelines, and we design the platform to protect your personal information.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>How does the Blind Reflection Room work?<i class="mdi mdi-plus"></i></summary>
                                <p>It enables anonymous, guided conversations outside your usual circle, helping you reflect on relationship experiences while keeping identifying information private from other participants.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>What payment methods do you accept?<i class="mdi mdi-plus"></i></summary>
                                <p>We accept major credit cards, PayPal, and bank transfers. Payments are processed securely, and you will receive a receipt by email.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>Do you offer refunds?<i class="mdi mdi-plus"></i></summary>
                                <p>We offer a satisfaction guarantee. If you are not satisfied with your first session, contact us within 48 hours for a full refund.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>How many sessions do we need?<i class="mdi mdi-plus"></i></summary>
                                <p>Many couples benefit from four to six sessions, but the programme can be tailored to your needs and timeline.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>When should we start pre-marital counselling?<i class="mdi mdi-plus"></i></summary>
                                <p>Ideally, start three to six months before your wedding so you have time to work through important topics without last-minute pressure.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>Is counselling valuable if we already live together?<i class="mdi mdi-plus"></i></summary>
                                <p>Yes. Marriage can bring new dynamics and commitments that are valuable to explore, regardless of your current living situation.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>How long should we be dating before starting counselling?<i class="mdi mdi-plus"></i></summary>
                                <p>There is no required timeline. Whether you have been together for months or years, support can help you build strong foundations and navigate challenges.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>What if we disagree on major life goals?<i class="mdi mdi-plus"></i></summary>
                                <p>Sessions can help you explore those differences, understand possible compromises, and decide what they mean for your shared future.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>Is it normal to have doubts while dating?<i class="mdi mdi-plus"></i></summary>
                                <p>Absolutely. Guided conversations can help you distinguish healthy questions from concerns that need more careful attention.</p>
                            </details>
                            <details class="landing-faq-item">
                                <summary>How do we know if we are ready for the next step?<i class="mdi mdi-plus"></i></summary>
                                <p>Guided conversations and assessments help you consider compatibility, communication patterns, and your shared vision for the future.</p>
                            </details>
                        </div>
                    </div>
                </div>
            </section>

            <section class="landing-section landing-contact-section" id="contact">
                <div class="landing-container landing-contact-grid">
                    <div class="landing-contact-copy">
                        <p class="landing-section-label">Get in touch</p>
                        <h2>We are here when you need a little direction.</h2>
                        <p>Ask about getting started, bookings, privacy, or the support that may be right for your relationship. Share only what you are comfortable sharing.</p>

                        <div class="landing-contact-options">
                            <a href="mailto:support@couplesconnect.com"><span><i class="mdi mdi-email-outline"></i></span><div><small>General support</small><strong>support@couplesconnect.com</strong></div></a>
                            <a href="mailto:privacy@couplesconnect.com"><span><i class="mdi mdi-shield-account-outline"></i></span><div><small>Privacy questions</small><strong>privacy@couplesconnect.com</strong></div></a>
                        </div>
                    </div>

                    <div class="landing-contact-form-card">
                        @if (TempData["ContactSuccess"] is string successMessage)
                        {
                            <div class="landing-form-alert landing-form-alert-success" role="status"><i class="mdi mdi-check-circle-outline"></i> @successMessage</div>
                        }
                        <form method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="landing-validation-summary" role="alert"></div>
                            <input asp-for="Contact.Website" class="landing-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Contact.FullName">Your name</label>
                                    <input asp-for="Contact.FullName" class="form-control" autocomplete="name" placeholder="Your name" />
                                    <span asp-validation-for="Contact.FullName"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Contact.Email">Email address</label>
                                    <input asp-for="Contact.Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                                    <span asp-validation-for="Contact.Email"></span>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label asp-for="Contact.Subject">What can we help with?</label>
                                <select asp-for="Contact.Subject" class="form-select">
                                    <option value="">Choose a topic</option>
                                    <option>Getting started</option>
                                    <option>Booking or rescheduling</option>
                                    <option>Counselling services</option>
                                    <option>Blind Reflection Room</option>
                                    <option>Privacy question</option>
                                    <option>Something else</option>
                                </select>
                                <span asp-validation-for="Contact.Subject"></span>
                            </div>
                            <div class="mt-3">
                                <label asp-for="Contact.Message">Your message</label>
                                <textarea asp-for="Contact.Message" class="form-control" rows="5" placeholder="Tell us how we can help. Please do not include highly sensitive personal or clinical details here."></textarea>
                                <span asp-validation-for="Contact.Message"></span>
                            </div>
                            <div class="form-check landing-privacy-check mt-3">
                                <input asp-for="Contact.PrivacyAccepted" class="form-check-input" />
                                <label asp-for="Contact.PrivacyAccepted" class="form-check-label">I have read the <a href="/Privacy">Privacy Policy</a> and consent to Couples Connect using these details to respond to my enquiry.</label>
                                <span asp-validation-for="Contact.PrivacyAccepted"></span>
                            </div>
                            <button type="submit" class="btn landing-button landing-button-primary landing-contact-submit">Send message <i class="mdi mdi-send-outline"></i></button>
                        </form>
                    </div>
                </div>
            </section>

            <section class="landing-cta">
                <div class="landing-container landing-cta-inner">
                    <div><p class="landing-section-label">A better next conversation</p><h2>Make room for the relationship you want to build.</h2></div>
                    <a href="/signup" class="btn landing-button landing-button-light">Create your account <i class="mdi mdi-arrow-right"></i></a>
                </div>
            </section>
        </main>

        <footer class="landing-footer">
            <div class="landing-container landing-footer-inner">
                <div><a class="landing-brand-logo" href="#top"><img src="~/theme/images/logo.svg" alt="Couples Connect" /></a><p>Relationship support with care, clarity, and room to grow.</p></div>
                <div class="landing-footer-links"><a href="#support">How we help</a><a href="#faqs">FAQs</a><a href="#contact">Contact us</a><a href="/Privacy">Privacy Policy</a></div>
                <p class="landing-copyright">© @DateTime.UtcNow.Year Couples Connect</p>
            </div>
        </footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
