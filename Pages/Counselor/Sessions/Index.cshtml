@page
@model CouplesConnect.Pages.Counselor.Sessions.IndexModel

<h3 class="fw-bold mb-3">My Sessions</h3>

<form method="get" class="row g-3 mb-3 align-items-end">
    <div class="col-md-6">
        <label class="form-label fw-semibold">Search</label>
        <input type="text" name="Search" value="@Model.Search"
               class="form-control cc-input"
               placeholder="Search participant..." />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Status</label>
        <select name="StatusFilter" class="form-select cc-input">
            <option value="all">All</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Ready">Ready</option>
            <option value="Live">Live</option>
            <option value="Completed">Completed</option>
        </select>
    </div>

    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100 cc-btn">Apply</button>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">

    @foreach (var s in Model.Sessions)
    {
        var state = Model.GetSessionState(s);
        var mainBooking = s.Bookings.First();

        <div class="col-md-6 col-lg-4">
            <div class="card session-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-2">
                        <div>
                            <div class="fw-semibold">
                                @mainBooking.ScheduledStart.ToString("ddd, dd MMM")
                            </div>
                            <div class="text-muted small">
                                @mainBooking.ScheduledStart.ToString("hh:mm tt")
                            </div>
                        </div>

                        <span class="badge session-badge @state.ToLower()">
                            @state
                        </span>
                    </div>

                    <hr />

                    @if (mainBooking.IsGroup)
                    {
                        <span class="badge cc-group mb-2">Group Session</span>
                    }

                    <div class="mb-2">
                        <strong>Participants:</strong>
                        <ul class="small mb-0">
                            <li>@mainBooking.User.FullName (Host)</li>

                            @foreach (var p in mainBooking.Participants.Where(x => x.Status == "Accepted"))
                            {
                                if (p.User != null)
                                {
                                    <li>@p.User.FullName</li>
                                }
                            }
                        </ul>
                    </div>

                    @if (state == "Upcoming" || state == "Ready")
                    {
                        <div class="text-muted small mb-2">
                            Starts in
                            <span class="countdown"
                                  data-time="@mainBooking.ScheduledStart.ToString("o")">
                            </span>
                        </div>
                    }

                    <div class="d-flex flex-column gap-2 mt-2">

                        @if (!s.IsStarted && !s.IsEnded)
                        {
                            <form method="post" asp-page-handler="Start" asp-route-id="@s.SessionId">
                                <button class="btn btn-primary btn-sm w-100">Start Session</button>
                            </form>
                        }
                        else if (s.IsStarted && !s.IsEnded)
                        {
                            <a href="/Sessions/PreJoin/@s.SessionId"
                               class="btn btn-primary btn-sm w-100">
                                Enter Session Room
                            </a>
                        }

                        <!-- 🔥 NOTES BUTTON (NOW MODAL) -->
                        <button class="btn cc-btn-outline btn-sm w-100"
                                onclick="openNotes(@s.SessionId)">
                            View Notes
                        </button>

                        @if (!s.IsEnded)
                        {
                            <form method="post" asp-page-handler="Complete" asp-route-id="@s.SessionId">
                                <button class="btn cc-btn-outline btn-sm w-100">
                                    End Session
                                </button>
                            </form>
                        }

                    </div>

                </div>

            </div>
        </div>
    }

</div>

<!-- ================= NOTES MODAL ================= -->
<div class="modal fade" id="notesModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Session Notes</h5>
            </div>
            <form method="post">
            <div class="modal-body">
                
                    @Html.AntiForgeryToken()
                
                <textarea id="notesBox"
                          class="form-control"
                          style="height:200px;"></textarea>

                <input type="hidden" id="notesSessionId" />

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary w-100" onclick="saveNotes()">
                    Save Notes
                </button>
            </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= STYLES ================= -->
<style>
    .cc-input {
        height: 42px;
        font-size: 14px;
    }

    .cc-btn {
        height: 42px;
    }

    .session-card {
        border-radius: 12px;
        transition: 0.2s;
    }

        .session-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    .session-badge.scheduled {
        background: #eef2ff;
        color: #4338ca;
    }

    .session-badge.ready {
        background: #fef3c7;
        color: #92400e;
    }

    .session-badge.live {
        background: #dcfce7;
        color: #166534;
    }

    .session-badge.completed {
        background: #e5e7eb;
        color: #374151;
    }

    .cc-group {
        background: #eef2ff;
        color: #4f46e5;
    }
</style>

<!-- ================= SCRIPTS ================= -->

<script>

    // OPEN NOTES
    function openNotes(sessionId) {

        document.getElementById("notesSessionId").value = sessionId;

        fetch(`?handler=Notes&sessionId=${sessionId}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById("notesBox").value = data.notes || "";
                new bootstrap.Modal(document.getElementById('notesModal')).show();
            });
    }

    // SAVE NOTES
            function saveNotes() {

        const sessionId = document.getElementById("notesSessionId").value;
        const notes = document.getElementById("notesBox").value;

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch(`?handler=SaveNotes`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({
                sessionId: sessionId,
                notes: notes
            })
        })
        .then(res => {
            if (!res.ok) throw new Error();
            return res.json();
        })
        .then(() => {

            // 🔥 REDIRECT TO TRIGGER TEMPDATA
           window.location.href = window.location.pathname;

        })
        .catch(() => {
            window.location.href = window.location.pathname; // still reload to show error TempData
        });
    }

</script>
<script>

    

    // COUNTDOWN
    function updateCountdowns() {
        document.querySelectorAll('.countdown').forEach(el => {

            const time = new Date(el.dataset.time);
            const now = new Date();

            let diff = time - now;

            if (diff <= 0) {
                el.innerText = "Starting...";
                return;
            }

            const seconds = Math.floor(diff / 1000) % 60;
            const minutes = Math.floor(diff / (1000 * 60)) % 60;
            const hours = Math.floor(diff / (1000 * 60 * 60));

            el.innerText = `${hours}h ${minutes}m ${seconds}s`;
        });
    }

    setInterval(updateCountdowns, 1000);
    updateCountdowns();

</script>