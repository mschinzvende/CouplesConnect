@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.Admin.Reports.IndexModel
@attribute [Authorize(Roles = "Admin")]

<h3>Reports</h3>

<div class="row">

    <div class="col-md-3">
        <div class="card p-3">
            Total Users: @Model.TotalUsers
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Total Sessions: @Model.TotalSessions
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Revenue: $@Model.TotalRevenue
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Counselor Earnings: $@Model.TotalEarnings
        </div>
    </div>

</div>