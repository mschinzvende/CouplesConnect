@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.Admin.Services.CreateModel
@attribute [Authorize(Roles="Admin")]

@{
ViewData["Title"] = "Create Service";
}

<h3 class="mb-4">Create Service</h3>

<div class="card shadow-sm">

<div class="card-body">

<form method="post">

<div class="mb-3">

<label>Name</label>

<input asp-for="Service.Name"
class="form-control" />

</div>

<div class="mb-3">

<label>Description</label>

<textarea asp-for="Service.Description"
class="form-control"></textarea>

</div>

<div class="mb-3">

<label>Duration (Minutes)</label>

<input asp-for="Service.DurationMinutes"
class="form-control" />

</div>

<div class="mb-3">

<label>Price</label>

<input asp-for="Service.BasePrice"
class="form-control" />

</div>

<div class="form-check mb-3">

<input asp-for="Service.IsActive"
class="form-check-input"/>

<label class="form-check-label">

Active Service

</label>

</div>

<button class="btn btn-primary">

Create Service

</button>

</form>

</div>

</div>
