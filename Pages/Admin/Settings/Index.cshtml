@page
@model CouplesConnect.Pages.Admin.Settings.IndexModel

@{
    ViewData["Title"] = "Platform Settings";
}

<div class="row">

    <div class="col-lg-3">

        <div class="card">

            <div class="card-body">

                <h4 class="card-title mb-4">
                    <i class="icon-settings"></i>
                    Settings
                </h4>

                <div class="list-group" id="settings-tabs" role="tablist">

                    <a class="list-group-item list-group-item-action active"
                       data-bs-toggle="list"
                       href="#general">
                        <i class="icon-home me-2"></i>
                        General
                    </a>

                    <a class="list-group-item list-group-item-action"
                       data-bs-toggle="list"
                       href="#whatsapp">
                        <i class="icon-bubble me-2"></i>
                        WhatsApp
                    </a>

                    <a class="list-group-item list-group-item-action"
                       data-bs-toggle="list"
                       href="#email">
                        <i class="icon-envelope me-2"></i>
                        Email
                    </a>

                    <a class="list-group-item list-group-item-action"
                       data-bs-toggle="list"
                       href="#subscription">
                        <i class="icon-star me-2"></i>
                        Subscription
                    </a>

                    <a class="list-group-item list-group-item-action"
                       data-bs-toggle="list"
                       href="#payments">
                        <i class="icon-credit-card me-2"></i>
                        Payments
                    </a>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-9">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">

                @TempData["Error"]

            </div>
        }

        <form method="post">

            <input asp-for="Settings.Id" type="hidden" />

            <div class="tab-content">

                <!-- GENERAL -->

                <div class="tab-pane fade show active"
                     id="general">

                    <div class="card">

                        <div class="card-header">

                            <h4>General Settings</h4>

                        </div>

                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-6 mb-3">

                                    <label asp-for="Settings.CompanyName"></label>

                                    <input asp-for="Settings.CompanyName"
                                           class="form-control" />

                                </div>

                                <div class="col-md-6 mb-3">

                                    <label asp-for="Settings.CompanyEmail"></label>

                                    <input asp-for="Settings.CompanyEmail"
                                           class="form-control" />

                                </div>

                                <div class="col-md-6 mb-3">

                                    <label asp-for="Settings.CompanyPhone"></label>

                                    <input asp-for="Settings.CompanyPhone"
                                           class="form-control" />

                                </div>

                                <div class="col-md-3 mb-3">

                                    <label asp-for="Settings.Currency"></label>

                                    <input asp-for="Settings.Currency"
                                           class="form-control" />

                                </div>

                                <div class="col-md-3 mb-3">

                                    <label asp-for="Settings.TimeZone"></label>

                                    <input asp-for="Settings.TimeZone"
                                           class="form-control" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- WHATSAPP -->

                <div class="tab-pane fade"
                     id="whatsapp">

                    <div class="card">

                        <div class="card-header">

                            <h4>

                                WhatsApp Cloud API

                            </h4>

                        </div>

                        <div class="card-body">

                            <div class="mb-3">

                                <label asp-for="Settings.BaseUrl">Base URL</label>

                                <input asp-for="Settings.BaseUrl"
                                       class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label asp-for="Settings.WhatsAppApiUrl">API URL</label>

                                <input asp-for="Settings.WhatsAppApiUrl"
                                       class="form-control" />

                            </div>

                            <div class="mb-3">

                                <label asp-for="Settings.WhatsAppAccessToken">Access Token</label>

                                <div class="input-group">

                                    <input asp-for="Settings.WhatsAppAccessToken"
                                           id="token"
                                           type="password"
                                           class="form-control" />

                                    <span class="input-group-text text-muted small">Leave blank to keep current</span>

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            onclick="togglePassword('token')">

                                        Show

                                    </button>

                                </div>

                            </div>

                            <div class="row">

                                <div class="col-md-6">

                                    <label asp-for="Settings.WhatsAppPhoneNumberId">Phone Number ID</label>

                                    <input asp-for="Settings.WhatsAppPhoneNumberId"
                                           class="form-control" />

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="Settings.WhatsAppBusinessAccountId">Business Account ID</label>

                                    <input asp-for="Settings.WhatsAppBusinessAccountId"
                                           class="form-control" />

                                </div>

                            </div>

                            <div class="mt-3">

                                <label asp-for="Settings.WhatsAppVerifyToken">Webhook Verify Token</label>

                                <input asp-for="Settings.WhatsAppVerifyToken"
                                       class="form-control" />

                            </div>

                            <button class="btn btn-info mt-4"
                                    asp-page-handler="TestWhatsApp">

                                Test Connection

                            </button>

                        </div>

                    </div>

                </div>

                <!-- EMAIL -->

                <div class="tab-pane fade"
                     id="email">

                    <div class="card">

                        <div class="card-header">

                            <h4>Email Settings</h4>

                        </div>

                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-6 mb-3">

                                    <label asp-for="Settings.SmtpServer">SMTP Server</label>

                                    <input asp-for="Settings.SmtpServer"
                                           class="form-control" />

                                </div>

                                <div class="col-md-2 mb-3">

                                    <label asp-for="Settings.SmtpPort">Port</label>

                                    <input asp-for="Settings.SmtpPort"
                                           class="form-control" />

                                </div>

                                <div class="col-md-4 mb-3">

                                    <label asp-for="Settings.SmtpUsername">Username</label>

                                    <input asp-for="Settings.SmtpUsername"
                                           class="form-control" />

                                </div>

                                <div class="col-md-6 mb-3">

                                    <label asp-for="Settings.SmtpPassword">Password</label>

                                    <div class="input-group">

                                        <input asp-for="Settings.SmtpPassword"
                                               id="smtpPassword"
                                               type="password"
                                               class="form-control" />

                                        <span class="input-group-text text-muted small">Leave blank to keep current</span>

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                onclick="togglePassword('smtpPassword')">

                                            Show

                                        </button>

                                    </div>

                                </div>

                                <div class="col-md-3 mt-4">

                                    <div class="form-check">

                                        <input asp-for="Settings.EnableSSL"
                                               class="form-check-input" />

                                        <label asp-for="Settings.EnableSSL"
                                               class="form-check-label">

                                            Enable SSL

                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- SUBSCRIPTION -->

                <div class="tab-pane fade"
                     id="subscription">

                    <div class="card">

                        <div class="card-header">

                            <h4>Subscription Settings</h4>

                        </div>

                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-4">

                                    <label asp-for="Settings.TrialSessions">Trial Sessions</label>

                                    <input asp-for="Settings.TrialSessions"
                                           class="form-control" />

                                </div>

                                <div class="col-md-4">

                                    <label asp-for="Settings.TrialDurationDays">Trial Days</label>

                                    <input asp-for="Settings.TrialDurationDays"
                                           class="form-control" />

                                </div>

                                <div class="col-md-4">

                                    <label asp-for="Settings.CounselorCommissionPercent">Counsellor Commission %</label>

                                    <input asp-for="Settings.CounselorCommissionPercent"
                                           class="form-control" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- PAYMENTS -->

                <div class="tab-pane fade"
                     id="payments">

                    <div class="card">

                        <div class="card-header">

                            <h4>Smile &amp; Pay Gateway</h4>

                        </div>

                        <div class="card-body">

                            <div class="alert alert-light border mb-4">
                                <strong>Quick setup:</strong>
                                Enter the merchant API credentials supplied by ZB, use Sandbox while testing,
                                and register the callback URL below. Change to the Live URL only after approval.
                            </div>

                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label asp-for="Settings.SmileAndPayBaseUrl">Gateway Base URL</label>
                                    <input asp-for="Settings.SmileAndPayBaseUrl" class="form-control" />
                                    <div class="form-text">
                                        Sandbox: https://zbnet.zb.co.zw/wallet_sandbox_api/payments-gateway<br />
                                        Live: https://zbnet.zb.co.zw/wallet_gateway/payments-gateway
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Settings.SmileAndPayCurrencyCode">Currency</label>
                                    <select asp-for="Settings.SmileAndPayCurrencyCode" class="form-select">
                                        <option value="840">USD (840)</option>
                                        <option value="924">ZWG (924)</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Settings.SmileAndPayApiKey">API Key</label>
                                    <input asp-for="Settings.SmileAndPayApiKey" type="password"
                                           class="form-control" autocomplete="new-password" />
                                    <div class="form-text">Leave blank to keep the current key.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Settings.SmileAndPayApiSecret">API Secret</label>
                                    <input asp-for="Settings.SmileAndPayApiSecret" type="password"
                                           class="form-control" autocomplete="new-password" />
                                    <div class="form-text">Encrypted at rest. Leave blank to keep the current secret.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Settings.SmileAndPayCheckoutHost">Allowed Checkout Host</label>
                                    <input asp-for="Settings.SmileAndPayCheckoutHost" class="form-control" />
                                    <div class="form-text">Normally zbnet.zb.co.zw.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="smileAndPayCallbackUrl">Payment Callback URL</label>
                                    <input id="smileAndPayCallbackUrl" value="@($"{Request.Scheme}://{Request.Host}{Request.PathBase}/Payments/SmileAndPayWebhook")"
                                           class="form-control" readonly />
                                    <div class="form-text">This must be a publicly reachable HTTPS URL.</div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="card mt-4">

                <div class="card-body text-end">

                    <button class="btn btn-success btn-lg">

                        <i class="icon-check"></i>

                        Save Settings

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <script>

        function togglePassword(id){

            var input=document.getElementById(id);

            if(input.type==="password")
                input.type="text";
            else
                input.type="password";

        }

    </script>

}
