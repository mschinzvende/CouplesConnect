@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.Admin.Counselors.IndexModel
@attribute [Authorize(Roles = "Admin")]

<div class="container-fluid py-3">

    <h4 class="fw-bold mb-3">Counselor Applications</h4>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card cc-card">

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Experience</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var c in Model.Counselors)
                    {
                        <tr>

                            <td>
                                <div class="fw-semibold">@c.FullName</div>
                                <div class="small text-muted">@c.User.Email</div>
                            </td>

                            <td>@c.YearsOfExperience years</td>

                            <td>
                                @if (c.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>

                            <td class="text-end">

                                <!-- VIEW -->
                                <button class="btn cc-btn-soft btn-sm me-1"
                                        onclick="openView('@c.UserId')">
                                    View
                                </button>

                               

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- VIEW MODAL -->
<div class="modal fade" id="viewModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Counselor Details</h5>
            </div>

            <div class="modal-body" id="viewContent">
                Loading...
            </div>

        </div>
    </div>
</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="rejectModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="Reject">

                <div class="modal-header">
                    <h5 class="modal-title">Reject Application</h5>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="rejectId" name="id" />

                    <label class="form-label" for="rejectionReason">Reason</label>
                    <textarea id="rejectionReason" name="reason" class="form-control" required></textarea>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button class="btn btn-danger">Reject</button>
                </div>

            </form>

        </div>
    </div>
</div>


<!-- APPROVE MODAL -->
<div class="modal fade" id="approveModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="Approve">

                <div class="modal-header">
                    <h5 class="modal-title">Confirm Approval</h5>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="approveId" name="id" />

                    <p>
                        Are you sure you want to approve this counselor?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button class="btn btn-success">
                        Yes, Approve
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- ATTACHMENT PREVIEW -->
<div class="modal fade" id="fileModal">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-2">
            <img id="previewImg" class="img-fluid rounded" />
        </div>
    </div>
</div>

<style>

    .attachment-card {
        width: 110px;
        text-align: center;
    }

    .attachment-img {
        width: 100%;
        height: 90px;
        object-fit: cover;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid #e5e7eb;
    }

        .attachment-img:hover {
            transform: scale(1.05);
        }

    /* PDF CARD */
    .attachment-pdf {
        height: 90px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        background: #fafafa;
    }

        .attachment-pdf i {
            font-size: 24px;
            color: #dc2626;
        }

        .attachment-pdf span {
            font-size: 12px;
            color: #111827;
        }

    /* OTHER FILE */
    .attachment-file {
        display: block;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        text-decoration: none;
        color: #111827;
    }

</style>

<script>

        function openApprove(id) {

        bootstrap.Modal.getInstance(document.getElementById("viewModal"))?.hide();

        document.getElementById("approveId").value = id;

        new bootstrap.Modal(document.getElementById("approveModal")).show();
    }

    function openReject(id) {

        bootstrap.Modal.getInstance(document.getElementById("viewModal"))?.hide();

        document.getElementById("rejectId").value = id;

        new bootstrap.Modal(document.getElementById("rejectModal")).show();
    }

    function openView(id) {

        fetch(`/Admin/Counselors?handler=Details&id=${id}`)
            .then(res => res.text())
            .then(html => {
                document.getElementById("viewContent").innerHTML = html;
                new bootstrap.Modal(document.getElementById("viewModal")).show();
            });
    }

</script>

<script>
    function previewImage(url) {
        document.getElementById("previewImg").src = url;
        new bootstrap.Modal(document.getElementById("fileModal")).show();
    }

    function openPdf(url) {
        window.open(url, "_blank");
    }
</script>
