@page
@model CouplesConnect.Pages.Admin.Resources.IndexModel

@{
    ViewData["Title"] = "Resources";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">Resources</h3>
            <p class="text-muted mb-0">
                Manage relationship resources
            </p>
        </div>

        <button class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#resourceModal">

            <i class="mdi mdi-plus"></i>

            Add Resource

        </button>

    </div>

    <div class="card cc-card">

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">

                    <input id="searchBox"
                           class="form-control cc-input"
                           aria-label="Search resources"
                           placeholder="Search..." />

                </div>

            </div>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                    <tr>

                        <th width="70"></th>

                        <th>Title</th>

                        <th>Category</th>

                        <th>Duration</th>

                        <th>Featured</th>

                        <th>Active</th>

                        <th width="160"></th>

                    </tr>

                    </thead>

                    <tbody id="resourceTable">

                    @foreach(var item in Model.Resources)
                    {
                        <tr>

                            <td>

                                <img src="@item.Thumbnail"
                                     class="rounded"
                                     style="width:60px;height:60px;object-fit:cover;" />

                            </td>

                            <td>

                                <strong>@item.Title</strong>

                                <br/>

                                <small class="text-muted">

                                    @item.Description

                                </small>

                            </td>

                            <td>

                                @item.Category.Name

                            </td>

                            <td>

                                @item.EstimatedDuration

                            </td>

                            <td>

                                @if(item.IsFeatured)
                                {
                                    <span class="badge bg-success">
                                        Featured
                                    </span>
                                }

                            </td>

                            <td>

                                @if(item.IsActive)
                                {
                                    <span class="badge bg-primary">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Disabled
                                    </span>
                                }

                            </td>

                            <td>

                                <button class="btn btn-outline-primary btn-sm">

                                    <i class="mdi mdi-pencil"></i>

                                </button>

                                <button class="btn btn-outline-danger btn-sm">

                                    <i class="mdi mdi-delete"></i>

                                </button>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<partial name="_ResourceModal" model="Model.Input"/>


@section Scripts {

    <script>

        document.getElementById("thumbnailFile")
        .addEventListener("change",function(e){

        const file=e.target.files[0];

        if(!file) return;

        const reader=new FileReader();

        reader.onload=function(ev){

        document.getElementById("thumbnailPreview").src=ev.target.result;

        };

        reader.readAsDataURL(file);

        });

    </script>

}
