@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.Admin.Packages.IndexModel
@attribute [Authorize(Roles = "Admin")]

<h3 class="mb-4">Packages</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between bg-white">
        <h5>Packages</h5>

        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            Add Package
        </button>
    </div>

    <div class="card-body">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Sessions</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var p in Model.Packages)
                {
                    <tr>

                        <td>@p.Name</td>
                        <td>@p.SessionsPerMonth</td>
                        <td>$@p.Price</td>

                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>

                        <td>

                            <button class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal-@p.PackageId">
                                Edit
                            </button>

                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-id="@p.PackageId"
                                  style="display:inline">

                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this package?')">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>

                    <!-- EDIT MODAL -->

                    <div class="modal fade" id="editModal-@p.PackageId">

                        <div class="modal-dialog">

                            <div class="modal-content">

                                <form method="post" asp-page-handler="Edit">

                                    <div class="modal-header">
                                        <h5>Edit Package</h5>
                                    </div>

                                    <div class="modal-body">

                                        <input type="hidden" name="PackageId" value="@p.PackageId" />

                                        <input name="Name" value="@p.Name" class="form-control mb-2" />

                                        <input name="SessionsPerMonth" value="@p.SessionsPerMonth" class="form-control mb-2" />

                                        <input name="Price" value="@p.Price" class="form-control mb-2" />

                                        <textarea name="Description" class="form-control">@p.Description</textarea>

                                    </div>

                                    <div class="modal-footer">
                                        <button class="btn btn-primary">Update</button>
                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- CREATE MODAL -->

<div class="modal fade" id="createModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <form method="post" asp-page-handler="Create">

                <div class="modal-header">
                    <h5>Add Package</h5>
                </div>

                <div class="modal-body">

                    <input name="Name" placeholder="Name" class="form-control mb-2" />

                    <input name="SessionsPerMonth" placeholder="Sessions per month" class="form-control mb-2" />

                    <input name="Price" placeholder="Price" class="form-control mb-2" />

                    <textarea name="Description" class="form-control" placeholder="Description"></textarea>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary">Save</button>
                </div>

            </form>

        </div>

    </div>

</div>