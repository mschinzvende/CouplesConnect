@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.User.Dashboard.IndexModel
@attribute [Authorize]

<h3 class="mb-4">Relationship Dashboard</h3>

<div class="row g-4 mb-4">

    <!-- USER METRICS -->

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Sessions Remaining</div>
                <h3 class="fw-bold">@Model.SessionsRemaining</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Upcoming Sessions</div>
                <h3 class="fw-bold">@Model.UpcomingSessions</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Bookings</div>
                <h3 class="fw-bold">@Model.TotalBookings</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Sessions Completed</div>
                <h3 class="fw-bold">@Model.CompletedSessions</h3>
            </div>
        </div>
    </div>

    <!-- COUNSELOR METRICS -->
    @if (User.IsInRole("Counselor"))
    {
        <div class="col-md-3">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <div class="text-muted small">My Sessions</div>
                    <h3 class="fw-bold">@Model.CounselorSessions</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <div class="text-muted small">Earnings</div>
                    <h3 class="fw-bold">$@Model.TotalEarnings</h3>
                </div>
            </div>
        </div>
    }

</div>

<div class="row g-4">

    <!-- CHART -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                Session Activity
            </div>
            <div class="card-body">
                <canvas id="sessionChart"></canvas>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                Quick Actions
            </div>

            <div class="card-body d-grid gap-2">

                <!-- USER ACTIONS -->
                <a href="/User/Bookings/Create" class="btn btn-primary">
                    Book Session
                </a>

                <a href="/User/Bookings" class="btn btn-outline-primary">
                    My Bookings
                </a>

                <a href="/User/Packages" class="btn btn-outline-secondary">
                    Upgrade Plan
                </a>

                <!-- COUNSELOR ACTIONS -->
                @if (User.IsInRole("Counselor"))
                {
                    <hr />

                    <a href="/Counselor/Sessions" class="btn btn-success">
                        My Sessions
                    </a>

                    <a href="/Counselor/Availability" class="btn btn-outline-success">
                        Set Availability
                    </a>
                }

            </div>
        </div>
    </div>

</div>

<!-- UPCOMING SESSIONS (COUNSELOR VIEW) -->
@if (User.IsInRole("Counselor"))
{
    <div class="card shadow-sm mt-4">

        <div class="card-header bg-white">
            Upcoming Counseling Sessions
        </div>

        <div class="card-body">

            <table class="table">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Client</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var s in Model.CounselorUpcoming)
                    {
                        <tr>
                            <td>@s.ScheduledStart</td>
                            <td>@s.User?.FullName</td>

                            <td>
                                <a href="/Sessions/Room/@s.Session.SessionId"
                                   class="btn btn-sm btn-success">
                                    Start
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

@section Scripts {

    <script>
        var ctx = document.getElementById('sessionChart');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Model.ChartLabels),
                datasets: [{
                    label: 'Sessions',
                    data: @Html.Raw(Model.ChartData),
                    borderWidth: 2
                }]
            }
        });
    </script>

}