@page
@model CouplesConnect.Pages.User.Dashboard.IndexModel

<div class="page-header">
    <h3 class="page-title">Dashboard</h3>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- SUBSCRIPTION ALERT -->
@if (Model.SubscriptionEndDate != null)
{
    if (Model.IsTrial)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <div>
                <strong>Trial Active</strong><br />
                @Model.DaysRemaining days remaining
            </div>
            <a href="/User/Packages" class="btn btn-dark btn-sm">Upgrade</a>
        </div>
    }
    else if (Model.DaysRemaining <= 5)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center">
            <div>
                <strong>Expiring Soon</strong><br />
                @Model.DaysRemaining days left
            </div>
            <a href="/User/Packages" class="btn btn-light btn-sm">Renew</a>
        </div>
    }
}

<!-- NEXT SESSION -->
@if (Model.NextSession != null)
{
    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">

            <div>
                <p class="text-muted mb-1">Next Session</p>
                <h5>@Model.NextSession.ScheduledStart.ToString("dddd, HH:mm")</h5>

                <div class="text-primary">
                    <span class="countdown"
                          data-time="@Model.NextSession.ScheduledStart.ToString("o")"></span>
                </div>
            </div>

            <a id="joinBtn"
               data-time="@Model.NextSession.ScheduledStart.ToString("o")"
               href="/Sessions/Room/@Model.NextSession.Session.SessionId"
               class="btn btn-primary disabled"
               style="pointer-events:none">
                Available 5 min before
            </a>

        </div>
    </div>
}

<!-- METRICS -->
<div class="row">

    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <p class="text-muted">Sessions Left</p>
                <h3 class="text-primary">@Model.SessionsRemaining</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <p class="text-muted">Upcoming</p>
                <h3>@Model.UpcomingSessions</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <p class="text-muted">Completed</p>
                <h3 class="text-success">@Model.CompletedSessions</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <p class="text-muted">Total</p>
                <h3>@Model.TotalBookings</h3>
            </div>
        </div>
    </div>

</div>

<!-- CONTENT -->
<div class="row">

    <!-- CHART -->
    <div class="col-md-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Activity</h4>
                <canvas id="chart"></canvas>
            </div>
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Quick Actions</h4>

                <div class="d-grid gap-2">
                    <a href="/User/Bookings/Create" class="btn btn-primary">Book Session</a>
                    <a href="/User/Bookings" class="btn btn-primary">My Bookings</a>
                    <a href="/User/Packages" class="btn btn-primary">Manage Plan</a>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {

<script>
    function updateCountdowns() {
        document.querySelectorAll('.countdown').forEach(el => {
            const time = new Date(el.dataset.time);
            const now = new Date();
            let diff = time - now;

            if (diff <= 0) {
                el.innerText = "Starting now";
                return;
            }

            const hours = Math.floor(diff / (1000 * 60 * 60));
            const minutes = Math.floor((diff / (1000 * 60)) % 60);

            el.innerText = `${hours}h ${minutes}m`;
        });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 60000);

    new Chart(document.getElementById('chart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(Model.ChartLabels),
            datasets: [{
                label: 'Bookings',
                data: @Html.Raw(Model.ChartData),
                borderColor: '#4f46e5',
                backgroundColor: 'rgba(79,70,229,.10)',
                fill: true,
                tension: .35,
                borderWidth: 2
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { grid: { display: false } } } }
        });

    function updateJoinButton() {
        const btn = document.getElementById("joinBtn");
        if (!btn) return;

        const start = new Date(btn.dataset.time);
        const now = new Date();
        const diffMinutes = (start - now) / (1000 * 60);

        if (diffMinutes <= 5) {
            btn.classList.remove("disabled");
            btn.style.pointerEvents = "auto";
            btn.innerText = "Join Session";
        }
    }

    updateJoinButton();
    setInterval(updateJoinButton, 30000);
</script>

}
