@page
@model CouplesConnect.Pages.User.Bookings.IndexModel

<div class="page-header">
    <h3 class="page-title">My Bookings</h3>
</div>
<form method="get">
<!-- FILTER -->
<div class="row g-3 align-items-end mb-5">

    <div class="col-md-5">
        <label class="form-label fw-semibold mb-1">Search</label>
        <input type="text"
               name="Search"
               value="@Model.Search"
               class="form-control cc-input"
               placeholder="Search by service or counselor..." />
    </div>

    <div class="col-md-4">
        <label class="form-label fw-semibold mb-1">Status</label>
        <select name="StatusFilter" class="form-select cc-input">
            <option value="all">All</option>
            <option value="Scheduled">Upcoming</option>
            <option value="Ready">Ready</option>
            <option value="Live">Live</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100 cc-btn">
            Apply Filter
        </button>
    </div>

</div>

</form>

<!-- ALERTS -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<!-- BOOKINGS GRID -->
<div class="row g-4">

    @foreach (var b in Model.Bookings)
    {
        var state = Model.GetSessionState(b);

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 booking-card">

                <div class="card-body">

                    <!-- HEADER -->
                    <div class="d-flex justify-content-between align-items-start mb-2">

                        <div>
                            <div class="fw-semibold">
                                @b.ScheduledStart.ToString("ddd, dd MMM")
                            </div>
                            <div class="text-muted small">
                                @b.ScheduledStart.ToString("HH:mm")
                            </div>
                        </div>

                        <span class="badge booking-badge @state.ToLower()">
                            @state
                        </span>

                    </div>

                    <hr />

                    <!-- DETAILS -->
                    <div class="mb-3">

                        <div class="mb-1">
                            <span class="fw-semibold">Service:</span>
                            <span>@b.Service?.Name</span>
                        </div>

                        <div class="mb-1">
                            <span class="fw-semibold">Counselor:</span>
                            <span>@b.Counselor?.FullName</span>
                        </div>

                        @if (b.IsGroup)
                        {
                            <div class="mt-2">
                                <span class="badge cc-group-badge">Group Session</span>

                                <div class="small text-muted mt-1">
                                    Participants:
                                    @b.Participants.Count(p => p.Status == "Accepted")
                                </div>
                            </div>
                        }

                    </div>

                    <!-- COUNTDOWN -->
                    @if (state == "Scheduled" || state == "Ready")
                    {
                        <div class="small text-muted mb-3">
                            Starts in
                            <span class="countdown"
                                  data-time="@b.ScheduledStart.ToString("o")"></span>
                        </div>
                    }

                    <!-- ACTIONS -->
                    <div class="mt-2">

                        @if (b.Session != null && b.Session.IsStarted && !b.Session.IsEnded)
                        {
                            <a href="/Sessions/PreJoin/@b.Session.SessionId"
                               class="btn btn-primary btn-sm w-100">
                                Join Session
                            </a>
                        }
                        else if (state == "Scheduled")
                        {
                            <form method="post"
                                  asp-page-handler="Cancel"
                                  asp-route-id="@b.BookingId"
                                  asp-route-subId="@b.SubscriptionId">

                                <button class="btn cc-cancel-btn btn-sm w-100">
                                    Cancel Booking
                                </button>
                            </form>
                        }

                    </div>

                </div>

            </div>
        </div>
    }

</div>

<!-- PAGINATION -->
<div class="mt-4 d-flex justify-content-center">
    <ul class="pagination">

        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link"
               asp-route-pageNumber="@(Model.PageNumber - 1)"
               asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@Model.StatusFilter">Prev</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   asp-route-pageNumber="@i"
                   asp-route-Search="@Model.Search"
                   asp-route-StatusFilter="@Model.StatusFilter">@i</a>
            </li>
        }

        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
            <a class="page-link"
               asp-route-pageNumber="@(Model.PageNumber + 1)"
               asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@Model.StatusFilter">Next</a>
        </li>

    </ul>
</div>

<!-- STYLES -->
<style>
    .booking-card {
        border-radius: 12px;
        transition: all 0.2s ease;
    }

        .booking-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    /* BADGES */
    .booking-badge {
        padding: 6px 10px;
        font-size: 12px;
        border-radius: 999px;
        text-transform: capitalize;
    }

        .booking-badge.scheduled {
            background: #e0e7ff;
            color: #3730a3;
        }

        .booking-badge.ready {
            background: #fef3c7;
            color: #92400e;
        }

        .booking-badge.live {
            background: #dcfce7;
            color: #166534;
        }

        .booking-badge.completed {
            background: #ecfdf5;
            color: #065f46;
        }

        .booking-badge.cancelled {
            background: #f3f4f6;
            color: #374151;
        }

    /* GROUP */
    .cc-group-badge {
        background: #eef2ff;
        color: #4f46e5;
    }
</style>

<!-- SCRIPTS -->
<script>
    function updateCountdowns() {
        document.querySelectorAll('.countdown').forEach(el => {

            const time = new Date(el.dataset.time);
            const now = new Date();

            let diff = time - now;

            if (diff <= 0) {
                el.innerText = "Starting...";
                return;
            }

            const seconds = Math.floor(diff / 1000) % 60;
            const minutes = Math.floor(diff / (1000 * 60)) % 60;
            const hours = Math.floor(diff / (1000 * 60 * 60));

            el.innerText = `${hours}h ${minutes}m ${seconds}s`;
        });
    }

    setInterval(updateCountdowns, 1000);
    updateCountdowns();
</script>