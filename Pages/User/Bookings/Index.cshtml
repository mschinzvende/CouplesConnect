@page
@model CouplesConnect.Pages.User.Bookings.IndexModel

<h3 class="fw-bold mb-3">My Bookings</h3>

<form method="get" class="row mb-3">
    <div class="col-md-6">
        <input type="text" name="Search" value="@Model.Search"
               class="form-control"
               placeholder="Search by service or counselor..." />
    </div>

    <div class="col-md-3">
        <select name="StatusFilter" class="form-select">
            <option value="all">All</option>
            <option value="Scheduled">Upcoming</option>
            <option value="Ready">Ready</option>
            <option value="Live">Live</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="col-md-3">
        <button class="btn btn-primary w-100">Apply</button>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">

    @foreach (var b in Model.Bookings)
    {
        var state = Model.GetSessionState(b);

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100 booking-card">

                <div class="card-body">

                    <!-- HEADER -->
                    <div class="d-flex justify-content-between">
                        <div>
                            <strong>@b.ScheduledStart.ToString("ddd, dd MMM")</strong><br />
                            <small>@b.ScheduledStart.ToString("HH:mm")</small>
                        </div>

                        <span class="badge
                        @(state == "Live" ? "bg-success" :
                          state == "Ready" ? "bg-warning text-dark" :
                          state == "Completed" ? "bg-success" :
                          state == "Cancelled" ? "bg-secondary" :
                          "bg-primary")">
                            @state
                        </span>
                    </div>

                    <hr />

                    <!-- DETAILS -->
                    <div class="mb-2">
                        <div><strong>Service:</strong> @b.Service?.Name</div>
                        <div><strong>Counselor:</strong> @b.Counselor?.FullName</div>

                        @if (b.IsGroup)
                        {
                            <span class="badge bg-info mt-1">Group Session</span>

                            <div class="small text-muted mt-1">
                                Participants:
                                @b.Participants.Count(p => p.Status == "Accepted")
                            </div>
                        }
                    </div>

                    <!-- COUNTDOWN -->
                    @if (state == "Scheduled" || state == "Ready")
                    {
                        <div class="text-muted small mb-2">
                            Starts in
                            <span class="countdown"
                                  data-time="@b.ScheduledStart.ToString("o")">
                            </span>
                        </div>
                    }

                    <!-- ACTIONS -->
                    <div class="d-flex flex-column gap-2 mt-2">

                        @if (b.Session != null && b.Session.IsStarted && !b.Session.IsEnded)
                        {
                            <a href="/Sessions/PreJoin/@b.Session.SessionId"
                               class="btn btn-success btn-sm">
                                Join Session
                            </a>
                        }

                        @if (state == "Scheduled")
                        {
                            <form method="post"
                                  asp-page-handler="Cancel"
                                  asp-route-id="@b.BookingId">

                                <button class="btn btn-outline-danger btn-sm w-100">
                                    Cancel Booking
                                </button>
                            </form>
                        }

                    </div>

                </div>

            </div>
        </div>
    }

</div>

<!-- PAGINATION -->
<div class="mt-4 d-flex justify-content-center">
    <ul class="pagination">

        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link"
               asp-route-pageNumber="@(Model.PageNumber - 1)"
               asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@Model.StatusFilter">Prev</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   asp-route-pageNumber="@i"
                   asp-route-Search="@Model.Search"
                   asp-route-StatusFilter="@Model.StatusFilter">@i</a>
            </li>
        }

        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
            <a class="page-link"
               asp-route-pageNumber="@(Model.PageNumber + 1)"
               asp-route-Search="@Model.Search"
               asp-route-StatusFilter="@Model.StatusFilter">Next</a>
        </li>

    </ul>
</div>

<style>
    .booking-card {
        border-radius: 12px;
        transition: 0.2s ease;
    }

        .booking-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }
</style>

<script>

    function updateCountdowns() {
        document.querySelectorAll('.countdown').forEach(el => {

            const time = new Date(el.dataset.time);
            const now = new Date();

            let diff = time - now;

            if (diff <= 0) {
                el.innerText = "Starting...";
                return;
            }

            const seconds = Math.floor(diff / 1000) % 60;
            const minutes = Math.floor(diff / (1000 * 60)) % 60;
            const hours = Math.floor(diff / (1000 * 60 * 60));

            el.innerText = `${hours}h ${minutes}m ${seconds}s`;
        });
    }

    setInterval(updateCountdowns, 1000);
    updateCountdowns();

</script>