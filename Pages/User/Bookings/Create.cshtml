@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.User.Bookings.CreateModel
@attribute [Authorize(Roles = "User")]

<div class="page-header">
    <h3 class="page-title">Book a Session</h3>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

<!-- FILTER -->
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">

                <h4 class="card-title mb-3">Filter Options</h4>

                <form method="get">
                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Service</label>
                            <select name="ServiceId" class="form-select cc-select" onchange="this.form.submit()">
                                <option value="">Select Service</option>
                                @foreach (var s in Model.Services)
                                {
                                    <option value="@s.ServiceId" selected="@(Model.ServiceId == s.ServiceId)">
                                        @s.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Counselor</label>
                            <select name="CounselorId" class="form-select cc-select" onchange="this.form.submit()">
                                <option value="">Select Counselor</option>
                                @foreach (var c in Model.Counselors)
                                {
                                    <option value="@c.Id" selected="@(Model.CounselorId == c.Id)">
                                        @c.FullName
                                    </option>
                                }
                            </select>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@if (Model.AvailableDates.Any())
{
    <form method="post" id="bookingForm">

        <input type="hidden" name="ServiceId" value="@Model.ServiceId" />
        <input type="hidden" name="CounselorId" value="@Model.CounselorId" />
        <input type="hidden" id="selectedTime" name="ScheduledStart" />

        <div class="row">

            <!-- LEFT SIDE -->
            <div class="col-md-5 grid-margin stretch-card">
                <div class="card h-100">
                    <div class="card-body">

                        <h4 class="card-title mb-3">Select Date</h4>

                        <div class="mb-3">
                            <input type="text"
                                   id="calendar"
                                   name="SelectedDate"
                                   class="form-control"
                                   placeholder="Select date"
                                   value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />
                        </div>

                        <!-- GROUP TOGGLE -->
                        <div class="cc-group-toggle mb-3">
                            <label class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold">Group Session</span>
                                <input type="checkbox" id="isGroup" name="isGroup" 
                                   value="true" onchange="toggleGroup()" />
                            </label>
                        </div>

                        <!-- PARTICIPANTS -->
                        <div id="groupSection" class="d-none">
                            <div class="border rounded p-3 bg-light">

                                <div class="d-flex justify-content-between mb-2">
                                    <h6 class="mb-0">Participants</h6>
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm"
                                            onclick="addParticipant()">
                                        + Add
                                    </button>
                                </div>

                                <div id="participantsContainer"></div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- RIGHT SIDE -->
            <div class="col-md-7 grid-margin stretch-card">
                <div class="card h-100">
                    <div class="card-body">

                        <h4 class="card-title mb-3">Available Time Slots</h4>

                        @if (Model.TimeSlots.Any())
                        {
                            <div class="row g-3">

                                @foreach (var t in Model.TimeSlots)
                                {
                                    <div class="col-md-4">
                                        <button type="button"
                                                class="cc-slot-btn w-100 slot-btn"
                                                data-time="@t.ToString("yyyy-MM-ddTHH:mm")">
                                            @t.ToString("HH:mm")
                                        </button>
                                    </div>
                                }

                            </div>

                            <!-- CONFIRM BUTTON -->
                            <div class="mt-4 text-end">
                                <button type="submit"
                                        id="confirmBookingBtn"
                                        class="btn btn-primary px-4"
                                        disabled>
                                    Confirm Booking
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info mb-0">
                                No available time slots
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>

    </form>
}
else
{
    <div class="alert alert-info">
        No available dates
    </div>
}

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var availableDates = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.AvailableDates.Select(d => d.ToString("yyyy-MM-dd"))
            )
        );

            flatpickr("#calendar", {
                dateFormat: "Y-m-d",
                enable: availableDates,
                defaultDate: "@(Model.SelectedDate?.ToString("yyyy-MM-dd"))",

                onChange: function (selectedDates, dateStr, instance) {
                    if (dateStr) {

                        // submit the GET form manually
                        const form = document.createElement("form");
                        form.method = "get";

                        // preserve existing filters
                        form.innerHTML = `
                            <input type="hidden" name="ServiceId" value="@Model.ServiceId" />
                            <input type="hidden" name="CounselorId" value="@Model.CounselorId" />
                            <input type="hidden" name="SelectedDate" value="${dateStr}" />
                        `;

                        document.body.appendChild(form);
                        form.submit();
                    }
                }
            });

        });
    </script>

    <script>
        function toggleGroup() {
            document.getElementById("groupSection").classList.toggle("d-none");
        }
    </script>

    <script>
        function addParticipant() {
            const container = document.getElementById("participantsContainer");

            const wrapper = document.createElement("div");
            wrapper.className = "d-flex gap-2 mb-2";

            const input = document.createElement("input");
            input.name = "ParticipantPhones";
            input.className = "form-control";
            input.placeholder = "2637XXXXXXXX";

            const removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.className = "btn btn-danger btn-sm";
            removeBtn.innerText = "✕";
            removeBtn.onclick = () => wrapper.remove();

            wrapper.appendChild(input);
            wrapper.appendChild(removeBtn);

            container.appendChild(wrapper);
        }
    </script>

    <script>
        document.querySelectorAll(".slot-btn").forEach(btn => {
            btn.addEventListener("click", function () {

                document.querySelectorAll(".slot-btn").forEach(b => b.classList.remove("active"));

                this.classList.add("active");

                document.getElementById("selectedTime").value = this.dataset.time;

                document.getElementById("confirmBookingBtn").disabled = false;
            });
        });
    </script>

}