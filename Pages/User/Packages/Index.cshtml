@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.User.Packages.IndexModel
@attribute [Authorize(Roles = "User")]

<h3 class="mb-4">Choose a Plan</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">

    @foreach (var p in Model.Packages)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h5>@p.Name</h5>

                    <h3 class="fw-bold mt-2">$@p.Price</h3>

                    <p class="text-muted">@p.SessionsPerMonth sessions/month</p>

                    <p>@p.Description</p>

                    <form method="post" asp-page-handler="Purchase">

                        <input type="hidden" name="PackageId" value="@p.PackageId" />

                        <button class="btn btn-primary w-100">
                            Select Plan
                        </button>

                    </form>

                </div>

            </div>

        </div>
    }

</div>