@page
@using Microsoft.AspNetCore.Authorization
@model CouplesConnect.Pages.User.Packages.IndexModel
@attribute [Authorize(Roles = "User")]

<div class="page-header">
    <h3 class="page-title">Choose a Plan</h3>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="row g-4">

    @foreach (var p in Model.Packages)
    {
        var isCurrent = Model.CurrentSubscription != null
        && Model.CurrentSubscription.PackageId == p.PackageId;

        var totalSessions = p.SessionsPerMonth;
        var remaining = isCurrent ? Model.CurrentSubscription.SessionsRemaining : 0;
        var used = totalSessions - remaining;
        var percentUsed = totalSessions == 0 ? 0 : (used * 100 / totalSessions);

        <div class="col-md-4">

            <div class="card h-100 package-card @(isCurrent ? "active-plan" : "")">

                <div class="card-body text-center">

                    <!-- PLAN NAME -->
                    <h5 class="fw-semibold">@p.Name</h5>

                    <!-- PRICE -->
                    <h2 class="fw-bold my-2">$@p.Price</h2>

                    <!-- DETAILS -->
                    <p class="text-muted small mb-2">
                        @p.SessionsPerMonth sessions per month
                    </p>

                    <p class="text-muted small mb-3">
                        @p.Description
                    </p>

                    @if (isCurrent)
                    {
                        <!-- ACTIVE BADGE -->
                        <div class="mb-2">
                            <span class="badge cc-badge-primary">
                                Active Plan
                            </span>
                        </div>

                        <!-- USAGE -->
                        <div class="mb-2">
                            <strong>@remaining</strong> / @totalSessions sessions left
                        </div>

                        <!-- PROGRESS -->
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar"
                                 style="width:@percentUsed%">
                            </div>
                        </div>

                        <!-- COUNTDOWN -->
                        @if (Model.CurrentSubscription?.EndDate != null)
                        {
                            <div class="text-muted small mb-3">
                                <span class="countdown"
                                      data-time="@Model.CurrentSubscription.EndDate.Value.ToString("o")">
                                </span>
                            </div>
                        }

                        <button class="btn btn-outline-secondary w-100" disabled>
                            Current Plan
                        </button>
                    }
                    else if (Model.CurrentSubscription != null)
                    {
                        <!-- UPGRADE -->
                        <form method="post" asp-page-handler="Purchase">
                            <input type="hidden" name="PackageId" value="@p.PackageId" />

                            <button type="submit" class="btn btn-primary w-100">
                                Upgrade Plan
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- SELECT -->
                        <form method="post" asp-page-handler="Purchase">
                            <input type="hidden" name="PackageId" value="@p.PackageId" />

                            <button type="submit" class="btn btn-primary w-100">
                                Select Plan
                            </button>
                        </form>
                    }

                </div>

            </div>

        </div>
    }

</div>

<style>
    /* CARD */
    .package-card {
        border-radius: 12px;
        transition: all 0.2s ease;
        border: 1px solid #e5e7eb;
    }

        .package-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        }

    /* ACTIVE PLAN */
    .active-plan {
        border: 2px solid #4f46e5;
        background: #fafaff;
    }

    /* BADGE */
    .cc-badge-primary {
        background: #eef2ff;
        color: #4338ca;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
    }

    /* PROGRESS */
    .progress-bar {
        background: #4f46e5;
    }

    /* BUTTON CONSISTENCY */
    .btn {
        height: 42px;
    }
</style>

<script>
    function updateCountdowns() {
        document.querySelectorAll('.countdown').forEach(el => {

            const end = new Date(el.dataset.time);
            const now = new Date();

            let diff = end - now;

            if (diff <= 0) {
                el.innerText = "Expired";
                el.classList.add("text-danger");
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);

            if (days > 0) {
                el.innerText = `${days} days ${hours} hrs left`;
            } else {
                const minutes = Math.floor((diff / (1000 * 60)) % 60);
                el.innerText = `${hours} hrs ${minutes} min left`;
            }
        });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 60000);
</script>