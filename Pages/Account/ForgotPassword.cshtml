@page "/account/forgot-password"
@model CouplesConnect.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="auth-form">
    <h3 class="fw-bold mb-2">Reset your password</h3>
    <p class="text-muted mb-4">Enter your email address and we’ll send secure reset instructions.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="mb-4">
            <label asp-for="Input.Email" class="form-label fw-semibold">Email address</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary w-100">Send reset link</button>
    </form>

    <div class="small text-center mt-4"><a href="/signin">Back to sign in</a></div>
</div>

<style>.auth-form { max-width: 380px; margin: auto; }</style>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
