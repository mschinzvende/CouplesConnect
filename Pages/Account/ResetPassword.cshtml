@page "/account/reset-password"
@model CouplesConnect.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}

<div class="auth-form">
    @if (!Model.IsValidLink)
    {
        <h3 class="fw-bold mb-2">Invalid reset link</h3>
        <p class="text-muted mb-4">This password reset link is incomplete or invalid. Request a new link to continue.</p>
        <a class="btn btn-outline-primary w-100" href="/account/forgot-password">Request a new link</a>
    }
    else
    {
        <h3 class="fw-bold mb-2">Choose a new password</h3>
        <p class="text-muted mb-4">Use a strong, unique password that you do not use elsewhere.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input asp-for="Input.UserId" type="hidden" />
            <input asp-for="Input.Code" type="hidden" />
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold">New password</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm new password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary w-100">Update password</button>
        </form>
    }
</div>

<style>.auth-form { max-width: 380px; margin: auto; }</style>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
