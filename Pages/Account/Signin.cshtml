@page "/signin"
@model CouplesConnect.Pages.Account.SigninModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<div class="auth-form">
    <p class="public-auth-eyebrow">Welcome back</p>
    <h2>Continue your journey together.</h2>
    <p class="public-auth-description">Sign in to return to your bookings, reflections, resources, and shared progress.</p>

    <form method="post" class="public-auth-form">
        <input asp-for="ReturnUrl" type="hidden" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="public-auth-validation" role="alert"></div>
        }

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email address</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label">Password</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
        </div>

        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
            <div class="form-check">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label">Remember me</label>
            </div>
            <a asp-page="/Account/ForgotPassword" class="public-auth-link">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary public-auth-submit">Sign in <i class="mdi mdi-arrow-right"></i></button>

        <p class="public-auth-switch">New to Couples Connect? <a href="/signup?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Create your account</a></p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
