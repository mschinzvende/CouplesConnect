@page "/account/reset-password-confirmation"
@{
    ViewData["Title"] = "Password updated";
    Layout = "_AuthLayout";
}

<div class="auth-form text-center">
    <div class="confirmation-icon"><i class="mdi mdi-check"></i></div>
    <h3 class="fw-bold mb-2">Password updated</h3>
    <p class="text-muted mb-4">Your password has been changed. You can now sign in using your new password.</p>
    <a class="btn btn-primary w-100" href="/signin">Continue to sign in</a>
</div>

<style>
    .auth-form { max-width: 380px; margin: auto; }
    .confirmation-icon { display: grid; width: 64px; height: 64px; margin: 0 auto 18px; place-items: center; border-radius: 50%; background: #dcfce7; color: #15803d; font-size: 30px; }
</style>
