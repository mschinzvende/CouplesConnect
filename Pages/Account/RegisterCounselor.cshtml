@page
@model CouplesConnect.Pages.Account.RegisterCounselorModel
@{
    ViewData["Title"] = "Become a Counselor";
}

<div class="container py-4" style="max-width:800px;">

    <!-- HEADER -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1">Become a Counselor</h3>
        <p class="text-muted mb-0">
            Submit your professional details for review and approval.
        </p>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- FORM -->
    <div class="card cc-card">
        <div class="card-body">

            <form method="post" enctype="multipart/form-data">

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <!-- PERSONAL INFO -->
                <div class="mb-4">
                    <h6 class="section-title">Personal Information</h6>
                    <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Input.FullName" class="form-label">Full Name</label>
                        <input asp-for="Input.FullName" class="form-control cc-input" />
                    </div>

                        <div class="col-sm-6 mb-3">
                        <label asp-for="Input.DateOfBirth" class="form-label">Date of Birth</label>
                            <input asp-for="Input.DateOfBirth"
                                   type="date"
                                   id="dob"
                                   class="form-control cc-input"
                                   max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    </div>

                        <div class="col-sm-6 mb-3">
                        <label class="form-label" for="age">Age</label>
                        <input type="text" id="age" class="form-control cc-input" readonly />
                    </div>

                        <div class="col-sm-6 mb-3">
                        <label asp-for="Input.Gender" class="form-label">Gender</label>
                        <select asp-for="Input.Gender" class="form-control cc-input">
                            <option value="">-- Select Gender --</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>

                        <div class="col-sm-12">
                        <label asp-for="Input.Bio" class="form-label">Bio</label>
                        <textarea asp-for="Input.Bio" rows="5" class="form-control cc-input"></textarea>
                    </div>

                  </div>
                </div>

                <!-- PROFESSIONAL -->
                <div class="mb-4">
                    <h6 class="section-title">Professional Details</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Qualifications" class="form-label">Qualifications</label>
                            <input asp-for="Input.Qualifications" class="form-control cc-input" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.YearsOfExperience" class="form-label">Years of Experience</label>
                            <input asp-for="Input.YearsOfExperience" type="number" class="form-control cc-input" />
                        </div>
                    </div>

                    
                </div>

                <!-- SERVICES -->
                <div class="mb-4">
                    <h6 class="section-title">Services You Offer</h6>

                    <div class="row">
                        @foreach (var service in Model.Services)
                        {
                            <div class="col-md-6 mb-2">
                                <div class="d-flex align-items-center gap-2">

                                    <input class="form-check-input m-0"
                                           type="checkbox"
                                           name="Input.SelectedServiceIds"
                                           value="@service.ServiceId"
                                           id="service_@service.ServiceId" />

                                    <label class="mb-0"
                                           for="service_@service.ServiceId">
                                        @service.Name
                                    </label>

                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- DOCUMENTS -->
                <div class="mb-4">
                    <h6 class="section-title">Credentials</h6>

                    <div class="upload-box">
                        <label class="form-label" for="fileInput">Upload certificates (PDF, JPG, PNG)</label>

                        <input type="file"
                               id="fileInput"
                               name="CredentialFiles"
                               multiple
                               class="form-control mt-2 cc-input" />
                    </div>

                    <div id="fileList" class="mt-3"></div>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-between">
                    <a href="/" class="text-muted small">Cancel</a>
                    <button class="btn btn-primary px-4">Submit Application</button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    // DOB → AGE
    document.getElementById("dob").addEventListener("change", function () {
        const birthDate = new Date(this.value);
        const today = new Date();

        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();

        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }

        document.getElementById("age").value = age >= 0 ? age : "";
    });

    // FILE HANDLING (UNCHANGED)
    const fileInput = document.getElementById("fileInput");
    const fileList = document.getElementById("fileList");
    let filesArray = [];

    fileInput.addEventListener("change", function () {
        const selectedFiles = Array.from(this.files);

        selectedFiles.forEach(file => {
            if (file.size > 5 * 1024 * 1024) return alert(file.name + " too large");

            const allowed = ["application/pdf", "image/jpeg", "image/png"];
            if (!allowed.includes(file.type)) return alert(file.name + " invalid");

            filesArray.push(file);
        });

        updateFiles();
        renderFiles();
    });

    function updateFiles() {
        const dt = new DataTransfer();
        filesArray.forEach(f => dt.items.add(f));
        fileInput.files = dt.files;
    }

    function renderFiles() {
        fileList.innerHTML = "";

        filesArray.forEach((file, i) => {
            const div = document.createElement("div");
            div.innerHTML = `
                <span>${file.name}</span>
                <button type="button" onclick="removeFile(${i})">Remove</button>
            `;
            fileList.appendChild(div);
        });
    }

    function removeFile(i) {
        filesArray.splice(i, 1);
        updateFiles();
        renderFiles();
    }
</script>

<script>
    const dob = document.getElementById("dob");
    const ageField = document.getElementById("age");

    dob.addEventListener("change", function () {
        const birthDate = new Date(this.value);
        const today = new Date();

        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();

        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }

        ageField.value = age >= 0 ? age : "";

        // ✅ AGE VALIDATION (25+)
        if (age < 25) {
            alert("You must be at least 25 years old to apply as a counselor.");
            this.value = "";
            ageField.value = "";
        }
    });
</script>
