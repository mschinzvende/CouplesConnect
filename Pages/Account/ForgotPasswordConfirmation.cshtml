@page "/account/forgot-password-confirmation"
@{
    ViewData["Title"] = "Check your messages";
    Layout = "_AuthLayout";
}

<div class="auth-form text-center">
    <div class="confirmation-icon"><i class="mdi mdi-lock-reset"></i></div>
    <h3 class="fw-bold mb-2">Check your messages</h3>
    <p class="text-muted mb-4">If an eligible account exists for that email address, we sent reset instructions by email and WhatsApp.</p>
    <a class="btn btn-primary w-100" href="/signin">Back to sign in</a>
</div>

<style>
    .auth-form { max-width: 380px; margin: auto; }
    .confirmation-icon { display: grid; width: 64px; height: 64px; margin: 0 auto 18px; place-items: center; border-radius: 50%; background: #eef2ff; color: #4f46e5; font-size: 30px; }
</style>
